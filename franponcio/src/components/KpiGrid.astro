---
interface Props {
  kpis: { label: string; valor: string; nota?: string }[];
}

const { kpis } = Astro.props;

// Las columnas se adaptan a la cantidad: con 3 KPIs, tres columnas — si no
// queda una celda vacía. Tailwind necesita el nombre de clase completo, así
// que van escritas enteras y no armadas con template string.
const columnas =
  { 1: 'lg:grid-cols-1', 2: 'lg:grid-cols-2', 3: 'lg:grid-cols-3' }[kpis.length] ??
  'lg:grid-cols-4';
---

{
  kpis.length > 0 && (
    <dl
      class:list={[
        'grid gap-px bg-borde border border-borde rounded-lg overflow-hidden sm:grid-cols-2',
        columnas,
      ]}
    >
      {kpis.map((kpi) => (
        <div class="bg-panel px-5 py-4">
          <dt class="font-mono text-[0.7rem] uppercase tracking-[0.12em] text-tenue">
            {kpi.label}
          </dt>
          <dd class="mt-1.5 font-mono text-2xl font-semibold tabular-nums">{kpi.valor}</dd>
          {kpi.nota && <p class="mt-1 text-xs text-tenue leading-snug">{kpi.nota}</p>}
        </div>
      ))}
    </dl>
  )
}
