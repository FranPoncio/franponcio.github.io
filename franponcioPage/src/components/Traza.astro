---
import { conBase } from '../lib/url';
import { logosDelStack } from '../lib/logos';
import { usarTraduccion, type Idioma } from '../i18n/ui';
import type { Proyecto } from '../lib/proyectos';

/**
 * LA TRAZA — el recorrido, ahora VERTICAL Y CENTRADO.
 *
 * Antes esto era un panel `sticky` que traducía el scroll vertical en
 * desplazamiento horizontal: la traza corría de izquierda a derecha y las
 * estaciones alternaban arriba y abajo de un caño. Andaba, pero peleaba con
 * el gesto natural de la página, obligaba a un bloque de varias pantallas de
 * alto que no se podía linkear por dentro, y en el teléfono era otro diseño
 * distinto mantenido aparte.
 *
 * Ahora el eje BAJA por el medio exacto de la página y todo se apoya encima,
 * centrado y simétrico: el año gigante de fondo, el nodo sobre la línea, y la
 * ficha. Un solo diseño para todos los anchos — en el celular es lo mismo,
 * más angosto.
 *
 * El eje se llena a medida que scrolleás (`--avance`, de 0 a 1) y de ese
 * frente sale el humo con los números flotando (lo dibuja Fondo.astro, que
 * lee justamente ese `--avance`).
 *
 * La ficha arranca compacta —año, rubro, título y la cifra— y se abre en el
 * lugar al clickearla. Se abre EN EL LUGAR y no en un globo flotante porque
 * en una columna centrada un globo tapa la estación siguiente; y se abre por
 * click y no por hover porque expandir bajo el cursor haría saltar la página
 * justo donde estás mirando.
 */

interface Props {
  proyectos: Proyecto[];
  lang: Idioma;
  /** Hay más de una traza en la página; cada una necesita su ancla. */
  id: string;
}

const { proyectos, lang, id } = Astro.props;
const t = usarTraduccion(lang);
const base = lang === 'es' ? 'proyectos' : 'en/projects';

/** El título largo no entra: se corta en el primer corte natural. */
const corto = (titulo: string) => {
  const limpio = titulo.split(/\s+[—–]\s+/)[0];
  return limpio.length > 42 ? limpio.slice(0, 40).trimEnd() + '…' : limpio;
};

/** El año gigante del fondo es UNO solo: el primero del período. */
const anioDe = (periodo: string) => periodo.match(/\d{4}/)?.[0] ?? '';

/**
 * El rótulo traducido ya termina en flecha ("ver el caso →"). En el link eso
 * está bien; en la seña de "esto se despliega" no, porque ahí no se va a
 * ningún lado: la seña lleva un chevrón que gira. Se le saca la flecha.
 */
const sinFlecha = (s: string) => s.replace(/\s*[→>]+\s*$/, '');

/**
 * El chip de la ficha lleva el ROL y no la categoría.
 *
 * La categoría decía `datos`, `gestion` o `herramienta`, y ahí estaba media
 * confusión de la página: "herramienta" nombraba a la vez la categoría de una
 * ficha, la sección de los proyectos propios y el stack de la sección 03. Tres
 * cosas distintas con la misma palabra.
 *
 * El rol, además, dice algo que no dice nada más: qué hice ahí. Y separa solo
 * los dos tramos —en los trabajos dice "Project Manager", en los proyectos
 * propios dice "Diseño y desarrollo"— sin necesidad de repetir en cada ficha a
 * qué sección pertenece.
 *
 * La categoría no se va: sigue siendo el COLOR de la estación.
 */
const primerRol = (rol: string) => {
  const uno = rol.split(/\s*·\s*/)[0];
  // El chip vive arriba de una ficha de 500 px: pasado cierto largo deja de
  // leerse como etiqueta y empieza a competir con el título. Se corta en la
  // última palabra entera que entre.
  if (uno.length <= 27) return uno;
  return uno.slice(0, uno.lastIndexOf(' ', 26)) + '…';
};

/*
 * El año gigante del fondo se escribe UNA VEZ POR AÑO, no una vez por
 * estación. Con varios proyectos del mismo año quedaba "2026" repetido tres
 * veces seguidas, una abajo de la otra, y en vez de ubicarte en el tiempo
 * parecía un error de maquetado. Si la estación repite el año de la anterior,
 * va sin año: el que sigue arriba se entiende que sigue valiendo.
 */
let anioPrevio = '';
/**
 * Para la fila de adelante van primero las cifras y después el resto.
 *
 * Algunos casos tienen KPIs que no son números —"Reducido", "Operación
 * completa"— y puestos al lado de un 12.000 en cuerpo grande desbalancean la
 * fila: una palabra larga se come el ancho de dos cifras. Ordenados así, la
 * ficha muestra lo cuantitativo primero, que es lo que se lee de un vistazo,
 * y lo cualitativo queda para el detalle.
 * `sort` es estable, así que dentro de cada grupo se respeta el orden del caso.
 */
const conNumero = (v: string) => /\d/.test(v);
const paraLaFicha = (kpis: Proyecto['data']['kpis']) =>
  [...kpis].sort((a, b) => Number(conNumero(b.valor)) - Number(conNumero(a.valor)));

const estaciones = proyectos.map((p) => {
  const propio = anioDe(p.data.periodo);
  const anio = propio === anioPrevio ? '' : propio;
  anioPrevio = propio;
  return {
  p,
  anio,
  marcas: logosDelStack(p.data.stack, 4),
  kpis: paraLaFicha(p.data.kpis),
  };
});
---

<section class="marco" id={id}>
  <div class="via" aria-hidden="true"><span class="frente"></span></div>

  {/* La válvula de la punta va APARTE del caño y por encima de las fichas.
      Adentro de `.frente` quedaba atrapada en el mismo plano que el caño, que
      pasa por detrás de las fichas — y como las fichas están centradas sobre
      el mismo eje y la punta cae siempre a la misma altura de pantalla, la
      válvula quedaba atrapada en el plano del caño.
      Va en su propia capa, PERO POR DEBAJO de las fichas: encima tapaba el
      dato grande de la ficha —se comía un dígito de "12.000 km"— y un número
      del caso vale más que un adorno. Asomando entre ficha y ficha se ve
      igual, y que el caño pase por detrás del panel es lo que además
      corresponde. */}
  <span class="valvula" aria-hidden="true"></span>

  <ol class="pista">
    {
      estaciones.map(({ p, anio, marcas, kpis }) => (
        <li class="parada" style={`--c: var(--color-${p.data.categoria})`}>
          {/* El año gigante, en hueco, detrás de la ficha: la ficha se apoya
              adentro del número y se lee el año por arriba y por abajo. */}
          {anio && <span class="anio-fondo" aria-hidden="true">{anio}</span>}

          <span class="nodo" aria-hidden="true" />
          <span class="tallo" aria-hidden="true" />

          <article class="ficha">
            <button type="button" class="tapa" aria-expanded="false">
              {/* Sólo el rubro. El período NO va acá: el año gigante del
                  fondo ya lo dice, y repetirlo era la mitad del contenido de
                  una ficha que de por sí tiene poco. El rango completo pasa
                  al detalle, donde hay lugar y no compite con nada. */}
              <span class="rubro">{primerRol(p.data.rol)}</span>

              <span class="titulo">{corto(p.data.titulo)}</span>

              {/* VARIOS datos, no uno. Con una sola cifra la ficha decía menos
                  de lo que el caso tiene: dos o tres puestas juntas se leen
                  como un tablero y dejan ver de qué tamaño fue la cosa.
                  El tamaño baja cuando son más, para que la fila entre en los
                  500 px de la ficha sin apretarse. */}
              {kpis.length > 0 && (
                <span class:list={['cifras', `de-${Math.min(kpis.length, 3)}`]}>
                  {kpis.slice(0, 3).map((k) => (
                    <span class="cifra">
                      <b
                        class:list={['tabular-nums', !/\d/.test(k.valor) && 'palabra']}
                        data-cifra={k.valor}
                      >
                        {k.valor}
                      </b>
                      <i>{k.label}</i>
                    </span>
                  ))}
                </span>
              )}

              <span class="senia" aria-hidden="true">
                <span class="senia-txt">{sinFlecha(t('proyecto.ver'))}</span>
                <svg viewBox="0 0 24 24" class="chevron"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </button>

            {/* El detalle. Se anima con grid-template-rows 0fr → 1fr, que es
                la única forma de transicionar a "alto automático" sin medir
                nada con JavaScript. */}
            <div class="mas">
              <div class="mas-dentro">
                <p class="periodo">{p.data.periodo}</p>
                <p class="resumen">{p.data.resumen}</p>

                {kpis.length > 3 && (
                  <div class="datos">
                    {kpis.slice(3).map((k) => (
                      <span>
                        <b class="tabular-nums">{k.valor}</b>
                        <i>{k.label}</i>
                      </span>
                    ))}
                  </div>
                )}

                <div class="pie">
                  <span class="marcas" aria-hidden="true">
                    {marcas.map((m) => (
                      <svg viewBox="0 0 24 24" role="presentation">
                        <path d={m.path} fill="currentColor" />
                      </svg>
                    ))}
                  </span>
                  <a href={conBase(`${base}/${p.id}/`)} class="ir">
                    {t('proyecto.ver')}
                  </a>
                </div>
              </div>
            </div>
          </article>
        </li>
      ))
    }
  </ol>
</section>

<style>
  /* ── El bloque ────────────────────────────────────────────────────────
     Bloque normal, sin `sticky` y sin alto calculado: la traza mide lo que
     miden sus estaciones. */
  .marco {
    position: relative;
    z-index: 1;
    padding: 4rem 1.2rem 3rem;
    scroll-margin-top: 4.5rem;
  }

  /* ── EL CAÑO ──────────────────────────────────────────────────────────
     Por el medio EXACTO de la página. Ya no es una línea: es un caño que se
     extiende. Donde todavía no llegó queda la traza marcada —el zanjeo, en
     punteado— y detrás va quedando el caño tendido.

     El caño crece con `height` y NO con `transform: scaleY()`. Escalar es más
     barato, pero estira todo lo que tenga adentro: las juntas soldadas se
     deformaban de redondas a ovaladas a medida que avanzaba, y el degradado
     del cilindro se iba con ellas. Con `height` las juntas quedan siempre a
     la misma distancia y del mismo grosor, que es lo que hace que se lea como
     un caño y no como una barra de progreso. El costo es acotado: `.frente`
     es `position: absolute`, así que cambiarle el alto no reacomoda nada. */
  .via {
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 14px;
    margin-left: -7px;
    --avance: 0;
  }
  /* Acá iba un punteado de zanjeo. Sobra: el tronco de la página ya pasa por
     detrás, y son dos caños dibujados en el mismo lugar. */

  .frente {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: calc(var(--avance) * 100%);
    border-radius: 3px;
    will-change: height;
    background:
      /* Las juntas soldadas, cada 92 px. */
      repeating-linear-gradient(
        to bottom,
        transparent 0 88px,
        rgba(0, 0, 0, 0.55) 88px 90px,
        rgba(255, 255, 255, 0.09) 90px 92px
      ),
      var(--acero);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.06) inset;
  }
  /* EL BORDE DE AVANCE.
     Desde que el caño de la página es continuo, el tramo ya recorrido y el que
     falta son los dos un caño: lo único que los separa es el brillo, y el
     momento en que la punta pasa por una estación dejaba de ser un evento.
     Esta banda encendida en la punta lo vuelve visible, y es lo que da pie a
     que después se arme la brida. */
  .frente::after {
    content: '';
    position: absolute;
    left: -3px;
    right: -3px;
    bottom: 0;
    height: 26px;
    border-radius: 3px;
    background: linear-gradient(
      to bottom,
      transparent,
      color-mix(in srgb, var(--color-acento) 42%, transparent)
    );
    box-shadow: 0 0 16px 2px color-mix(in srgb, var(--color-acento) 30%, transparent);
  }
  /* ── LA VÁLVULA DE LA PUNTA ───────────────────────────────────────────
     Baja con el frente porque `top` sale del mismo `--avance` que estira el
     caño, y las dos medidas se resuelven contra la misma caja: `.marco` es el
     bloque que las contiene a las dos.

     La opacidad sale de una cuenta sobre el propio `--avance`: con el caño
     sin empezar la válvula no tiene dónde apoyarse y quedaba flotando arriba
     de todo. `calc(var(--avance) * 20)` la trae entera a partir del 5 % del
     recorrido — arriba de 1 la opacidad se recorta sola, así que no hace
     falta ni un `min()`. */
  .valvula {
    position: absolute;
    left: 50%;
    top: calc(var(--avance, 0) * 100%);
    /* Arriba del caño, abajo de las fichas y de las válvulas de estación. */
    z-index: 1;
    opacity: calc(var(--avance, 0) * 20);
  }
  .valvula::before,
  .valvula::after {
    content: '';
    position: absolute;
    left: 50%;
  }
  /* El cuerpo, más ancho que el caño y centrado en la boca. */
  .valvula::before {
    top: -12px;
    width: 38px;
    height: 24px;
    margin-left: -19px;
    border-radius: 3px;
    background: var(--acero);
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.6),
      0 5px 16px -3px rgba(0, 0, 0, 0.9);
  }
  /* El volante. Va encendido, que es por donde sale el gas. */
  .valvula::after {
    top: -9.5px;
    width: 19px;
    height: 19px;
    margin-left: -9.5px;
    border-radius: 50%;
    border: 2.5px solid var(--color-acento);
    background:
      radial-gradient(circle, var(--color-acento) 0 1.6px, transparent 1.6px),
      repeating-conic-gradient(
        from 45deg,
        var(--color-acento) 0 6deg,
        transparent 6deg 90deg
      );
    box-shadow: 0 0 16px 1px color-mix(in srgb, var(--color-acento) 55%, transparent);
  }

  .pista {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* ── La estación ──────────────────────────────────────────────────────
     Centrada, simétrica, sin alternar lados. */
  .parada {
    position: relative;
    width: min(500px, 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 3.4rem;
  }

  /* El año gigante en hueco. Es el gesto de la sección: la ficha se apoya
     adentro del número. */
  .anio-fondo {
    position: absolute;
    top: -1.6rem;
    left: 50%;
    translate: -50% 0;
    z-index: 0;
    font-family: var(--font-titulo);
    font-weight: 800;
    font-size: clamp(6.5rem, 17vw, 11.5rem);
    line-height: 0.8;
    letter-spacing: -0.045em;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--color-borde-vivo);
    opacity: 0.55;
    user-select: none;
    white-space: nowrap;
  }

  /* ── LA ESTACIÓN ES UNA BRIDA ─────────────────────────────────────────
     La válvula es UNA sola y es la que viaja con la punta. En las estaciones
     va lo que va de verdad en un gasoducto: una brida, la junta empernada
     entre dos tramos de caño. Antes había un volante en cada estación, y eso
     no existe — no se pone una válvula de mano en cada junta.

     Se arma cuando la válvula LLEGA, no cuando entra la ficha: son dos
     momentos distintos y por eso son dos clases distintas (`activa` para el
     contenido, `bridada` para la junta). */
  .nodo {
    position: relative;
    z-index: 3;
    width: 34px;
    height: 20px;
  }
  /* Las dos placas con sus cuatro bulones. La franja del medio va
     transparente: por ahí se ve pasar el caño. */
  .nodo::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 2px;
    background:
      radial-gradient(circle at 7px 3.5px, #c8d1d3 1.5px, transparent 1.5px),
      radial-gradient(circle at 27px 3.5px, #c8d1d3 1.5px, transparent 1.5px),
      radial-gradient(circle at 7px 16.5px, #c8d1d3 1.5px, transparent 1.5px),
      radial-gradient(circle at 27px 16.5px, #c8d1d3 1.5px, transparent 1.5px),
      linear-gradient(
        to bottom,
        var(--acero-claro) 0 7px,
        transparent 7px 13px,
        var(--acero-claro) 13px 20px
      );
    box-shadow: 0 3px 10px -3px rgba(0, 0, 0, 0.85);
  }
  /* La junta que aprieta, en el color del proyecto: es lo único que
     distingue una estación de otra. */
  .nodo::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 18px;
    height: 7px;
    margin: -3.5px 0 0 -9px;
    border-radius: 2px;
    background: var(--c);
    box-shadow: 0 0 13px 0 color-mix(in srgb, var(--c) 70%, transparent);
  }

  /* El tramito que baja del nodo a la ficha. */
  .tallo {
    position: relative;
    z-index: 1;
    width: 2px;
    height: 1.5rem;
    background: linear-gradient(to bottom, var(--c), transparent);
  }

  /* ── La ficha ─────────────────────────────────────────────────────────
     Semitransparente a propósito: el humo y los números que suben por el eje
     se ven ghosteados por atrás en vez de quedar tapados. */
  .ficha {
    position: relative;
    z-index: 2;
    width: 100%;
    /* Sin recuadro. Con tan poco contenido, un borde de lado a lado hacía
       ver una caja medio vacía; ahora es el contenido apoyado sobre el caño.
       Queda un panel translúcido —el humo pasa por atrás y el texto tiene que
       leerse igual— y el borde aparece recién al abrir o al pasar por encima. */
    border: 1px solid transparent;
    border-radius: 14px;
    background: color-mix(in srgb, var(--color-panel) 72%, transparent);
    backdrop-filter: blur(7px);
    -webkit-backdrop-filter: blur(7px);
    overflow: hidden;
    transition:
      border-color 0.25s ease,
      transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.35s ease;
  }
  .ficha:hover,
  .parada.abierta .ficha {
    border-color: var(--c);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--c) 40%, transparent),
      0 18px 45px -20px color-mix(in srgb, var(--c) 70%, transparent);
  }
  @media (hover: hover) {
    .ficha:hover { transform: translateY(-3px); }
  }

  /* La tapa es un botón de verdad: se llega con Tab y abre con Enter. */
  .tapa {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.55rem;
    width: 100%;
    padding: 1rem 1.2rem 0.9rem;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: center;
    cursor: pointer;
  }
  .tapa:focus-visible {
    outline: 2px solid var(--color-acento);
    outline-offset: -4px;
    border-radius: 18px;
  }

  .cab {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
  }
  .cab { display: none; }
  .rubro {
    font-family: var(--font-mono);
    font-size: 0.5rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-fondo);
    background: var(--c);
    border-radius: 999px;
    padding: 0.2rem 0.6rem;
  }
  .periodo {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.04em;
    color: var(--color-tenue);
  }

  .titulo {
    font-family: var(--font-titulo);
    font-weight: 750;
    font-size: clamp(1.25rem, 3vw, 1.7rem);
    line-height: 1.02;
    letter-spacing: -0.028em;
    max-width: 22ch;
    text-wrap: balance;
  }

  .cifras {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: flex-end;
    gap: 0.4rem 1.5rem;
    margin-top: 0.5rem;
  }
  .cifra {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.1rem;
  }
  .cifra b {
    font-family: var(--font-titulo);
    /* En 800 el cero de Syne se cierra y queda una elipse maciza: la cifra
       "0 accidentes" se leia como una pastilla y no como un numero. */
    font-weight: 700;
    font-size: clamp(2rem, 6vw, 2.8rem);
    line-height: 1;
    letter-spacing: -0.045em;
    color: var(--c);
    white-space: nowrap;
  }
  .cifra i {
    font-family: var(--font-mono);
    font-style: normal;
    font-size: 0.5rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-tenue);
  }

  /* Cuantas más cifras, más chicas: si no, tres de 2,8rem no entran en una
     ficha de 500 px y se parten en tres renglones. */
  .de-2 .cifra b { font-size: clamp(1.6rem, 4.4vw, 2.1rem); }
  .de-3 .cifra b { font-size: clamp(1.25rem, 3.4vw, 1.65rem); }
  /* Un valor que es una palabra y no un número va más chico y en el tono del
     texto: si no, "Operación completa" pesa más que un 12.000 y desordena la
     jerarquía de la ficha. */
  .cifra b.palabra {
    font-size: 0.95rem !important;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-texto);
    align-self: center;
  }
  .de-3 { gap: 0.4rem 1.1rem; }
  .de-2 .cifra i,
  .de-3 .cifra i { font-size: 0.46rem; }

  /* La seña de que la ficha se abre. */
  .senia {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.53rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-tenue);
    transition: color 0.2s ease;
  }
  .ficha:hover .senia { color: var(--c); }
  .chevron {
    width: 0.85rem;
    height: 0.85rem;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .parada.abierta .chevron { transform: rotate(180deg); }

  /* ── El detalle ───────────────────────────────────────────────────────
     0fr → 1fr: la única manera de transicionar hasta "alto automático". */
  .mas {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.42s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .parada.abierta .mas { grid-template-rows: 1fr; }
  .mas-dentro {
    overflow: hidden;
    min-height: 0;
  }
  .mas-dentro > * {
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .parada.abierta .mas-dentro > * {
    opacity: 1;
    transition-delay: 0.12s;
  }

  .periodo {
    margin: 0 0 0.5rem;
    padding: 0 1.2rem;
    font-size: 0.64rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-acento);
  }
  .resumen {
    margin: 0;
    padding: 0 1.2rem;
    max-width: 52ch;
    margin-inline: auto;
    font-size: 0.86rem;
    line-height: 1.65;
    color: var(--color-tenue);
  }

  .datos {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem 2.2rem;
    margin-top: 1.1rem;
    padding: 0 1.2rem;
  }
  .datos > span {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .datos b {
    font-family: var(--font-titulo);
    font-weight: 750;
    font-size: 1.5rem;
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .datos i {
    font-family: var(--font-mono);
    font-style: normal;
    font-size: 0.48rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--color-tenue);
  }

  .pie {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.35rem;
    padding: 0.8rem 1.2rem;
    border-top: 1px solid var(--color-borde);
    background: color-mix(in srgb, var(--color-panel-alto) 55%, transparent);
  }
  .marcas { display: flex; gap: 0.5rem; color: var(--color-texto); }
  .marcas svg { width: 1.05rem; height: 1.05rem; opacity: 0.42; }
  .ir {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    color: var(--c);
    text-decoration: none;
    white-space: nowrap;
  }
  .ir:hover { text-decoration: underline; text-underline-offset: 3px; }
  .ir:focus-visible { outline: 2px solid var(--c); outline-offset: 3px; border-radius: 3px; }

  /* ── Entrada: la estación se enciende cuando el frente la alcanza ────── */
  :global(.js-on) .parada > *:not(.nodo) {
    opacity: 0;
    translate: 0 26px;
    transition:
      opacity 0.55s ease,
      translate 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }
  :global(.js-on) .parada.activa > *:not(.nodo) {
    opacity: 1;
    translate: 0 0;
  }
  /* El año de fondo entra apenas después y desde más abajo: da profundidad. */
  :global(.js-on) .parada .anio-fondo { translate: -50% 40px; transition-delay: 0.1s; }
  :global(.js-on) .parada.activa .anio-fondo { translate: -50% 0; }
  /* La brida se APRIETA cuando llega la válvula: entra angosta y se abre
     hasta calzar sobre el caño. Va aparte del resto de la estación porque
     responde a otro momento — `bridada`, no `activa`. */
  :global(.js-on) .parada .nodo {
    opacity: 0;
    transform: scaleX(0.28);
    transition:
      opacity 0.3s ease,
      transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  :global(.js-on) .parada.bridada .nodo {
    opacity: 1;
    transform: none;
  }
  :global(.js-on) .parada.activa .ficha { transition-delay: 0.14s; }

  @media (max-width: 700px) {
    .marco { padding: 3.5rem 1rem 4.5rem; }
    .pista { gap: 3rem; }
    .parada { padding-top: 2.6rem; }
    .anio-fondo { top: -1rem; }
    .tapa { padding: 1.25rem 1.1rem 1.15rem; }
    /* "12.000 km" a 2.4rem no entra en 390 px: en angosto manda el vw. */
    .cifra b { font-size: clamp(1.9rem, 8.5vw, 2.6rem); }
    .resumen, .datos, .pie, .periodo { padding-inline: 1.1rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    /* Cada regla de acá va colgada de `html:not([data-mov='on'])`: si el
       visitante prendió el movimiento a mano con el botón de la barra, su
       decisión gana sobre la del sistema y nada de esto se aplica. */

    .ficha, .chevron, .mas, .mas-dentro > * { transition: none; }
    :global(.js-on) .parada > *:not(.nodo) { opacity: 1; translate: none; transition: none; }
    :global(.js-on) .parada .anio-fondo { translate: -50% 0; }

    /* LA BRIDA SÍ APARECE, aunque no se mueva.
       Antes acá las bridas quedaban todas puestas desde el arranque, y eso
       era pasarse de conservador: con la preferencia prendida el armado no se
       veía nunca, que es justamente lo que hace a la traza.
       Un FUNDIDO no es movimiento. La preferencia pide que nada se desplace
       —nada de parallax, nada que se escale, nada que gire—, no que la página
       esté congelada. Así que se mantiene el mismo momento de siempre (cuando
       la válvula llega) pero la brida se enciende nomás: cambia la opacidad y
       no se corre ni un píxel. Sin `scaleX`, que sí sería movimiento. */
    :global(html:not([data-mov='on'])) :global(.js-on) .parada .nodo {
      opacity: 0;
      transform: none;
      transition: opacity 0.5s ease;
    }
    :global(html:not([data-mov='on'])) :global(.js-on) .parada.bridada .nodo {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  // Hay más de una traza en la página —los trabajos y las herramientas son
  // dos secciones separadas—, así que todo esto corre por cada una.
  const trazas = [...document.querySelectorAll<HTMLElement>('.marco')];
  const suave =
    !matchMedia('(prefers-reduced-motion: reduce)').matches ||
    document.documentElement.dataset.mov === 'on';

  /**
   * Cuenta una cifra hacia arriba respetando su formato: "12.000 km" cuenta el
   * número y devuelve el resto tal cual; "< 5 %" o "SPI / CPI" se dejan quietas
   * porque no hay nada que contar.
   */
  function contar(el: HTMLElement) {
    const texto = (el.dataset.cifra ?? el.textContent ?? '').trim();
    const m = texto.match(/^(\D*?)([\d.,]+)(.*)$/s);
    if (!m) return;
    const [, antes, crudo, despues] = m;

    // Un separador de miles SIEMPRE parte grupos de tres. Si no, es una coma
    // decimal y el número no se toca: "2,6 KB" se estaba contando como 26.
    const miles = /^\d{1,3}(\.\d{3})+$/.test(crudo) || /^\d{1,3}(,\d{3})+$/.test(crudo);
    if (!miles && /[.,]/.test(crudo)) return;

    const destino = parseInt(miles ? crudo.replace(/[.,]/g, '') : crudo, 10);
    if (!isFinite(destino) || destino === 0) return;
    const t0 = performance.now();

    const paso = (ahora: number) => {
      const p = Math.min((ahora - t0) / 900, 1);
      const v = Math.round(destino * (p === 1 ? 1 : 1 - Math.pow(2, -10 * p)));
      el.textContent = antes + (miles ? v.toLocaleString('es-AR') : String(v)) + despues;
      if (p < 1) requestAnimationFrame(paso);
    };
    requestAnimationFrame(paso);
  }

  /**
   * Dos umbrales distintos, y a propósito.
   *
   * FRENTE es dónde cae la cabeza encendida del recorrido: a media pantalla,
   * que es donde se mira. ENTRADA es dónde se enciende una estación, y va
   * mucho más abajo — casi en el borde inferior.
   *
   * Con un umbral solo, la estación siguiente recién aparecía cuando su nodo
   * llegaba al frente, así que abajo del todo quedaba SIEMPRE media pantalla
   * en blanco mientras scrolleabas. Separándolos, la ficha ya entró revelada
   * y lo que la cabeza marca es por dónde va el gas.
   */
  const FRENTE = 0.58;
  const ENTRADA = 0.94;
  /** Cuánto tiene que pasarse la punta del nodo antes de que se arme la brida. */
  const PASADO = 38;

  for (const marco of trazas) {
    const via = marco.querySelector<HTMLElement>('.via');
    if (!via) continue;

    const paradas = [...marco.querySelectorAll<HTMLElement>('.parada')].map((el) => ({
      el,
      nodo: el.querySelector<HTMLElement>('.nodo')!,
      bridada: false,
      tapa: el.querySelector<HTMLButtonElement>('.tapa')!,
      cifras: [...el.querySelectorAll<HTMLElement>('.cifra b')],
      activa: false,
    }));

    // ── Abrir y cerrar: una sola ficha abierta a la vez ──────────────────
    const cerrarTodas = (menos?: HTMLElement) => {
      for (const p of paradas) {
        if (p.el === menos) continue;
        p.el.classList.remove('abierta');
        p.tapa.setAttribute('aria-expanded', 'false');
      }
    };
    for (const p of paradas) {
      p.tapa.addEventListener('click', () => {
        const abre = !p.el.classList.contains('abierta');
        cerrarTodas(p.el);
        p.el.classList.toggle('abierta', abre);
        p.tapa.setAttribute('aria-expanded', String(abre));
      });
    }
    addEventListener('keydown', (e) => {
      if (e.key === 'Escape') cerrarTodas();
    });

    // ── El recorrido ─────────────────────────────────────────────────────
    let pendiente = false;

    const medir = () => {
      pendiente = false;
      const caja = marco.getBoundingClientRect();
      const frente = window.innerHeight * FRENTE;
      // 0 cuando el frente toca el borde de arriba del bloque, 1 cuando pasó
      // el de abajo. Es exactamente lo que escala `.frente` en Y.
      const avance =
        caja.height <= 0 ? 0 : Math.min(Math.max((frente - caja.top) / caja.height, 0), 1);
      const v = avance.toFixed(4);
      via.style.setProperty('--avance', v);
      // También en el marco: de ahí lo lee la válvula de la punta, que está
      // fuera de `.via` para poder pintarse por encima de las fichas.
      marco.style.setProperty('--avance', v);

      const entrada = window.innerHeight * ENTRADA;
      // Al final del recorrido se dan por puestas todas: si una estación
      // quedara sin cruzar el frente —porque la página se terminó antes— su
      // brida no se armaría nunca.
      const alFinal = avance > 0.995;

      for (const p of paradas) {
        const caja = p.nodo.getBoundingClientRect();

        // 1) La ficha se revela al ENTRAR, para que abajo no quede el hueco.
        if (!p.activa && caja.top <= entrada) {
          p.activa = true;
          p.el.classList.add('activa');
          if (suave) for (const c of p.cifras) contar(c);
        }

        // 2) La brida se arma cuando la punta del caño YA PASÓ, no mientras
        //    la está cruzando. Antes disparaba con el centro del nodo sobre
        //    el frente, o sea justo encima: la brida aparecía al mismo tiempo
        //    que pasaba la válvula y no se leía como consecuencia.
        //    `caja.bottom + PASADO <= frente` quiere decir que el frente dejó
        //    atrás el nodo entero y siguió de largo un poco más.
        if (!p.bridada && (alFinal || caja.bottom + PASADO <= frente)) {
          p.bridada = true;
          p.el.classList.add('bridada');
        }
      }
    };

    const alScroll = () => {
      if (pendiente) return;
      pendiente = true;
      requestAnimationFrame(medir);
    };
    addEventListener('scroll', alScroll, { passive: true });
    addEventListener('resize', alScroll, { passive: true });
    medir();
  }
</script>
