---
import { conBase } from '../lib/url';
import { logosDelStack } from '../lib/logos';
import { usarTraduccion, type Idioma } from '../i18n/ui';
import type { Proyecto } from '../lib/proyectos';

/**
 * LA TRAZA — el recorrido completo, de 2013 a hoy, leído de izquierda a
 * derecha sobre un caño horizontal.
 *
 * Cómo se mueve: NO se secuestra la rueda del mouse. El bloque mide varias
 * pantallas de alto y adentro hay un panel `sticky`; el scroll vertical normal
 * —rueda, trackpad, teclado, barra— se traduce a desplazamiento horizontal de
 * la pista. Así funciona igual con cualquier forma de scrollear y no se rompe
 * la navegación por teclado.
 *
 * En celular no hay nada que ganar con el gesto: el bloque se desarma y las
 * estaciones caen en una columna vertical común.
 */

interface Props {
  proyectos: Proyecto[];
  lang: Idioma;
}

const { proyectos, lang } = Astro.props;
const t = usarTraduccion(lang);
const base = lang === 'es' ? 'proyectos' : 'en/projects';

// La traza va partida en dos tramos. La primera parada de cada uno arrastra
// un rótulo: una válvula sobre el caño con el nombre del tramo y sus años.
const anio = (periodo: string) => periodo.match(/\d{4}/)?.[0] ?? '';
const rango = (tramo: 'laboral' | 'proyecto') => {
  const del = proyectos.filter((p) => p.data.tramo === tramo);
  const anios = del.flatMap((p) => p.data.periodo.match(/\d{4}/g) ?? []);
  return anios.length ? `${anio(del[0].data.periodo)} — ${anios.sort().at(-1)}` : '';
};

let previo: string | null = null;
const estaciones = proyectos.map((p, i) => {
  const abre = p.data.tramo !== previo ? p.data.tramo : null;
  previo = p.data.tramo;
  return {
    p,
    arriba: i % 2 === 0,
    marcas: logosDelStack(p.data.stack, 3),
    rotulo: abre && {
      titulo: abre === 'laboral' ? t('tramo.laboral') : t('tramo.proyecto'),
      bajada: abre === 'laboral' ? t('tramo.laboral.bajada') : t('tramo.proyecto.bajada'),
      anios: rango(abre),
    },
  };
});
---

<section class="marco" id="traza" style={`--paradas:${estaciones.length}`}>
  <div class="pega">
    <div class="via" aria-hidden="true"><span class="paquetes"></span></div>

    <ol class="pista">
      {
        estaciones.map(({ p, arriba, marcas, rotulo }) => (
          <li
            class:list={['parada', arriba ? 'arriba' : 'abajo', rotulo && 'abre-tramo']}
            style={`--c: var(--color-${p.data.categoria})`}
          >
            {rotulo && (
              <span class="tramo">
                <span class="valvula" aria-hidden="true" />
                <b>{rotulo.titulo}</b>
                <i>{rotulo.anios}</i>
                <em>{rotulo.bajada}</em>
              </span>
            )}
            <span class="nodo" aria-hidden="true" />
            <span class="anio">{p.data.periodo}</span>

            <a href={conBase(`${base}/${p.id}/`)} class="ficha group">
              <span class="rubro">{p.data.categoria}</span>
              <h3>{p.data.titulo}</h3>
              <p>{p.data.resumen}</p>

              {p.data.kpis[0] && (
                <span class="dato">
                  <b class="tabular-nums" data-cifra={p.data.kpis[0].valor}>
                    {p.data.kpis[0].valor}
                  </b>
                  <i>{p.data.kpis[0].label}</i>
                </span>
              )}

              <span class="pie">
                <span class="marcas" aria-hidden="true">
                  {marcas.map((m) => (
                    <svg viewBox="0 0 24 24" role="presentation">
                      <path d={m.path} fill="currentColor" />
                    </svg>
                  ))}
                </span>
                <span class="ir">{t('proyecto.ver')}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  /* Cada parada consume ~50vh de scroll vertical. Más alto = se recorre más
     despacio. El +100vh es la pantalla que el panel se queda pegado al final. */
  .marco {
    height: calc(var(--paradas) * 50vh + 100vh);
  }
  .pega {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
  }

  /* El caño, con sus juntas. */
  .via {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 14px;
    margin-top: -7px;
    border-radius: 5px;
    border-top: 1px solid var(--color-borde);
    border-bottom: 1px solid var(--color-borde);
    background: repeating-linear-gradient(
      90deg,
      transparent 0 96px,
      var(--color-borde) 96px 98px
    );
  }
  /* Los paquetes: pulsos claros que CORREN por el tramo ya cargado. Es lo que
     hace que el caño se lea como una cañería con algo adentro y no como una
     barra de progreso pintada. Sólo se anima background-position. */
  .paquetes {
    position: absolute;
    top: 1px;
    bottom: 1px;
    left: 0;
    right: 0;
    z-index: 1;
    border-radius: 4px;
    transform: scaleX(var(--avance, 1));
    transform-origin: left center;
    background-image: repeating-linear-gradient(
      90deg,
      transparent 0 58px,
      rgba(255, 255, 255, 0.9) 58px 96px,
      transparent 96px 150px
    );
    background-size: 300px 100%;
    animation: correr-gas 2.1s linear infinite;
  }
  @keyframes correr-gas {
    from { background-position: 0 0; }
    to   { background-position: 300px 0; }
  }

  /* El gas: se llena a medida que avanzás por la traza. */
  .via::after {
    content: '';
    position: absolute;
    top: 1px;
    bottom: 1px;
    left: 0;
    right: 0;
    border-radius: 4px;
    transform: scaleX(var(--avance, 1));
    transform-origin: left center;
    background:
      repeating-linear-gradient(
        90deg,
        transparent 0 95px,
        color-mix(in srgb, #fff 55%, transparent) 95px 98px
      ),
      linear-gradient(90deg, var(--color-acento), color-mix(in srgb, var(--color-acento) 55%, transparent));
    box-shadow: 0 0 16px -6px var(--color-acento);
  }

  .pista {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: stretch;
    padding-left: 4vw;
    margin: 0;
    list-style: none;
    will-change: transform;
  }

  .parada {
    position: relative;
    --sangria: 0px;
    flex: 0 0 calc(clamp(300px, 25vw, 350px) + var(--sangria));
  }
  /* La parada que abre un tramo se corre entera —nodo, año y ficha— para
     dejarle lugar al rótulo. */
  .abre-tramo { --sangria: clamp(190px, 15vw, 230px); }

  /* El rótulo del tramo: una válvula sobre el caño y el nombre al lado. */
  .tramo {
    position: absolute;
    left: 0;
    bottom: calc(50% + 26px);
    width: calc(var(--sangria) - 1.5rem);
    padding-left: 1.1rem;
  }
  .valvula {
    position: absolute;
    left: 0;
    bottom: -32px;
    width: 11px;
    height: 26px;
    margin-left: -5.5px;
    border-radius: 3px;
    border: 2px solid var(--color-acento);
    background: var(--color-fondo);
    box-shadow: 0 0 0 4px var(--color-fondo);
  }
  .tramo b {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-acento);
  }
  .tramo i {
    display: block;
    margin-top: 0.2rem;
    font-family: var(--font-mono);
    font-style: normal;
    font-size: 0.58rem;
    letter-spacing: -0.03em;
    color: var(--color-tenue);
  }
  .tramo em {
    display: block;
    margin-top: 0.5rem;
    font-style: normal;
    font-size: 0.72rem;
    line-height: 1.45;
    color: var(--color-tenue);
  }

  .nodo {
    position: absolute;
    left: var(--sangria);
    top: 50%;
    z-index: 2;
    width: 17px;
    height: 17px;
    margin-top: -8.5px;
    margin-left: -8.5px;
    border-radius: 50%;
    border: 2.5px solid var(--c);
    background: var(--color-fondo);
    box-shadow: 0 0 0 4px var(--color-fondo);
  }

  .anio {
    position: absolute;
    left: calc(var(--sangria) + 20px);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: -0.04em;
    color: var(--color-tenue);
  }
  .arriba .anio { top: calc(50% + 13px); }
  .abajo .anio { top: calc(50% - 26px); }

  /* Sin JavaScript todo se ve de una: la entrada sólo existe con `js-on`. */
  :global(.js-on) .ficha {
    opacity: 0;
    translate: 0 34px;
    scale: 0.94;
  }
  :global(.js-on) .parada.activa .ficha {
    opacity: 1;
    translate: 0 0;
    scale: 1;
  }
  :global(.js-on) .nodo {
    transform: scale(0.35);
    opacity: 0;
    transition: transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.3s ease;
  }
  :global(.js-on) .parada.activa .nodo {
    transform: scale(1);
    opacity: 1;
  }
  :global(.js-on) .anio,
  :global(.js-on) .tramo {
    opacity: 0;
    transition: opacity 0.5s ease 0.15s;
  }
  :global(.js-on) .parada.activa .anio,
  :global(.js-on) .parada.activa .tramo {
    opacity: 1;
  }

  .ficha {
    display: block;
    position: absolute;
    left: var(--sangria);
    width: clamp(272px, 22vw, 300px);
    padding: 1.1rem 1.2rem;
    border: 1px solid var(--color-borde);
    border-radius: 12px;
    background: var(--color-panel);
    box-shadow:
      0 1px 2px rgba(14, 23, 20, 0.05),
      0 10px 30px -18px rgba(14, 23, 20, 0.35);
    transition:
      opacity 0.55s ease,
      translate 0.65s cubic-bezier(0.16, 1, 0.3, 1),
      scale 0.65s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }
  .arriba .ficha { bottom: calc(50% + 40px); }
  .abajo .ficha { top: calc(50% + 40px); }

  @media (hover: hover) {
    .ficha:hover {
      transform: translateY(-14px);
      border-color: var(--c);
      box-shadow:
        0 3px 6px rgba(14, 23, 20, 0.08),
        0 34px 60px -22px color-mix(in srgb, var(--c) 70%, transparent),
        0 0 0 4px color-mix(in srgb, var(--c) 12%, transparent);
    }
    /* La estación también reacciona: el nodo crece mientras mirás su ficha.
       Va con `.js-on .parada.activa` porque la regla de entrada tiene esa
       misma especificidad y si no le ganaba. */
    :global(.js-on) .parada.activa:hover .nodo,
    .parada:hover .nodo {
      transform: scale(1.5);
      box-shadow:
        0 0 0 4px var(--color-fondo),
        0 0 24px -2px var(--c);
    }
    .ficha:hover .dato b {
      color: var(--c);
    }
  }
  .ficha:focus-visible { outline: 2px solid var(--c); outline-offset: 4px; }

  .rubro {
    font-family: var(--font-mono);
    font-size: 0.55rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--c);
  }
  .ficha h3 {
    margin-top: 0.5rem;
    font-size: 0.98rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .ficha p {
    margin-top: 0.5rem;
    font-size: 0.8rem;
    line-height: 1.55;
    color: var(--color-tenue);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
  }

  .dato {
    margin-top: 0.85rem;
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
  }
  .dato b {
    transition: color 0.3s ease;
    font-family: var(--font-mono);
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: -0.08em;
  }
  .dato i {
    font-family: var(--font-mono);
    font-style: normal;
    font-size: 0.52rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-tenue);
  }

  .pie {
    margin-top: 0.9rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .marcas { display: flex; gap: 0.45rem; color: var(--color-texto); }
  .marcas svg { width: 0.95rem; height: 0.95rem; opacity: 0.3; }
  .ir {
    font-family: var(--font-mono);
    font-size: 0.55rem;
    letter-spacing: -0.03em;
    color: var(--c);
    opacity: 0;
    translate: -0.4rem 0;
    transition: opacity 0.3s ease, translate 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @media (hover: hover) {
    .ficha:hover .ir { opacity: 1; translate: 0 0; }
    .ficha:hover .marcas svg { opacity: 0.55; }
  }

  /* ── Celular: el gesto no aporta, se desarma en columna ───────────────── */
  @media (max-width: 900px) {
    .marco { height: auto; }
    .pega { position: static; height: auto; overflow: visible; }
    .via { display: none; }
    .pista {
      position: static;
      flex-direction: column;
      gap: 1rem;
      padding: 0 1.25rem;
      transform: none !important;
    }
    .parada { flex: none; padding-left: 1.1rem; padding-bottom: 0.2rem; border-left: 2px solid var(--color-borde); }
    .abre-tramo { padding-left: 1.1rem; margin-top: 2rem; }
    .tramo {
      position: static;
      width: auto;
      transform: none;
      padding-left: 0;
      margin-bottom: 1rem;
    }
    .valvula { display: none; }
    .tramo em { max-width: 34ch; }
    .nodo { left: -1.5px; top: 1.4rem; margin: 0; }
    .anio { position: static; display: block; margin-bottom: 0.35rem; }
    .ficha { position: static; width: auto; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ficha, .ir { transition: none; }
  }
</style>

<script>
  const marco = document.querySelector<HTMLElement>('#traza');
  const pista = marco?.querySelector<HTMLElement>('.pista');
  const via = marco?.querySelector<HTMLElement>('.via');
  const suave = !matchMedia('(prefers-reduced-motion: reduce)').matches;

  /**
   * Cuenta una cifra hacia arriba respetando su formato: "12.000 km" cuenta el
   * número y devuelve el resto tal cual, y "< 5 %" o "SPI / CPI" —que no tienen
   * número que contar— se dejan quietas.
   */
  function contar(el: HTMLElement) {
    const texto = (el.dataset.cifra ?? el.textContent ?? '').trim();
    const m = texto.match(/^(\D*?)([\d.,]+)(.*)$/s);
    if (!m) return;
    const [, antes, crudo, despues] = m;
    const destino = parseInt(crudo.replace(/[.,]/g, ''), 10);
    if (!isFinite(destino) || destino === 0) return;
    const separador = crudo.includes('.') || crudo.includes(',');
    const t0 = performance.now();

    const paso = (ahora: number) => {
      const p = Math.min((ahora - t0) / 900, 1);
      // easeOutExpo: arranca rápido y frena, se siente mecánico
      const v = Math.round(destino * (p === 1 ? 1 : 1 - Math.pow(2, -10 * p)));
      el.textContent = antes + (separador ? v.toLocaleString('es-AR') : String(v)) + despues;
      if (p < 1) requestAnimationFrame(paso);
    };
    requestAnimationFrame(paso);
  }

  if (marco && pista && via) {
    const paradas = [...marco.querySelectorAll<HTMLElement>('.parada')].map((el) => ({
      el,
      nodo: el.querySelector<HTMLElement>('.nodo')!,
      cifra: el.querySelector<HTMLElement>('.dato b'),
      activa: false,
    }));

    // Una estación se enciende cuando el gas la alcanza: cuando su nodo cruza
    // el 62 % del ancho de pantalla. Ahí entra la ficha y la cifra cuenta.
    const encender = (todo = false) => {
      const umbral = window.innerWidth * 0.62;
      for (const p of paradas) {
        if (todo && !p.activa) {
          p.activa = true;
          p.el.classList.add('activa');
          if (suave && p.cifra) contar(p.cifra);
          continue;
        }
        if (p.activa) continue;
        if (p.nodo.getBoundingClientRect().left > umbral) continue;
        p.activa = true;
        p.el.classList.add('activa');
        if (suave && p.cifra) contar(p.cifra);
      }
    };

    const horizontal = matchMedia('(min-width: 901px)');
    let pendiente = false;

    const medir = () => {
      pendiente = false;
      if (horizontal.matches) {
        const caja = marco.getBoundingClientRect();
        // Lo que sobra del bloque por encima de la pantalla es el recorrido útil.
        const recorrido = caja.height - window.innerHeight;
        const avance = recorrido <= 0 ? 1 : Math.min(Math.max(-caja.top / recorrido, 0), 1);
        // Cuánto tiene que correrse la pista para que su última ficha entre.
        const sobra = Math.max(pista.scrollWidth - window.innerWidth, 0);
        pista.style.transform = `translate3d(${(-sobra * avance).toFixed(1)}px,0,0)`;
        via.style.setProperty('--avance', avance.toFixed(4));
        encender(avance > 0.995);
        return;
      }
      pista.style.transform = '';
      encender();
    };

    const alScroll = () => {
      if (pendiente) return;
      pendiente = true;
      requestAnimationFrame(medir);
    };
    addEventListener('scroll', alScroll, { passive: true });
    addEventListener('resize', alScroll, { passive: true });

    // En columna el nodo no cruza nada horizontalmente: ahí manda el observador.
    if (!horizontal.matches) {
      const obs = new IntersectionObserver(
        (entradas) => {
          for (const e of entradas) {
            if (!e.isIntersecting) continue;
            const p = paradas.find((x) => x.el === e.target);
            if (!p || p.activa) continue;
            p.activa = true;
            p.el.classList.add('activa');
            if (suave && p.cifra) contar(p.cifra);
            obs.unobserve(e.target);
          }
        },
        { rootMargin: '0px 0px -18% 0px' },
      );
      for (const p of paradas) obs.observe(p.el);
    }

    medir();
  }
</script>
