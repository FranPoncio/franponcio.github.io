---
import { conBase } from '../lib/url';
import { logosDelStack } from '../lib/logos';
import { usarTraduccion, type Idioma } from '../i18n/ui';
import type { Proyecto } from '../lib/proyectos';

/**
 * LA TRAZA — el recorrido de 2013 a hoy sobre un caño horizontal.
 *
 * La traza muestra SÓLO los pines: año, título corto y la cifra. El detalle
 * completo vive en un popup que sale al pasar el mouse o al tocar el pin. Antes
 * cada estación arrastraba una ficha de 300 px siempre abierta y la traza era
 * una pila de cajas; ahora es una línea que se lee de un vistazo y que se abre
 * donde te interesa.
 *
 * Cómo se mueve: NO se secuestra la rueda. El bloque mide varias pantallas y
 * adentro hay un panel `sticky`; el scroll vertical normal se traduce a
 * desplazamiento horizontal. Anda con rueda, trackpad, teclado y barra.
 *
 * El pin es un <button> de verdad, así que se llega con Tab y el popup se abre
 * con Enter. En celular todo cae en columna y el popup se abre al tocar.
 */

interface Props {
  proyectos: Proyecto[];
  lang: Idioma;
}

const { proyectos, lang } = Astro.props;
const t = usarTraduccion(lang);
const base = lang === 'es' ? 'proyectos' : 'en/projects';

const anio = (periodo: string) => periodo.match(/\d{4}/)?.[0] ?? '';
const rango = (tramo: 'laboral' | 'proyecto') => {
  const del = proyectos.filter((p) => p.data.tramo === tramo);
  const anios = del.flatMap((p) => p.data.periodo.match(/\d{4}/g) ?? []);
  return anios.length ? `${anio(del[0].data.periodo)} — ${anios.sort().at(-1)}` : '';
};

/** El título largo no entra en un pin: se corta en el primer corte natural. */
const corto = (titulo: string) => {
  const limpio = titulo.split(/\s+[—–]\s+/)[0];
  return limpio.length > 34 ? limpio.slice(0, 32).trimEnd() + '…' : limpio;
};

let previo: string | null = null;
const estaciones = proyectos.map((p, i) => {
  const abre = p.data.tramo !== previo ? p.data.tramo : null;
  previo = p.data.tramo;
  return {
    p,
    arriba: i % 2 === 0,
    marcas: logosDelStack(p.data.stack, 3),
    rotulo: abre && {
      titulo: abre === 'laboral' ? t('tramo.laboral') : t('tramo.proyecto'),
      bajada: abre === 'laboral' ? t('tramo.laboral.bajada') : t('tramo.proyecto.bajada'),
      anios: rango(abre),
    },
  };
});
---

<section class="marco" id="traza" style={`--paradas:${estaciones.length}`}>
  <div class="pega">
    <div class="via" aria-hidden="true"><span class="paquetes"></span></div>

    <ol class="pista">
      {
        estaciones.map(({ p, arriba, marcas, rotulo }) => (
          <li
            class:list={['parada', arriba ? 'arriba' : 'abajo', rotulo && 'abre-tramo']}
            style={`--c: var(--color-${p.data.categoria})`}
          >
            {rotulo && (
              <span class="tramo">
                <span class="valvula" aria-hidden="true" />
                <b>{rotulo.titulo}</b>
                <i>{rotulo.anios}</i>
                <em>{rotulo.bajada}</em>
              </span>
            )}

            <span class="nodo" aria-hidden="true" />

            {/* El pin: lo único que se ve siempre. */}
            <button type="button" class="pin" aria-expanded="false">
              <span class="pin-anio">{p.data.periodo}</span>
              <span class="pin-titulo">{corto(p.data.titulo)}</span>
              {p.data.kpis[0] && (
                <span class="pin-dato">
                  <b class="tabular-nums" data-cifra={p.data.kpis[0].valor}>
                    {p.data.kpis[0].valor}
                  </b>
                  <i>{p.data.kpis[0].label}</i>
                </span>
              )}
            </button>

            {/* El detalle, sólo cuando lo pedís. */}
            <span class="popup" role="group">
              <span class="popup-rubro">{p.data.categoria}</span>
              <span class="popup-titulo">{p.data.titulo}</span>
              <span class="popup-texto">{p.data.resumen}</span>

              <span class="popup-datos">
                {p.data.kpis.slice(0, 2).map((k) => (
                  <span>
                    <b class="tabular-nums">{k.valor}</b>
                    <i>{k.label}</i>
                  </span>
                ))}
              </span>

              <span class="popup-pie">
                <span class="marcas" aria-hidden="true">
                  {marcas.map((m) => (
                    <svg viewBox="0 0 24 24" role="presentation">
                      <path d={m.path} fill="currentColor" />
                    </svg>
                  ))}
                </span>
                <a href={conBase(`${base}/${p.id}/`)} class="ir">
                  {t('proyecto.ver')}
                </a>
              </span>
            </span>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .marco { height: calc(var(--paradas) * 44vh + 100vh); }
  .pega {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
  }

  /* ── El caño ──────────────────────────────────────────────────────────── */
  .via {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 14px;
    margin-top: -7px;
    border-radius: 5px;
    /* La pared del caño va con el borde VIVO y con relleno propio: con el
       borde tenue y fondo transparente, el tramo todavía vacío era invisible
       —y al principio de la traza está vacío casi todo. */
    border-top: 1px solid var(--color-borde-vivo);
    border-bottom: 1px solid var(--color-borde-vivo);
    background:
      repeating-linear-gradient(90deg, transparent 0 96px, var(--color-borde-vivo) 96px 98px),
      var(--color-panel-alto);
  }
  .via::after {
    content: '';
    position: absolute;
    top: 1px;
    bottom: 1px;
    left: 0;
    right: 0;
    border-radius: 4px;
    transform: scaleX(var(--avance, 1));
    transform-origin: left center;
    background: linear-gradient(
      90deg,
      var(--color-acento),
      color-mix(in srgb, var(--color-acento) 55%, transparent)
    );
    box-shadow: 0 0 16px -6px var(--color-acento);
  }
  /* Los pulsos que corren por el tramo cargado. */
  .paquetes {
    position: absolute;
    top: 1px;
    bottom: 1px;
    left: 0;
    right: 0;
    z-index: 1;
    border-radius: 4px;
    transform: scaleX(var(--avance, 1));
    transform-origin: left center;
    background-image: repeating-linear-gradient(
      90deg,
      transparent 0 58px,
      rgba(255, 255, 255, 0.9) 58px 96px,
      transparent 96px 150px
    );
    background-size: 300px 100%;
    animation: correr-gas 2.1s linear infinite;
  }
  @keyframes correr-gas {
    from { background-position: 0 0; }
    to { background-position: 300px 0; }
  }

  .pista {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: stretch;
    padding-left: 5vw;
    margin: 0;
    list-style: none;
    will-change: transform;
  }

  /* ── La estación ──────────────────────────────────────────────────────── */
  .parada {
    position: relative;
    --sangria: 0px;
    /* Mucho más angosta que antes: ahora entran seis en pantalla y la traza
       se lee como una línea, no como una fila de cajas. */
    flex: 0 0 calc(clamp(200px, 16vw, 245px) + var(--sangria));
  }
  .abre-tramo { --sangria: clamp(190px, 15vw, 230px); }

  .nodo {
    position: absolute;
    left: var(--sangria);
    top: 50%;
    z-index: 3;
    width: 17px;
    height: 17px;
    margin-top: -8.5px;
    margin-left: -8.5px;
    border-radius: 50%;
    border: 2.5px solid var(--c);
    background: var(--color-fondo);
    box-shadow: 0 0 0 4px var(--color-fondo);
    transition:
      transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.3s ease;
  }

  /* El pin: año, título corto y la cifra. Nada más. */
  .pin {
    position: absolute;
    left: calc(var(--sangria) + 18px);
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 0.28rem;
    width: clamp(160px, 13vw, 195px);
    padding: 0.35rem 0.4rem;
    margin: 0;
    border: 0;
    border-radius: 7px;
    background: none;
    text-align: left;
    cursor: pointer;
    font: inherit;
    color: inherit;
    transition: background-color 0.2s ease, transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .arriba .pin { bottom: calc(50% + 20px); }
  .abajo .pin { top: calc(50% + 20px); }

  .pin-anio {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 500;
    letter-spacing: -0.03em;
    color: var(--color-tenue);
  }
  .pin-titulo {
    font-family: var(--font-titulo);
    font-weight: 600;
    font-size: 0.86rem;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }
  .pin-dato {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    margin-top: 0.1rem;
  }
  .pin-dato b {
    font-family: var(--font-mono);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.08em;
    color: var(--c);
  }
  .pin-dato i {
    font-family: var(--font-mono);
    font-style: normal;
    font-size: 0.5rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--color-tenue);
  }

  /* ── El popup ─────────────────────────────────────────────────────────── */
  .popup {
    position: absolute;
    left: calc(var(--sangria) + 4px);
    z-index: 6;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: 285px;
    padding: 1rem 1.1rem;
    border: 1px solid var(--c);
    border-radius: 12px;
    background: var(--color-panel);
    box-shadow:
      0 4px 10px rgba(14, 23, 20, 0.07),
      0 30px 60px -24px color-mix(in srgb, var(--c) 65%, transparent);
    opacity: 0;
    visibility: hidden;
    translate: 0 8px;
    scale: 0.97;
    transition:
      opacity 0.22s ease,
      translate 0.28s cubic-bezier(0.16, 1, 0.3, 1),
      scale 0.28s cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0s linear 0.22s;
  }
  /* El popup sale del lado OPUESTO al pin: nunca lo tapa. */
  .arriba .popup { top: calc(50% + 22px); }
  .abajo .popup { bottom: calc(50% + 22px); }

  .parada.abierta .popup,
  .parada:hover .popup,
  .parada:focus-within .popup {
    opacity: 1;
    visibility: visible;
    translate: 0 0;
    scale: 1;
    transition-delay: 0s;
  }

  .popup-rubro {
    font-family: var(--font-mono);
    font-size: 0.52rem;
    letter-spacing: 0.17em;
    text-transform: uppercase;
    color: var(--c);
  }
  .popup-titulo {
    font-family: var(--font-titulo);
    font-weight: 700;
    font-size: 0.95rem;
    line-height: 1.28;
    letter-spacing: -0.025em;
  }
  .popup-texto {
    font-size: 0.78rem;
    line-height: 1.55;
    color: var(--color-tenue);
  }
  .popup-datos {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.4rem;
    margin-top: 0.15rem;
  }
  .popup-datos > span {
    display: flex;
    flex-direction: column;
  }
  .popup-datos b {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.07em;
  }
  .popup-datos i {
    font-family: var(--font-mono);
    font-style: normal;
    font-size: 0.5rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--color-tenue);
  }
  .popup-pie {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 0.35rem;
    padding-top: 0.7rem;
    border-top: 1px solid var(--color-borde);
  }
  .marcas { display: flex; gap: 0.45rem; color: var(--color-texto); }
  .marcas svg { width: 1rem; height: 1rem; opacity: 0.4; }
  .ir {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: -0.03em;
    color: var(--c);
    text-decoration: none;
  }
  .ir:hover { text-decoration: underline; text-underline-offset: 3px; }

  /* ── Reacción al pasar por encima ─────────────────────────────────────── */
  @media (hover: hover) {
    .parada:hover .pin { background: color-mix(in srgb, var(--c) 7%, transparent); }
    .parada:hover .nodo,
    .parada.abierta .nodo {
      transform: scale(1.55);
      box-shadow: 0 0 0 4px var(--color-fondo), 0 0 24px -2px var(--c);
    }
  }
  .pin:focus-visible { outline: 2px solid var(--c); outline-offset: 3px; }
  .ir:focus-visible { outline: 2px solid var(--c); outline-offset: 3px; border-radius: 3px; }

  /* ── El rótulo del tramo ──────────────────────────────────────────────── */
  .tramo {
    position: absolute;
    left: 0;
    bottom: calc(50% + 26px);
    width: calc(var(--sangria) - 1.5rem);
    padding-left: 1.1rem;
  }
  .valvula {
    position: absolute;
    left: 0;
    bottom: -32px;
    width: 11px;
    height: 26px;
    margin-left: -5.5px;
    border-radius: 3px;
    border: 2px solid var(--color-acento);
    background: var(--color-fondo);
    box-shadow: 0 0 0 4px var(--color-fondo);
  }
  .tramo b {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-acento);
  }
  .tramo i {
    display: block;
    margin-top: 0.2rem;
    font-family: var(--font-mono);
    font-style: normal;
    font-size: 0.58rem;
    letter-spacing: -0.03em;
    color: var(--color-tenue);
  }
  .tramo em {
    display: block;
    margin-top: 0.5rem;
    font-style: normal;
    font-size: 0.72rem;
    line-height: 1.45;
    color: var(--color-tenue);
  }

  /* ── Entrada: cada estación se enciende cuando el gas la alcanza ──────── */
  :global(.js-on) .pin,
  :global(.js-on) .anio,
  :global(.js-on) .tramo {
    opacity: 0;
    translate: 0 14px;
    transition: opacity 0.5s ease, translate 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  :global(.js-on) .parada.activa .pin,
  :global(.js-on) .parada.activa .tramo {
    opacity: 1;
    translate: 0 0;
  }
  :global(.js-on) .nodo {
    transform: scale(0.3);
    opacity: 0;
  }
  :global(.js-on) .parada.activa .nodo {
    transform: scale(1);
    opacity: 1;
  }
  @media (hover: hover) {
    :global(.js-on) .parada.activa:hover .nodo,
    :global(.js-on) .parada.activa.abierta .nodo {
      transform: scale(1.55);
    }
  }

  /* ── Celular: el MISMO caño, parado ───────────────────────────────────
     Esto antes era `display:none` sobre la vía y una columna de tarjetas: o
     sea, en el teléfono no había caño, ni gas, ni paquetes, ni nada que se
     moviera. Ahora la traza baja en vertical con el gas corriendo hacia abajo,
     y el popup se abre al tocar el pin. */
  @media (max-width: 900px) {
    .marco { height: auto; }
    .pega { position: relative; height: auto; overflow: visible; }

    .via {
      left: 1.45rem;
      right: auto;
      top: 0;
      bottom: 0;
      width: 16px;
      height: auto;
      margin-top: 0;
      margin-left: -8px;
      border-top: 0;
      border-bottom: 0;
      border-left: 1px solid var(--color-borde-vivo);
      border-right: 1px solid var(--color-borde-vivo);
      background:
        repeating-linear-gradient(180deg, transparent 0 84px, var(--color-borde-vivo) 84px 86px),
        var(--color-panel-alto);
    }
    .via::after {
      transform: scaleY(var(--avance, 1));
      transform-origin: top center;
      background: linear-gradient(
        180deg,
        var(--color-acento),
        color-mix(in srgb, var(--color-acento) 55%, transparent)
      );
    }
    .paquetes {
      transform: scaleY(var(--avance, 1));
      transform-origin: top center;
      background-image: repeating-linear-gradient(
        180deg,
        transparent 0 44px,
        rgba(255, 255, 255, 0.9) 44px 74px,
        transparent 74px 120px
      );
      background-size: 100% 240px;
      animation: correr-gas-abajo 2.1s linear infinite;
    }

    .pista {
      position: static;
      flex-direction: column;
      gap: 0;
      padding: 0 1.15rem 0 3.4rem;
      transform: none !important;
    }
    .parada {
      --sangria: 0px;
      flex: none;
      padding: 1.05rem 0;
      border-left: 0;
    }
    .pin-titulo { font-size: 0.95rem; }
    .pin-dato b { font-size: 1.3rem; }
    .abre-tramo { margin-top: 2.4rem; }

    .nodo {
      left: -1.95rem;
      top: 1.75rem;
      margin-top: 0;
      margin-left: 0;
      z-index: 3;
    }

    .pin { position: static; width: 100%; padding: 0; }
    .pin-dato { margin-top: 0.2rem; }

    /* En columna el popup no flota: se despliega abajo del pin y empuja. */
    .popup {
      position: static;
      width: 100%;
      height: 0;
      margin-top: 0;
      padding: 0;
      border-width: 0;
      overflow: hidden;
      translate: 0 0;
      scale: 1;
      box-shadow: none;
      transition: none;
    }
    .parada:hover .popup,
    .parada:focus-within .popup { opacity: 0; visibility: hidden; }
    .parada.abierta .popup {
      opacity: 1;
      visibility: visible;
      height: auto;
      margin-top: 0.85rem;
      padding: 1rem 1.1rem;
      border-width: 1px;
    }

    .tramo {
      position: static;
      width: auto;
      padding-left: 0;
      margin-bottom: 1rem;
    }
    .valvula { display: none; }
    .tramo em { max-width: 34ch; }
  }

  @keyframes correr-gas-abajo {
    from { background-position: 0 0; }
    to { background-position: 0 240px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .paquetes { animation: none; }
    .pin, .nodo, .popup { transition: none; }
  }
</style>

<script>
  const marco = document.querySelector<HTMLElement>('#traza');
  const pista = marco?.querySelector<HTMLElement>('.pista');
  const via = marco?.querySelector<HTMLElement>('.via');
  const suave = !matchMedia('(prefers-reduced-motion: reduce)').matches;

  /**
   * Cuenta una cifra hacia arriba respetando su formato: "12.000 km" cuenta el
   * número y devuelve el resto tal cual; "< 5 %" o "SPI / CPI" se dejan quietas
   * porque no hay nada que contar.
   */
  function contar(el: HTMLElement) {
    const texto = (el.dataset.cifra ?? el.textContent ?? '').trim();
    const m = texto.match(/^(\D*?)([\d.,]+)(.*)$/s);
    if (!m) return;
    const [, antes, crudo, despues] = m;
    const destino = parseInt(crudo.replace(/[.,]/g, ''), 10);
    if (!isFinite(destino) || destino === 0) return;
    const separador = crudo.includes('.') || crudo.includes(',');
    const t0 = performance.now();

    const paso = (ahora: number) => {
      const p = Math.min((ahora - t0) / 900, 1);
      const v = Math.round(destino * (p === 1 ? 1 : 1 - Math.pow(2, -10 * p)));
      el.textContent = antes + (separador ? v.toLocaleString('es-AR') : String(v)) + despues;
      if (p < 1) requestAnimationFrame(paso);
    };
    requestAnimationFrame(paso);
  }

  if (marco && pista && via) {
    const paradas = [...marco.querySelectorAll<HTMLElement>('.parada')].map((el) => ({
      el,
      nodo: el.querySelector<HTMLElement>('.nodo')!,
      pin: el.querySelector<HTMLButtonElement>('.pin')!,
      cifra: el.querySelector<HTMLElement>('.pin-dato b'),
      activa: false,
    }));

    // ── El popup: se abre al tocar el pin, y sólo uno a la vez ────────────
    const cerrarTodos = (menos?: HTMLElement) => {
      for (const p of paradas) {
        if (p.el === menos) continue;
        p.el.classList.remove('abierta');
        p.pin.setAttribute('aria-expanded', 'false');
      }
    };
    for (const p of paradas) {
      p.pin.addEventListener('click', (e) => {
        e.stopPropagation();
        const abre = !p.el.classList.contains('abierta');
        cerrarTodos(p.el);
        p.el.classList.toggle('abierta', abre);
        p.pin.setAttribute('aria-expanded', String(abre));
      });
    }
    document.addEventListener('click', () => cerrarTodos());
    addEventListener('keydown', (e) => {
      if (e.key === 'Escape') cerrarTodos();
    });

    // ── El recorrido ──────────────────────────────────────────────────────
    const encender = (todo = false) => {
      const umbral = window.innerWidth * 0.68;
      for (const p of paradas) {
        if (p.activa) continue;
        if (!todo && p.nodo.getBoundingClientRect().left > umbral) continue;
        p.activa = true;
        p.el.classList.add('activa');
        if (suave && p.cifra) contar(p.cifra);
      }
    };

    const horizontal = matchMedia('(min-width: 901px)');
    let pendiente = false;

    const medir = () => {
      pendiente = false;
      if (horizontal.matches) {
        const caja = marco.getBoundingClientRect();
        const recorrido = caja.height - window.innerHeight;
        const avance = recorrido <= 0 ? 1 : Math.min(Math.max(-caja.top / recorrido, 0), 1);
        const sobra = Math.max(pista.scrollWidth - window.innerWidth, 0);
        pista.style.transform = `translate3d(${(-sobra * avance).toFixed(1)}px,0,0)`;
        via.style.setProperty('--avance', avance.toFixed(4));
        encender(avance > 0.995);
        return;
      }
      pista.style.transform = '';
      // El caño vertical se llena con lo recorrido del bloque, igual que el
      // horizontal. Sin esto quedaba en el fallback (1) y no se movía nunca.
      // Misma cuenta que en horizontal: 0 cuando el bloque llega arriba de
      // todo, 1 cuando su final toca el borde inferior. La primera version
      // arrancaba al 69 % con la traza recien asomando.
      const caja = marco.getBoundingClientRect();
      const recorrido = caja.height - window.innerHeight;
      const avance = recorrido <= 0 ? 1 : Math.min(Math.max(-caja.top / recorrido, 0), 1);
      via.style.setProperty('--avance', avance.toFixed(4));
      encender();
    };

    const alScroll = () => {
      if (pendiente) return;
      pendiente = true;
      requestAnimationFrame(medir);
    };
    addEventListener('scroll', alScroll, { passive: true });
    addEventListener('resize', alScroll, { passive: true });

    // En columna el nodo no cruza nada horizontalmente: ahí manda el observador.
    if (!horizontal.matches) {
      const obs = new IntersectionObserver(
        (entradas) => {
          for (const e of entradas) {
            if (!e.isIntersecting) continue;
            const p = paradas.find((x) => x.el === e.target);
            if (!p || p.activa) continue;
            p.activa = true;
            p.el.classList.add('activa');
            if (suave && p.cifra) contar(p.cifra);
            obs.unobserve(e.target);
          }
        },
        { rootMargin: '0px 0px -15% 0px' },
      );
      for (const p of paradas) obs.observe(p.el);
    }

    medir();
  }
</script>
