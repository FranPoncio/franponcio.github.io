---
import { Image } from 'astro:assets';
import { conBase } from '../lib/url';
import { logosDelStack } from '../lib/logos';
import { usarTraduccion, type Idioma } from '../i18n/ui';
import type { Proyecto } from '../lib/proyectos';

interface Props {
  proyecto: Proyecto;
  lang: Idioma;
}

const { proyecto, lang } = Astro.props;
const t = usarTraduccion(lang);
const base = lang === 'es' ? 'proyectos' : 'en/projects';
const { titulo, resumen, categoria, periodo, rol, stack, kpis, borrador, portada } =
  proyecto.data;

// Tailwind necesita ver las clases enteras para generarlas, así que el mapa
// guarda strings completos en vez de armarlos con `border-${categoria}`.
// Tailwind necesita ver las clases enteras, por eso van escritas completas.
// El realce va por box-shadow y no por border: así la tarjeta no cambia de
// tamaño en hover ni empuja a las vecinas.
const acento = {
  datos: { brillo: 'hover:shadow-[0_0_0_1px_var(--color-datos)]', texto: 'text-datos', punto: 'bg-datos' },
  gestion: { brillo: 'hover:shadow-[0_0_0_1px_var(--color-gestion)]', texto: 'text-gestion', punto: 'bg-gestion' },
  herramienta: {
    brillo: 'hover:shadow-[0_0_0_1px_var(--color-herramienta)]',
    texto: 'text-herramienta',
    punto: 'bg-herramienta',
  },
}[categoria];

const destacado = kpis[0];

// Marca de agua: los logos de las herramientas del proyecto. Los SVG vienen de
// simple-icons, incrustados durante el build — cero pedidos de red.
// Power BI y Tableau NO están en el paquete: Microsoft y Salesforce pidieron
// que los saquen. Esos casos quedan sin marca, que es lo correcto — dibujar
// una aproximación de una marca ajena es peor que no ponerla.
const marcas = logosDelStack(stack, 3);
---

<a
  href={conBase(`${base}/${proyecto.id}/`)}
  class:list={[
    'tarjeta group relative flex flex-col overflow-hidden rounded-xl border border-borde bg-panel hover:bg-panel-alto',
    acento.brillo,
  ]}
>
  {
    portada && marcas.length > 0 && (
      <span class="marcas" aria-hidden="true">
        {marcas.map((m) => (
          <svg viewBox="0 0 24 24" role="presentation">
            <path d={m.path} fill="currentColor" />
          </svg>
        ))}
      </span>
    )
  }

  {
    portada ? (
      <Image
        src={portada.src}
        alt={portada.alt}
        widths={[400, 800]}
        sizes="(min-width: 768px) 45vw, 90vw"
        class="h-28 w-full object-cover"
        loading="lazy"
      />
    ) : marcas.length > 0 ? (
      /* Sin foto, el arte de la tarjeta son las herramientas: los mismos
         logos, en grande. Es el hueco resuelto con algo que además informa. */
      <div class="portada-marcas h-28 w-full" aria-hidden="true">
        {marcas.map((m) => (
          <svg viewBox="0 0 24 24" role="presentation">
            <path d={m.path} fill="currentColor" />
          </svg>
        ))}
      </div>
    ) : (
      <div class="sin-portada h-28 w-full" />
    )
  }

  <div class="flex flex-1 flex-col p-4">
  <div class="flex items-center gap-2.5">
    <span class:list={['size-1.5 rounded-full', acento.punto]}></span>
    <span class:list={['font-mono text-[0.68rem] uppercase tracking-[0.14em]', acento.texto]}>
      {categoria}
    </span>
    <span class="ml-auto font-mono text-[0.68rem] text-tenue">{periodo}</span>
  </div>

  <h3 class="mt-4 text-base font-semibold leading-snug">
    {titulo}
    {
      borrador && (
        <span class="ml-2 align-middle rounded bg-acento/15 px-1.5 py-0.5 font-mono text-[0.6rem] uppercase tracking-wider text-acento">
          {t('proyecto.borrador')}
        </span>
      )
    }
  </h3>
  <p class="resumen mt-2 text-[0.82rem] leading-relaxed text-tenue">{resumen}</p>

  {
    destacado && (
      <p class="mt-5 font-mono text-sm">
        <span class="text-2xl font-semibold tabular-nums">{destacado.valor}</span>
        <span class="ml-2 text-tenue">{destacado.label}</span>
      </p>
    )
  }

  <div class="mt-auto pt-5 flex flex-wrap items-center gap-x-3 gap-y-2">
    {
      stack.slice(0, 3).map((t) => (
        <span class="rounded border border-borde px-2 py-0.5 font-mono text-[0.68rem] text-tenue">
          {t}
        </span>
      ))
    }
    <span
      class:list={[
        'ml-auto font-mono text-xs opacity-0 transition-opacity group-hover:opacity-100',
        acento.texto,
      ]}
    >
      {t('proyecto.ver')}
    </span>
  </div>

  <span class="sr-only">{t('proyecto.rol')}: {rol}</span>
  </div>
</a>

<style>
  /* El resumen se corta a tres líneas: si no, una tarjeta con texto largo
     estira a todas las de la fila y el carrusel queda desparejo. */
  .resumen {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
  }

  .portada-marcas {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.15rem;
    border-bottom: 1px solid var(--color-borde);
    background:
      repeating-linear-gradient(
        45deg,
        var(--color-panel-alto),
        var(--color-panel-alto) 9px,
        var(--color-panel) 9px,
        var(--color-panel) 18px
      );
    color: var(--color-texto);
  }
  .portada-marcas svg {
    width: 2.1rem;
    height: 2.1rem;
    flex: none;
    opacity: 0.34;
    transition: opacity 0.3s ease, transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .group:hover .portada-marcas svg { opacity: 0.55; transform: translateY(-2px); }
  @media (prefers-reduced-motion: reduce) {
    .portada-marcas svg { transition: none; }
    .group:hover .portada-marcas svg { transform: none; }
  }

  /* Los logos viven detrás del texto, apenas visibles. Se despiertan un poco
     al pasar el mouse: es el único momento en que tiene sentido mirarlos. */
  .marcas {
    position: absolute;
    right: 0.9rem;
    bottom: 0.9rem;
    z-index: 0;
    display: flex;
    gap: 0.55rem;
    pointer-events: none;
    color: var(--color-texto);
    opacity: 0.07;
    transition:
      opacity 0.25s ease,
      transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .marcas svg { width: 3.1rem; height: 3.1rem; flex: none; }

  .group:hover .marcas { opacity: 0.12; transform: translateY(-0.35rem); }

  /* El contenido va por encima de la marca de agua. */
  .group > :global(div) { position: relative; z-index: 1; }

  @media (prefers-reduced-motion: reduce) {
    .marcas { transition: none; }
    .group:hover .marcas { transform: none; }
  }
</style>
