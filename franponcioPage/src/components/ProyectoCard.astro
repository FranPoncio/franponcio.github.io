---
import { Image } from 'astro:assets';
import { conBase } from '../lib/url';
import { logosDelStack } from '../lib/logos';
import { usarTraduccion, type Idioma } from '../i18n/ui';
import type { Proyecto } from '../lib/proyectos';

/**
 * Un proyecto en la fila. SIN recuadro: la tarjeta encajonada pesaba más que
 * lo que contenía. Queda la imagen, el título y el dato — el bloque se separa
 * del de al lado por el aire, no por una caja.
 *
 * Al pasar el mouse se arma una secuencia corta: sube, la imagen se acerca, el
 * caño de la izquierda se llena de arriba abajo y el "ver el caso" entra desde
 * la izquierda. Es el mismo gesto que hace el troncal de la página, en chico.
 */

interface Props {
  proyecto: Proyecto;
  lang: Idioma;
}

const { proyecto, lang } = Astro.props;
const t = usarTraduccion(lang);
const base = lang === 'es' ? 'proyectos' : 'en/projects';
const { titulo, resumen, categoria, periodo, stack, kpis, borrador, portada } = proyecto.data;

const destacado = kpis[0];
const marcas = logosDelStack(stack, 3);
---

<a
  href={conBase(`${base}/${proyecto.id}/`)}
  class:list={['pieza group', `cat-${categoria}`]}
  style={`--cat: var(--color-${categoria})`}
>
  <span class="marco">
    {
      portada ? (
        <Image
          src={portada.src}
          alt={portada.alt}
          widths={[300, 600]}
          sizes="270px"
          class="lienzo"
          loading="lazy"
        />
      ) : (
        <span class="lienzo lienzo-marcas" aria-hidden="true">
          {marcas.map((m) => (
            <svg viewBox="0 0 24 24" role="presentation">
              <path d={m.path} fill="currentColor" />
            </svg>
          ))}
        </span>
      )
    }
    <span class="velo"></span>
  </span>

  <span class="cuerpo">
    <span class="encabezado">
      <span class="rubro">{categoria}</span>
      <span class="periodo">{periodo}</span>
    </span>

    <span class="titulo">
      {titulo}
      {borrador && <span class="sello">{t('proyecto.borrador')}</span>}
    </span>

    <span class="resumen">{resumen}</span>

    {
      destacado && (
        <span class="dato">
          <b>{destacado.valor}</b>
          <i>{destacado.label}</i>
        </span>
      )
    }

    <span class="pie">
      <span class="tags">{stack.slice(0, 2).join(' · ')}</span>
      <span class="ir">{t('proyecto.ver')}</span>
    </span>
  </span>
</a>

<style>
  .pieza {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding-left: 0.9rem;
    text-decoration: none;
    color: inherit;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* El caño de la izquierda: el mismo gesto del troncal de la página, en
     chico. Vacío en reposo, se llena de arriba abajo en hover. */
  .pieza::before,
  .pieza::after {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    border-radius: 2px;
  }
  .pieza::before {
    background: var(--color-borde);
  }
  .pieza::after {
    background: var(--cat);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .marco {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 6px;
    background: var(--color-panel-alto);
  }

  .lienzo {
    display: block;
    width: 100%;
    height: 6.5rem;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .lienzo-marcas {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.15rem;
    color: var(--color-texto);
    background: repeating-linear-gradient(
      45deg,
      var(--color-panel-alto),
      var(--color-panel-alto) 9px,
      var(--color-panel) 9px,
      var(--color-panel) 18px
    );
  }
  .lienzo-marcas svg {
    width: 1.9rem;
    height: 1.9rem;
    flex: none;
    opacity: 0.38;
    transition: opacity 0.4s ease;
  }

  /* Un baño del color de la categoría que entra desde abajo. */
  .velo {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, color-mix(in srgb, var(--cat) 26%, transparent), transparent 62%);
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .cuerpo {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .encabezado {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  .rubro { color: var(--cat); }
  .periodo { color: var(--color-tenue); letter-spacing: -0.02em; }

  .titulo {
    font-family: var(--font-titulo);
    font-weight: 700;
    font-size: 0.92rem;
    line-height: 1.35;
    letter-spacing: -0.07em;
  }
  .sello {
    display: inline-block;
    margin-left: 0.35rem;
    padding: 0.1rem 0.3rem;
    border-radius: 3px;
    background: color-mix(in srgb, var(--color-acento) 15%, transparent);
    color: var(--color-acento);
    font-size: 0.52rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    vertical-align: middle;
  }

  .resumen {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
    font-size: 0.78rem;
    line-height: 1.55;
    color: var(--color-tenue);
  }

  .dato {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    margin-top: 0.15rem;
  }
  .dato b {
    font-family: var(--font-mono);
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.08em;
    font-variant-numeric: tabular-nums;
  }
  .dato i {
    font-family: var(--font-mono);
    font-style: normal;
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-tenue);
  }

  .pie {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.6rem;
    margin-top: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: -0.03em;
    color: var(--color-tenue);
  }
  .ir {
    color: var(--cat);
    opacity: 0;
    translate: -0.5rem 0;
    transition:
      opacity 0.35s ease,
      translate 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* ── La secuencia del hover ─────────────────────────────────────────── */
  @media (hover: hover) {
    .pieza:hover { transform: translateY(-5px); }
    .pieza:hover::after { transform: scaleY(1); }
    .pieza:hover .lienzo { transform: scale(1.07); }
    .pieza:hover .lienzo-marcas svg { opacity: 0.72; }
    .pieza:hover .velo { opacity: 1; }
    .pieza:hover .ir { opacity: 1; translate: 0 0; }
    .pieza:hover .tags { opacity: 0.5; }
  }
  .pieza:focus-visible {
    outline: 2px solid var(--cat);
    outline-offset: 6px;
    border-radius: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .pieza,
    .pieza::after,
    .lienzo,
    .velo,
    .ir { transition: none; }
    .pieza:hover { transform: none; }
    .pieza:hover .lienzo { transform: none; }
  }
</style>
