---
import type { CollectionEntry } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Carrusel from './Carrusel.astro';
import { usarTraduccion, type Idioma } from '../i18n/ui';

/**
 * Formación: una fila de certificados que se desliza.
 *
 * Antes eran tres columnas por estado (cursando / completado / planificado) y
 * las columnas flacas dejaban huecos. Ahora es una sola fila de imágenes: lo
 * Va TODO en la misma fila: lo hecho, lo que está en curso y lo planificado.
 * Antes lo planificado iba aparte, abajo, con el argumento de que todavía no
 * es una credencial y no debería ocupar el mismo lugar visual que una. El
 * argumento sigue en pie, pero se resuelve mejor con una chapa de estado en
 * cada tarjeta que sacando las cosas de la fila: así se ve todo el recorrido
 * de una y igual se distingue de un vistazo qué está hecho y qué no.
 *
 * El orden pone adelante lo que ya tiene respaldo —completado y cursando— y
 * deja lo planificado al final. Ordenado sólo por `orden`, los dos cursos
 * planificados quedaban PRIMEROS, encabezando la formación con dos cosas que
 * todavía no existen.
 *
 * Los cursos sin certificado en el repo muestran una insignia generada, que
 * dice en la propia imagen que no es un certificado.
 */

interface Props {
  cursos: CollectionEntry<'formacion'>[];
  lang: Idioma;
}

const { cursos, lang } = Astro.props;
const t = usarTraduccion(lang);

const peso = { cursando: 0, completado: 0, planificado: 1 } as const;
const enFila = [...cursos].sort(
  (a, b) =>
    peso[a.data.estado] - peso[b.data.estado] || a.data.orden - b.data.orden,
);

// `getImage` corre en el build: la URL del certificado en grande ya viene
// optimizada y con hash, nunca se sirve el original.
const plenos = new Map<string, string>();
for (const c of cursos) {
  const fuente = c.data.certificado ?? c.data.insignia;
  if (fuente) plenos.set(c.id, (await getImage({ src: fuente, width: 1600 })).src);
}

const nota = (c: CollectionEntry<'formacion'>) =>
  lang === 'en' ? (c.data.notaEn ?? c.data.nota) : c.data.nota;
---

<section class="revelar bg-panel/50">
  <div class="mx-auto max-w-5xl px-6 py-14">
    <div>
      <Carrusel
        etiqueta={t('formacion.titulo')}
        anterior={t('carrusel.anterior')}
        siguiente={t('carrusel.siguiente')}
      >
        {
          enFila.map((c) => {
            const imagen = c.data.certificado ?? c.data.insignia;
            const esInsignia = !c.data.certificado && !!c.data.insignia;
            return (
              <article class="tarjeta ficha-curso flex flex-col overflow-hidden">
                {imagen && (
                  <a
                    href={plenos.get(c.id)}
                    class="relative block overflow-hidden border-b border-borde bg-panel-alto"
                    aria-label={`${t('formacion.certificado')}: ${c.data.titulo}`}
                  >
                    {c.data.estado !== 'completado' && (
                      <span class:list={['estado', c.data.estado]}>
                        {t(`formacion.${c.data.estado}`)}
                      </span>
                    )}
                    <Image
                      src={imagen}
                      alt={
                        esInsignia
                          ? `${c.data.titulo} — ${t('formacion.insignia')}`
                          : `${t('formacion.certificado')} — ${c.data.titulo}`
                      }
                      widths={[340, 680]}
                      sizes="340px"
                      class="h-24 w-full object-cover object-top"
                      loading="lazy"
                    />
                  </a>
                )}

                <div class="flex flex-1 flex-col p-2.5">
                  <p class="text-[0.78rem] font-medium leading-snug">{c.data.titulo}</p>
                  <p class="mt-0.5 font-mono text-[0.58rem] text-tenue">
                    {c.data.entidad} · {c.data.periodo}
                  </p>
                  {nota(c) && <p class="mt-1.5 text-[0.68rem] leading-snug text-tenue">{nota(c)}</p>}

                  <div class="mt-auto flex flex-wrap gap-1.5 pt-2.5">
                    {c.data.certificado && (
                      <a
                        href={plenos.get(c.id)}
                        class="rounded border border-borde px-1.5 py-0.5 font-mono text-[0.56rem] text-tenue transition-colors hover:border-acento hover:text-acento"
                      >
                        {t('formacion.verCertificado')}
                      </a>
                    )}
                    {c.data.certificadoPdf && (
                      <a
                        href={c.data.certificadoPdf}
                        class="rounded border border-borde px-1.5 py-0.5 font-mono text-[0.56rem] text-tenue transition-colors hover:border-acento hover:text-acento"
                      >
                        PDF ↗
                      </a>
                    )}
                    {c.data.credencial && (
                      <a
                        href={c.data.credencial}
                        class="rounded border border-borde px-1.5 py-0.5 font-mono text-[0.56rem] text-tenue transition-colors hover:border-acento hover:text-acento"
                      >
                        {t('formacion.credencial')}
                      </a>
                    )}
                  </div>
                </div>
              </article>
            );
          })
        }
      </Carrusel>
    </div>

  </div>
</section>

<style>
  /* La chapa de estado: lo que reemplaza a sacar las cosas de la fila.
     Sin esto, un curso planificado se ve igual que uno con certificado. */
  .estado {
    position: absolute;
    top: 0.4rem;
    right: 0.4rem;
    z-index: 2;
    border-radius: 999px;
    padding: 0.1rem 0.45rem;
    font-size: 0.52rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-fondo);
  }
  .estado.cursando { background: var(--color-datos); }
  .estado.planificado { background: var(--color-tenue); }

  .ficha-curso {
    border: 1px solid var(--color-borde);
    border-radius: 10px;
    background: var(--color-panel);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  @media (hover: hover) {
    .ficha-curso:hover {
      transform: translateY(-3px);
      border-color: var(--color-borde-vivo);
    }
  }
</style>
