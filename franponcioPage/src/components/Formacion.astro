---
import type { CollectionEntry } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import { usarTraduccion, type Idioma } from '../i18n/ui';

interface Props {
  cursos: CollectionEntry<'formacion'>[];
  /** Número de sección que se muestra arriba del título. */
  indice: string;
  lang: Idioma;
}

const { cursos, indice, lang } = Astro.props;
const t = usarTraduccion(lang);

// La miniatura linkea al certificado en grande. `getImage` corre en el build,
// así que la URL ya viene optimizada y con hash — no se sirve el original.
const certificadosPlenos = new Map<string, string>();
for (const curso of cursos) {
  if (curso.data.certificado) {
    const pleno = await getImage({ src: curso.data.certificado, width: 1600 });
    certificadosPlenos.set(curso.id, pleno.src);
  }
}

// Orden deliberado: primero lo que estoy haciendo (es lo más vivo), después lo
// terminado (lo que respalda), y al final lo que viene (muestra dirección).
const grupos = [
  { estado: 'cursando' as const, titulo: t('formacion.cursando'), punto: 'bg-acento', texto: 'text-acento' },
  { estado: 'completado' as const, titulo: t('formacion.completado'), punto: 'bg-gestion', texto: 'text-gestion' },
  { estado: 'planificado' as const, titulo: t('formacion.planificado'), punto: 'bg-tenue', texto: 'text-tenue' },
].map((g) => ({
  ...g,
  items: cursos
    .filter((c) => c.data.estado === g.estado)
    .sort((a, b) => a.data.orden - b.data.orden),
}));
---

<section class="revelar scroll-mt-24 border-b border-borde bg-panel/40" id="formacion">
  <div class="mx-auto max-w-5xl px-6 py-16">
    <p class="indice">{indice}</p>
    <div class="mt-2 flex items-baseline gap-4">
      <h2 class="text-lg font-semibold sm:text-xl">{t('formacion.titulo')}</h2>
      <span class="font-mono text-xs tabular-nums text-tenue">
        {String(cursos.length).padStart(2, '0')}
      </span>
    </div>
    <p class="mt-1.5 text-sm text-tenue">{t('formacion.bajada')}</p>

    <div class="mt-8 grid items-start gap-px overflow-hidden rounded-lg border border-borde bg-borde md:grid-cols-3">
      {
        grupos.map((grupo) => (
          <div class="bg-panel p-5">
            <p class="flex items-center gap-2">
              <span class:list={['size-1.5 rounded-full', grupo.punto]} />
              <span
                class:list={[
                  'font-mono text-[0.68rem] uppercase tracking-[0.14em]',
                  grupo.texto,
                ]}
              >
                {grupo.titulo}
              </span>
              <span class="ml-auto font-mono text-[0.68rem] tabular-nums text-tenue">
                {grupo.items.length}
              </span>
            </p>

            {grupo.items.length === 0 ? (
              <p class="mt-4 text-sm text-tenue/60">—</p>
            ) : (
              <ul class="mt-4 space-y-4">
                {grupo.items.map((curso) => (
                  <li>
                    <p class="text-sm font-medium leading-snug">{curso.data.titulo}</p>
                    <p class="mt-0.5 font-mono text-[0.68rem] text-tenue">
                      {curso.data.entidad} · {curso.data.periodo}
                    </p>
                    {(lang === 'en' ? (curso.data.notaEn ?? curso.data.nota) : curso.data.nota) && (
                      <p class="mt-1 text-xs leading-snug text-tenue">
                        {lang === 'en' ? (curso.data.notaEn ?? curso.data.nota) : curso.data.nota}
                      </p>
                    )}
                    {curso.data.certificado && (
                      <a
                        href={certificadosPlenos.get(curso.id)}
                        class="mt-2.5 block overflow-hidden rounded border border-borde transition-colors hover:border-acento"
                        aria-label={`${t('formacion.certificado')}: ${curso.data.titulo}`}
                      >
                        <Image
                          src={curso.data.certificado}
                          alt={`${t('formacion.certificado')} — ${curso.data.titulo}`}
                          widths={[240, 480]}
                          sizes="240px"
                          class="h-24 w-full bg-panel-alto object-cover object-top"
                          loading="lazy"
                        />
                        <span class="block border-t border-borde px-2 py-1 font-mono text-[0.6rem] text-tenue">
                          {t('formacion.verCertificado')}
                        </span>
                      </a>
                    )}

                    {curso.data.certificadoPdf && (
                      <a
                        href={curso.data.certificadoPdf}
                        class="mt-2 inline-flex items-center gap-1.5 rounded border border-borde px-2 py-1 font-mono text-[0.62rem] text-tenue transition-colors hover:border-acento hover:text-acento"
                      >
                        PDF ↗ {t('formacion.verCertificado')}
                      </a>
                    )}

                    {curso.data.credencial && (
                      <a
                        href={curso.data.credencial}
                        class="mt-2 inline-flex items-center gap-1.5 rounded border border-borde px-2 py-1 font-mono text-[0.62rem] text-tenue transition-colors hover:border-acento hover:text-acento"
                      >
                        <svg width="10" height="10" viewBox="0 0 12 12" aria-hidden="true">
                          <path
                            d="M2.5 6.2l2.2 2.2 4.8-4.8"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.6"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          />
                        </svg>
                        {t('formacion.credencial')}
                      </a>
                    )}
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>
