---
/**
 * El troncal: una cañería vertical que baja por el centro de la página y se va
 * armando con el scroll.
 *
 * No es una barra de progreso disfrazada. Tiene pared, tiene juntas soldadas
 * cada tanto, y el gas la va llenando de arriba abajo mientras el caño se
 * ensancha. Las estaciones (Estacion.astro) se enganchan a este mismo eje.
 *
 * Todo lo mueve --avance (0 a 1), que escribe el script del layout:
 *   · el ancho, con scaleX — el caño "se abre" a medida que se usa
 *   · el llenado, con clip-path — NO con scaleY, porque escalar deformaría las
 *     juntas: quedarían más juntas arriba y más separadas abajo
 *   · la cabeza, con top en porcentaje
 *
 * Sin JavaScript el caño se ve entero y lleno, no vacío.
 */
---

<div class="troncal" aria-hidden="true">
  <div class="caño"></div>
  <div class="gas"></div>
  <div class="flujo"></div>
  <div class="cabeza"><span class="cabeza-nucleo"></span></div>
</div>

<style>
  .troncal {
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 16px;
    margin-left: -8px;
    pointer-events: none;
    /* Detrás de todo bloque, delante del fondo de la página. */
    z-index: -1;
    /* El caño se abre de 3 px a 16 px. Va acá para que caño, gas y juntas
       escalen juntos y las paredes nunca se despeguen del relleno. */
    transform: scaleX(calc(0.19 + var(--avance, 1) * 0.81));
    transform-origin: top center;
  }

  /* La pared: dos hilos verticales y las juntas soldadas cruzándolo. */
  .caño {
    position: absolute;
    inset: 0;
    border-left: 1px solid var(--color-borde);
    border-right: 1px solid var(--color-borde);
    background-image: repeating-linear-gradient(
      to bottom,
      transparent 0 84px,
      var(--color-borde) 84px 86px
    );
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 2%, #000 98%, transparent);
    mask-image: linear-gradient(to bottom, transparent, #000 2%, #000 98%, transparent);
  }

  /* El gas. `clip-path` recorta lo que falta por llenar sin deformar nada:
     las juntas del tramo lleno quedan exactamente donde están las de la pared. */
  .gas {
    position: absolute;
    inset: 1px;
    clip-path: inset(0 0 calc((1 - var(--avance, 1)) * 100%) 0);
    background:
      repeating-linear-gradient(
        to bottom,
        transparent 0 83px,
        color-mix(in srgb, var(--color-fondo) 55%, transparent) 83px 86px
      ),
      linear-gradient(to bottom, var(--color-acento-tenue), var(--color-acento));
    box-shadow: 0 0 calc(var(--avance, 1) * 20px) calc(var(--avance, 1) * -7px)
      var(--color-acento);
  }

  /* El gas CORRIENDO por adentro. Es la parte que hace que el caño parezca
     vivo y no un relleno pintado: pulsos claros que bajan sin parar por el
     tramo ya lleno.

     Sólo se anima background-position, que no toca layout. Y va recortado por
     el mismo clip-path que el gas, así que nunca se ve correr por un tramo
     todavía vacío. */
  .flujo {
    position: absolute;
    inset: 1px;
    clip-path: inset(0 0 calc((1 - var(--avance, 1)) * 100%) 0);
    background-image: repeating-linear-gradient(
      to bottom,
      transparent 0 26px,
      color-mix(in srgb, #fff 62%, transparent) 26px 34px,
      transparent 34px 60px
    );
    background-size: 100% 120px;
    mix-blend-mode: overlay;
    opacity: 0.85;
    animation: bajar 2.6s linear infinite;
  }
  @keyframes bajar {
    from { background-position: 0 0; }
    to   { background-position: 0 120px; }
  }

  /* El frente de avance: donde está llegando el gas ahora mismo. */
  .cabeza {
    position: absolute;
    left: 50%;
    top: calc(var(--avance, 1) * 100%);
    width: 26px;
    height: 26px;
    margin-left: -13px;
    margin-top: -13px;
    display: grid;
    place-items: center;
    /* Se contrarresta el scaleX del padre para que la cabeza quede redonda
       y no se estire junto con el caño. */
    transform: scaleX(calc(1 / (0.19 + var(--avance, 1) * 0.81)));
  }
  /* Un anillo que sale de la cabeza y se abre, como el golpe de presión
     cuando el frente llega. */
  .cabeza::before {
    content: '';
    position: absolute;
    width: 13px;
    height: 13px;
    border-radius: 50%;
    border: 1.5px solid var(--color-acento);
    animation: expandir 2.6s ease-out infinite;
  }
  @keyframes expandir {
    0%   { transform: scale(1);   opacity: 0.55; }
    70%  { transform: scale(2.6); opacity: 0; }
    100% { transform: scale(2.6); opacity: 0; }
  }

  .cabeza-nucleo {
    width: 13px;
    height: 13px;
    border-radius: 50%;
    background: var(--color-fondo);
    border: 2px solid var(--color-acento);
    box-shadow:
      0 0 10px -1px var(--color-acento),
      0 0 0 calc(var(--avance, 1) * 6px)
        color-mix(in srgb, var(--color-acento) 11%, transparent);
  }

  /* En pantallas chicas el centro lo ocupa el texto: el caño se corre al
     margen y adelgaza. */
  @media (max-width: 900px) {
    .troncal {
      left: 0.9rem;
      margin-left: 0;
      width: 10px;
    }
    .cabeza {
      width: 18px;
      height: 18px;
      margin-left: -9px;
      margin-top: -9px;
    }
    .cabeza-nucleo {
      width: 9px;
      height: 9px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gas,
    .cabeza-nucleo {
      box-shadow: none;
    }
    /* Nada que corra solo: se apagan el flujo y el anillo. */
    .flujo {
      animation: none;
      opacity: 0.3;
    }
    .cabeza::before {
      animation: none;
      opacity: 0;
    }
  }
</style>
