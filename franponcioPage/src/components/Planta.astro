---
/**
 * LA PLANTA — el remate de la página.
 *
 * El caño que baja por el medio de todo el sitio no se corta acá: sigue,
 * dobla en un codo y entra a la planta. Los números que venías viendo flotar
 * al costado de la traza terminan viajando por adentro del caño hasta ahí, y
 * de la planta sale el gas. Ese es el cierre: todo lo de arriba desemboca en
 * un solo lugar.
 *
 * Antes esto era una silueta de refinería entera —diez estructuras sueltas y
 * una cinta de datos que pasaba de largo por el frente— y no decía nada: el
 * caño de la página no llegaba a ninguna parte y la línea de producción no
 * salía ni entraba a ningún lado. Una planta sola, con el caño entrando, se
 * lee de una.
 *
 * Va en SVG y no en canvas: son treinta formas fijas y ocho cosas que se
 * mueven en línea recta. Las animaciones son CSS sobre `transform` y
 * `opacity`, o sea composición pura, sin un `requestAnimationFrame` más.
 *
 * Con `prefers-reduced-motion` no se apaga: se congela en una postal. Cada
 * número tiene su posición de reposo calculada sobre el mismo recorrido, así
 * que quietos quedan repartidos por el caño —algunos bajando, otros entrando—
 * y no amontonados en el cuadro cero.
 */

const azar = (semilla: number, a: number, b: number) => {
  // Ruido determinista: el mismo dibujo en cada build, sin depender del reloj.
  const x = Math.sin(semilla * 12.9898) * 43758.5453;
  return a + (x - Math.floor(x)) * (b - a);
};

/*
 * EL ESQUEMA, tal cual el que corresponde:
 *
 *      PRP ◄─────────┐  (el caño baja por el medio y dobla a la izquierda)
 *       └────────────────────────────► INDUSTRIA
 *
 * El gasoducto no entra directo a una fábrica: baja, dobla, entra a la
 * reductora, y de la reductora sale otra cañería —más abajo, porque ya es
 * otra presión— que recorre todo el ancho hasta la planta industrial.
 *
 * Antes la PRP estaba a la derecha, pegada a la industria, y el caño le
 * pasaba de largo por arriba: el lado izquierdo quedaba vacío y el recorrido
 * no se leía. Así usa el ancho entero y cuenta la secuencia sola.
 */
const EJE_X = 700; // el medio del viewBox: coincide con el caño de la página
const ENTRADA_Y = 236; // la línea que llega a la PRP
const SALIDA_Y = 320; // la que sale, más abajo
const SUELO = 398;

const PRP_X0 = 152;
const PRP_X1 = 432;
const IND_X0 = 980;
const IND_X1 = 1292;

/* Los dos tramos que recorren los datos. */
const VIAJE_ENTRADA = EJE_X - PRP_X1;
const VIAJE_SALIDA = IND_X0 - PRP_X1;

const estrellas = Array.from({ length: 34 }, (_, i) => ({
  x: azar(i + 1, 0, 1400),
  y: azar(i + 51, 12, 200),
  r: azar(i + 101, 0.7, 1.8),
  o: azar(i + 151, 0.25, 0.8),
  i,
}));

const nubes = [
  { y: 92, e: 1.0, i: 0 },
  { y: 158, e: 0.68, i: 1 },
  { y: 58, e: 1.3, i: 2 },
];

const aves = [
  { dx: 0, dy: 0, e: 1, i: 0 },
  { dx: 26, dy: 14, e: 0.8, i: 1 },
  { dx: 48, dy: -8, e: 0.9, i: 2 },
];

const CIFRAS = ['12.000', '413', '150', '500', '46', '135'];

/* Los que llegan a la PRP: bajan por el caño y doblan a la izquierda. */
const entrantes = Array.from({ length: 3 }, (_, i) => ({
  bit: CIFRAS[i],
  i,
  // Posición de reposo para el modo sin movimiento: repartidos por el
  // recorrido, unos bajando y otros ya doblando.
  rx: i === 0 ? 0 : -Math.round((i / 3) * VIAJE_ENTRADA),
  ry: i === 0 ? -180 : 0,
}));

/* Los que salen de la PRP hacia la industria. */
const salientes = Array.from({ length: 4 }, (_, i) => ({
  bit: CIFRAS[(i + 3) % CIFRAS.length],
  i,
  rx: Math.round(((i + 0.5) / 4) * VIAJE_SALIDA),
}));

const volutas = Array.from({ length: 10 }, (_, i) => ({
  x: IND_X1 - 62 + azar(i + 201, -10, 10),
  i,
}));
---

<section
  class="planta"
  aria-hidden="true"
  style={`--entrada:${VIAJE_ENTRADA}px; --salida:${VIAJE_SALIDA}px`}
>
  {/* `meet` y no `slice`: con `slice` el SVG se recorta por los costados en
      una pantalla angosta, y medido dejaba la industria ENTERA fuera de cuadro
      en un celular. Con `meet` entra todo siempre; el alto lo da el
      `aspect-ratio` del contenedor, y si sobra alto queda aire transparente
      arriba, que se funde con la página porque el cielo también lo es. */}
  <svg viewBox="0 0 1400 460" preserveAspectRatio="xMidYMax meet" role="presentation">
    <defs>
      <linearGradient id="cielo" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#1d2624" stop-opacity="0" />
        <stop offset="0.5" stop-color="#1b2422" stop-opacity="0.3" />
        <stop offset="1" stop-color="#1d2624" stop-opacity="0.72" />
      </linearGradient>
      <radialGradient id="luna">
        <stop offset="0" stop-color="#dfdcd4" stop-opacity="0.28" />
        <stop offset="0.45" stop-color="#dfdcd4" stop-opacity="0.08" />
        <stop offset="1" stop-color="#dfdcd4" stop-opacity="0" />
      </radialGradient>
      <linearGradient id="acero-v" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#15191a" />
        <stop offset="0.2" stop-color="#39413f" />
        <stop offset="0.38" stop-color="#8b9699" />
        <stop offset="0.62" stop-color="#525c56" />
        <stop offset="1" stop-color="#101314" />
      </linearGradient>
      <linearGradient id="acero-h" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#15191a" />
        <stop offset="0.2" stop-color="#39413f" />
        <stop offset="0.38" stop-color="#8b9699" />
        <stop offset="0.62" stop-color="#525c56" />
        <stop offset="1" stop-color="#101314" />
      </linearGradient>
      <radialGradient id="halo">
        <stop offset="0" stop-color="#c08552" stop-opacity="0.4" />
        <stop offset="0.4" stop-color="#c08552" stop-opacity="0.13" />
        <stop offset="1" stop-color="#c08552" stop-opacity="0" />
      </radialGradient>
      <radialGradient id="brillo-suelo">
        <stop offset="0" stop-color="#c08552" stop-opacity="0.22" />
        <stop offset="0.55" stop-color="#c08552" stop-opacity="0.07" />
        <stop offset="1" stop-color="#c08552" stop-opacity="0" />
      </radialGradient>
      <radialGradient id="nube">
        <stop offset="0" stop-color="#dfdcd4" stop-opacity="0.075" />
        <stop offset="0.6" stop-color="#dfdcd4" stop-opacity="0.03" />
        <stop offset="1" stop-color="#dfdcd4" stop-opacity="0" />
      </radialGradient>
      <radialGradient id="voluta">
        <stop offset="0" stop-color="#d4dae0" stop-opacity="0.5" />
        <stop offset="0.45" stop-color="#d4dae0" stop-opacity="0.2" />
        <stop offset="1" stop-color="#d4dae0" stop-opacity="0" />
      </radialGradient>
    </defs>

    <rect width="1400" height="460" fill="url(#cielo)" />

    <circle cx="118" cy="104" r="130" fill="url(#luna)" />
    <circle cx="118" cy="104" r="36" fill="#dfdcd4" opacity="0.8" />
    <circle cx="104" cy="93" r="6" fill="#0f1110" opacity="0.1" />
    <circle cx="131" cy="117" r="3.6" fill="#0f1110" opacity="0.08" />

    <g class="estrellas">
      {estrellas.map((e) => (
        <circle cx={e.x} cy={e.y} r={e.r} fill="#dfdcd4" opacity={e.o} style={`--i:${e.i}`} />
      ))}
    </g>

    <g class="nubes">
      {nubes.map((n) => (
        <g style={`--i:${n.i}; --e:${n.e}`}>
          <ellipse cx="0" cy={n.y} rx="132" ry="26" fill="url(#nube)" />
          <ellipse cx="78" cy={n.y - 10} rx="92" ry="20" fill="url(#nube)" />
          <ellipse cx="-72" cy={n.y + 6} rx="74" ry="17" fill="url(#nube)" />
        </g>
      ))}
    </g>

    <g class="fugaz">
      <path d="M0 0 L58 26" stroke="#dfdcd4" stroke-width="2" stroke-linecap="round" opacity="0.85" />
      <circle cx="58" cy="26" r="2.4" fill="#dfdcd4" />
    </g>

    <g class="aves">
      {aves.map((a) => (
        <path
          d={`M${a.dx - 9} ${a.dy} q 9 -7 9 0 q 0 -7 9 0`}
          fill="none"
          stroke="#dfdcd4"
          stroke-width="1.6"
          stroke-linecap="round"
          opacity="0.42"
          style={`--i:${a.i}; --e:${a.e}`}
        />
      ))}
    </g>

    {/* Las sierras */}
    <path
      d="M0 340 L150 300 L290 334 L440 296 L600 338 L760 300 L920 342 L1080 302 L1240 338 L1400 300 L1400 460 L0 460 Z"
      fill="#1a211f"
    />
    <path
      d="M0 366 L180 340 L340 366 L520 338 L700 368 L880 342 L1060 370 L1240 340 L1400 364 L1400 460 L0 460 Z"
      fill="#141a19"
    />

    {/* El resplandor del suelo bajo las dos plantas */}
    <ellipse cx={(PRP_X0 + PRP_X1) / 2} cy={SUELO} rx="230" ry="40" fill="url(#brillo-suelo)" opacity="0.7" />
    <ellipse cx={(IND_X0 + IND_X1) / 2} cy={SUELO} rx="250" ry="42" fill="url(#brillo-suelo)" />

    {/* ── EL CAÑO: baja por el medio, dobla a la IZQUIERDA y entra a la PRP ── */}
    <g class="canio">
      <rect x={EJE_X - 8} y="0" width="16" height={ENTRADA_Y + 16} fill="url(#acero-v)" />
      <rect
        x={PRP_X1 - 6}
        y={ENTRADA_Y}
        width={EJE_X - PRP_X1 + 14}
        height="16"
        fill="url(#acero-h)"
      />
      {/* La brida de entrada a la reductora */}
      <rect x={PRP_X1 - 4} y={ENTRADA_Y - 6} width="10" height="28" rx="1.5" fill="#98a3a5" />
      {/* Un caballete en el tramo de llegada */}
      <path
        d={`M${EJE_X - 95} ${SUELO} L${EJE_X - 80} ${ENTRADA_Y + 18} L${EJE_X - 65} ${SUELO}`}
        fill="none"
        stroke="#3f4a45"
        stroke-width="2.4"
      />
    </g>

    {/* ── LA PRP ─────────────────────────────────────────────────────── */}
    <g class="prp" fill="#0b0e0d" stroke="#3f4a45" stroke-width="1.6">
      <rect x={PRP_X0} y="250" width={PRP_X1 - PRP_X0} height={SUELO - 250} />
      {[0, 1].map((i) => (
        <path
          d={`M${PRP_X0 + 56 + i * 116} 250 L${PRP_X0 + 96 + i * 116} 202 L${PRP_X0 + 136 + i * 116} 250 Z`}
        />
      ))}
      {/* El cartel: en una reductora de verdad está, y acá además dice qué es. */}
      <rect x={PRP_X0 + 24} y="296" width="58" height="22" rx="2" />
      <text class="rotulo" x={PRP_X0 + 53} y="311">PRP</text>
      {/* Las ventanas */}
      <g class="luces">
        {Array.from({ length: 4 }, (_, i) => (
          <rect
            x={PRP_X0 + 108 + i * 40}
            y="332"
            width="12"
            height="14"
            rx="1"
            fill="#c08552"
            stroke="none"
            opacity="0.8"
            style={`--i:${i}`}
          />
        ))}
      </g>
    </g>

    {/* ── LA CAÑERÍA SALIENTE: de la PRP a la industria ──────────────── */}
    <g class="canio">
      <rect
        x={PRP_X1 - 6}
        y={SALIDA_Y}
        width={IND_X0 - PRP_X1 + 12}
        height="16"
        fill="url(#acero-h)"
      />
      {/* Bridas de salida y de llegada */}
      {[PRP_X1 - 2, IND_X0 - 4].map((x) => (
        <rect x={x} y={SALIDA_Y - 6} width="10" height="28" rx="1.5" fill="#98a3a5" />
      ))}
      {/* Los caballetes del tramo largo */}
      {[0, 1, 2].map((i) => {
        // Corridos para que no se enreden con el caballete del tramo que llega.
        const x = PRP_X1 + 88 + i * 190;
        return (
          <path
            d={`M${x - 14} ${SUELO} L${x} ${SALIDA_Y + 18} L${x + 14} ${SUELO}`}
            fill="none"
            stroke="#3f4a45"
            stroke-width="2.2"
          />
        );
      })}
    </g>

    {/* ── LA INDUSTRIA ───────────────────────────────────────────────── */}
    <g class="fabrica" fill="#0b0e0d" stroke="#3f4a45" stroke-width="1.6">
      <rect x={IND_X0} y="240" width={IND_X1 - IND_X0} height={SUELO - 240} />
      {[0, 1, 2, 3].map((i) => (
        <path
          d={`M${IND_X0 + i * 78} 240 L${IND_X0 + i * 78} 196 L${IND_X0 + (i + 1) * 78} 240 Z`}
        />
      ))}
      {/* La chimenea */}
      <rect x={IND_X1 - 80} y="112" width="36" height="130" />
      <rect x={IND_X1 - 86} y="106" width="48" height="10" rx="2" />
      <g class="luces">
        {Array.from({ length: 6 }, (_, i) => (
          <rect
            x={IND_X0 + 24 + i * 46}
            y="316"
            width="13"
            height="16"
            rx="1"
            fill="#c08552"
            stroke="none"
            opacity="0.8"
            style={`--i:${i}`}
          />
        ))}
      </g>
    </g>

    {/* La antorcha de la industria, con su halo */}
    <circle class="halo-llama" cx={IND_X0 + 34} cy="150" r="76" fill="url(#halo)" />
    <g class="fabrica" fill="#0b0e0d" stroke="#3f4a45" stroke-width="1.4">
      <rect x={IND_X0 + 28} y="176" width="13" height="66" />
      <path d={`M${IND_X0 + 22} 176 L${IND_X0 + 47} 176 L${IND_X0 + 43} 166 L${IND_X0 + 26} 166 Z`} />
    </g>
    <g class="llama">
      <path
        d={`M${IND_X0 + 34} 166 C${IND_X0 + 25} 148 ${IND_X0 + 41} 138 ${IND_X0 + 35} 120 C${IND_X0 + 51} 134 ${IND_X0 + 55} 152 ${IND_X0 + 46} 166 Z`}
        fill="#c08552"
        opacity="0.92"
      />
    </g>
    <circle class="baliza" cx={IND_X1 - 62} cy="100" r="4.5" fill="#e8604a" />

    {/* ── LOS DATOS ──────────────────────────────────────────────────── */}
    {/* Los que LLEGAN: bajan por el caño y doblan hacia la reductora. */}
    <g class="entrantes">
      {entrantes.map((v) => (
        <g style={`--i:${v.i}; --rx:${v.rx}px; --ry:${v.ry}px`}>
          <circle cx={EJE_X} cy={ENTRADA_Y + 8} r="17" fill="#0f1110" stroke="#6fa39c" stroke-width="1.5" />
          <text x={EJE_X} y={ENTRADA_Y + 12}>{v.bit}</text>
        </g>
      ))}
    </g>

    {/* Los que SALEN: de la reductora a la industria. */}
    <g class="salientes">
      {salientes.map((v) => (
        <g style={`--i:${v.i}; --rx:${v.rx}px`}>
          <circle cx={PRP_X1} cy={SALIDA_Y + 8} r="17" fill="#0f1110" stroke="#6fa39c" stroke-width="1.5" />
          <text x={PRP_X1} y={SALIDA_Y + 12}>{v.bit}</text>
        </g>
      ))}
    </g>

    {/* Los destellos: uno cuando entra a la PRP, otro cuando entra a la nave */}
    <circle class="ingreso" cx={PRP_X1} cy={ENTRADA_Y + 8} r="15" fill="#6fa39c" />
    <circle class="ingreso tarde" cx={IND_X0} cy={SALIDA_Y + 8} r="15" fill="#6fa39c" />

    {/* ── EL GAS ─────────────────────────────────────────────────────── */}
    <g class="humo">
      {volutas.map((v) => (
        <ellipse cx={v.x} cy="104" rx="26" ry="30" fill="url(#voluta)" style={`--i:${v.i}`} />
      ))}
    </g>

    {/* Primer plano */}
    <path
      d="M0 428 L140 416 L300 428 L470 412 L640 426 L820 410 L1000 426 L1180 412 L1400 424 L1400 460 L0 460 Z"
      fill="#0a0d0c"
    />
  </svg>
</section>

<style>
  .planta {
    position: relative;
    display: block;
    width: 100%;
    /* El alto sale del propio esquema. Antes era una altura fija y el SVG se
       recortaba por los costados; ahora el contenedor tiene la proporción del
       dibujo y entra todo. El mínimo es para que en una pantalla muy angosta
       no quede una fajita: si sobra alto, queda aire transparente arriba, que
       se funde con la página porque el cielo también es transparente. */
    aspect-ratio: 1400 / 460;
    min-height: 170px;
    max-height: 460px;
    overflow: hidden;
  }
  .planta svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .entrantes text,
  .salientes text {
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 700;
    text-anchor: middle;
    fill: var(--color-datos);
  }
  .rotulo {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-anchor: middle;
    fill: var(--color-tenue);
    stroke: none;
  }

  /* Todo lo que escala lleva `transform-box: fill-box`: en SVG el origen por
     defecto es el del lienzo y no el del elemento, así que sin esto la forma
     no se agranda en el lugar — se dispara por el cuadro. */
  .llama,
  .halo-llama,
  .baliza,
  .ingreso,
  .humo ellipse {
    transform-box: fill-box;
    transform-origin: center;
  }

  .estrellas circle {
    animation: titilar 7s ease-in-out infinite;
    animation-delay: calc(var(--i) * -0.29s);
  }
  @keyframes titilar {
    0%, 100% { opacity: 0.25; }
    50% { opacity: 0.85; }
  }

  .luces rect {
    animation: parpadeo 5.4s ease-in-out infinite;
    animation-delay: calc(var(--i) * -0.44s);
  }
  @keyframes parpadeo {
    0%, 100% { opacity: 0.8; }
    50% { opacity: 0.35; }
  }

  .nubes > g {
    animation: cruzar 145s linear infinite;
    animation-delay: calc(var(--i) * -48s);
    transform: scale(var(--e));
  }
  @keyframes cruzar {
    from { transform: translateX(-240px) scale(var(--e)); }
    to { transform: translateX(1660px) scale(var(--e)); }
  }

  .aves path {
    animation: volar 42s linear infinite, aletear 1.3s ease-in-out infinite;
    animation-delay: calc(var(--i) * -0.5s), calc(var(--i) * -0.22s);
  }
  @keyframes volar {
    from { transform: translate(-90px, 200px) scale(var(--e)); }
    to { transform: translate(1500px, 72px) scale(var(--e)); }
  }
  @keyframes aletear {
    0%, 100% { scale: 1 1; }
    50% { scale: 1 0.55; }
  }

  .fugaz {
    transform: translate(160px, 36px);
    opacity: 0;
    animation: fugarse 26s linear infinite;
  }
  @keyframes fugarse {
    0%, 88% { transform: translate(160px, 36px); opacity: 0; }
    89% { opacity: 0.9; }
    97%, 100% { transform: translate(560px, 214px); opacity: 0; }
  }

  .llama { animation: arder 2.3s ease-in-out infinite; }
  @keyframes arder {
    0%, 100% { transform: scaleY(1) scaleX(1); }
    32% { transform: scaleY(1.24) scaleX(0.88); }
    68% { transform: scaleY(0.86) scaleX(1.1); }
  }
  .halo-llama { animation: latir-halo 2.3s ease-in-out infinite; }
  @keyframes latir-halo {
    0%, 100% { opacity: 0.75; transform: scale(1); }
    32% { opacity: 1; transform: scale(1.1); }
  }

  .baliza { animation: balizar 3.6s ease-in-out infinite; }
  @keyframes balizar {
    0%, 62%, 100% { opacity: 0.18; transform: scale(0.85); }
    72% { opacity: 1; transform: scale(1.25); }
  }

  .humo ellipse {
    animation: subir 13s linear infinite;
    animation-delay: calc(var(--i) * -1.3s);
  }
  @keyframes subir {
    from { transform: translateY(0) scale(0.4); opacity: 0; }
    14% { opacity: 1; }
    to { transform: translateY(-185px) scale(2.9); opacity: 0; }
  }

  /* ── EL VIAJE DE LOS DATOS ─────────────────────────────────────────
     Dos tramos, y dos grupos: no es el mismo dato el que baja y el que sale.
     Uno entra a la reductora y ahí se termina su viaje; del otro lado sale
     otro, ya regulado, hacia la industria. Con un solo elemento habría que
     hacerlo desaparecer y reaparecer más abajo, que es justo lo que no pasa
     en una cañería. */
  .entrantes > g {
    animation: llegar 15s linear infinite;
    animation-delay: calc(var(--i) * -5s);
  }
  @keyframes llegar {
    0% { transform: translate(0, -330px); opacity: 0; }
    8% { opacity: 1; }
    46% { transform: translate(0, 0); }
    94% { opacity: 1; }
    100% { transform: translate(calc(var(--entrada) * -1), 0); opacity: 0; }
  }

  .salientes > g {
    animation: salir 15s linear infinite;
    animation-delay: calc(var(--i) * -3.75s);
  }
  @keyframes salir {
    0% { transform: translate(0, 0); opacity: 0; }
    6% { opacity: 1; }
    94% { opacity: 1; }
    100% { transform: translate(var(--salida), 0); opacity: 0; }
  }

  /* Los destellos laten al ritmo con el que llegan los datos a cada pared. */
  .ingreso { animation: acusar 5s ease-out infinite; }
  .ingreso.tarde { animation-duration: 3.75s; }
  @keyframes acusar {
    0% { opacity: 0.55; transform: scale(0.35); }
    70%, 100% { opacity: 0; transform: scale(1.5); }
  }

  /* ── Quieta ───────────────────────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
