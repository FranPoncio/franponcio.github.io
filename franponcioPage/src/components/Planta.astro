---
/**
 * LA PLANTA — el remate de la página.
 *
 * El caño que baja por el medio de todo el sitio no se corta acá: sigue,
 * dobla en un codo y entra a la planta. Los números que venías viendo flotar
 * al costado de la traza terminan viajando por adentro del caño hasta ahí, y
 * de la planta sale el gas. Ese es el cierre: todo lo de arriba desemboca en
 * un solo lugar.
 *
 * Antes esto era una silueta de refinería entera —diez estructuras sueltas y
 * una cinta de datos que pasaba de largo por el frente— y no decía nada: el
 * caño de la página no llegaba a ninguna parte y la línea de producción no
 * salía ni entraba a ningún lado. Una planta sola, con el caño entrando, se
 * lee de una.
 *
 * Va en SVG y no en canvas: son treinta formas fijas y ocho cosas que se
 * mueven en línea recta. Las animaciones son CSS sobre `transform` y
 * `opacity`, o sea composición pura, sin un `requestAnimationFrame` más.
 *
 * Con `prefers-reduced-motion` no se apaga: se congela en una postal. Cada
 * número tiene su posición de reposo calculada sobre el mismo recorrido, así
 * que quietos quedan repartidos por el caño —algunos bajando, otros entrando—
 * y no amontonados en el cuadro cero.
 */

const azar = (semilla: number, a: number, b: number) => {
  const x = Math.sin(semilla * 12.9898) * 43758.5453;
  return a + (x - Math.floor(x)) * (b - a);
};

const estrellas = Array.from({ length: 38 }, (_, i) => ({
  x: azar(i + 1, 0, 1600),
  y: azar(i + 51, 10, 230),
  r: azar(i + 101, 0.7, 1.9),
  o: azar(i + 151, 0.25, 0.8),
  i,
}));

/* El recorrido del caño, en coordenadas del viewBox.
   Baja por el centro (x = 800) hasta el codo y entra a la planta por la
   izquierda. Estos tres números mandan sobre el dibujo Y sobre la animación:
   si se mueve el codo, los números lo siguen solos. */
const EJE_X = 800;
const CODO_Y = 330;

/* La PRP —planta reductora de presión— entre el caño y la industria. Es como
   funciona de verdad: el gasoducto no entra directo a una fábrica, primero
   pasa por una reductora que le baja la presión de transporte a la de uso.
   El dato hace el mismo camino: baja, se regula, y recién ahí se consume. */
const PRP_X0 = 820;
const PRP_X1 = 952;

/* La industria. Termina en 1300 y no más a la derecha por una razón medida:
   el SVG usa `slice`, así que en un celular se recorta por los costados, y
   pasado ese punto la fábrica quedaba entera fuera de pantalla. */
const IND_X0 = 1060;
const IND_X1 = 1268;
const ENTRADA_X = IND_X0;

const BAJADA = CODO_Y + 40; // de cuánto más arriba de la pantalla vienen
const TRAMO = ENTRADA_X - EJE_X - 24;
/* El viaje horizontal completo, para que la animación no lleve el número a mano. */
const VIAJE = ENTRADA_X - EJE_X + 18;
/** Qué fracción del viaje se va bajando; el resto es el tramo horizontal. */
const CORTE = 0.4;

/* CINCO y no ocho. Con ocho, y a este tamaño, sobre el tramo horizontal
   quedaba una molécula cada 55 unidades para un diámetro de 42: casi
   pegadas, y entre todas tapaban la reductora justo cuando el punto era
   mostrarla. */
const CIFRAS = ['12.000', '413', '150', '500', '46'];
const viajeros = CIFRAS.map((bit, i) => {
  // Posición de reposo: la misma cuenta que hace la animación, pero congelada
  // en el punto que le toca a cada uno. Es lo que usa el modo sin movimiento.
  const t = i / CIFRAS.length;
  const rx = t < CORTE ? 0 : ((t - CORTE) / (1 - CORTE)) * TRAMO;
  const ry = t < CORTE ? -BAJADA * (1 - t / CORTE) : 0;
  return { bit, i, rx: rx.toFixed(0), ry: ry.toFixed(0) };
});

/* Doce volutas y no nueve: con el desenfoque puesto, menos de eso se ve como
   manchitas sueltas en vez de una columna de gas. */
/* Nubes altas, que cruzan lento. Anchos distintos para que no se lean como
   tres copias de la misma. */
const nubes = [
  { y: 96, e: 1.0, i: 0 },
  { y: 168, e: 0.68, i: 1 },
  { y: 62, e: 1.35, i: 2 },
];

/* Los pájaros: tres, en bandada floja. */
const aves = [
  { dx: 0, dy: 0, e: 1, i: 0 },
  { dx: 26, dy: 14, e: 0.8, i: 1 },
  { dx: 48, dy: -8, e: 0.9, i: 2 },
];

const volutas = Array.from({ length: 12 }, (_, i) => ({
  x: 1268 - 58 + azar(i + 201, -11, 11),
  i,
}));
---

<section class="planta" aria-hidden="true" style={`--viaje:${VIAJE}px`}>
  <svg viewBox="0 0 1600 460" preserveAspectRatio="xMidYMax slice" role="presentation">
    <defs>
      {/* EL CIELO NO ES OPACO.
          Antes esto era un rectángulo macizo que tapaba todo lo que la página
          tiene atrás: la grilla del fondo y las moléculas del canvas. Por eso
          la escena se leía como una imagen pegada al final y no como parte
          del sitio.
          Ahora arranca en transparente puro y sólo se va tiñendo hacia el
          suelo, que es lo que hace la bruma de verdad. El gas y los datos que
          vienen bajando por toda la página siguen viéndose acá adentro. */}
      <linearGradient id="cielo" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#1d2624" stop-opacity="0" />
        <stop offset="0.5" stop-color="#1b2422" stop-opacity="0.3" />
        <stop offset="1" stop-color="#1d2624" stop-opacity="0.72" />
      </linearGradient>
      <radialGradient id="luna">
        <stop offset="0" stop-color="#dfdcd4" stop-opacity="0.28" />
        <stop offset="0.45" stop-color="#dfdcd4" stop-opacity="0.08" />
        <stop offset="1" stop-color="#dfdcd4" stop-opacity="0" />
      </radialGradient>
      {/* El acero, en las dos orientaciones: el brillo cae al 38 %, no al
          medio, que es donde pega la luz en un cilindro. */}
      <linearGradient id="acero-v" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#15191a" />
        <stop offset="0.2" stop-color="#39413f" />
        <stop offset="0.38" stop-color="#8b9699" />
        <stop offset="0.62" stop-color="#525c56" />
        <stop offset="1" stop-color="#101314" />
      </linearGradient>
      <linearGradient id="acero-h" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#15191a" />
        <stop offset="0.2" stop-color="#39413f" />
        <stop offset="0.38" stop-color="#8b9699" />
        <stop offset="0.62" stop-color="#525c56" />
        <stop offset="1" stop-color="#101314" />
      </linearGradient>
      {/* LA VOLUTA, con degradado radial y SIN filtro.
          Antes el desenfoque iba como `filter` sobre el grupo entero, y ahí
          estaba el error: la región del filtro se calcula sobre el bounding
          box SIN transformar, así que las volutas —que las mueve una
          animación CSS— se rasterizaban corridas y el gas aparecía lejos de
          la chimenea, flotando en cualquier lado del cielo.
          Un radial ya trae el borde suave adentro: sale igual de difuso, se
          mueve donde tiene que moverse y no cuesta un filtro por frame. */}
      {/* Un relleno plano con opacidad NO es un resplandor: se ve como un
          disco marrón pegado encima. Lo que lo vuelve luz es que se apague
          hacia el borde, y eso lo hace un radial. Va para el halo de la
          antorcha, el brillo del suelo y las nubes. */}
      <radialGradient id="halo">
        <stop offset="0" stop-color="#c08552" stop-opacity="0.4" />
        <stop offset="0.4" stop-color="#c08552" stop-opacity="0.13" />
        <stop offset="1" stop-color="#c08552" stop-opacity="0" />
      </radialGradient>
      <radialGradient id="brillo-suelo">
        <stop offset="0" stop-color="#c08552" stop-opacity="0.22" />
        <stop offset="0.55" stop-color="#c08552" stop-opacity="0.07" />
        <stop offset="1" stop-color="#c08552" stop-opacity="0" />
      </radialGradient>
      <radialGradient id="nube">
        <stop offset="0" stop-color="#dfdcd4" stop-opacity="0.075" />
        <stop offset="0.6" stop-color="#dfdcd4" stop-opacity="0.03" />
        <stop offset="1" stop-color="#dfdcd4" stop-opacity="0" />
      </radialGradient>
      <radialGradient id="voluta">
        <stop offset="0" stop-color="#d4dae0" stop-opacity="0.5" />
        <stop offset="0.45" stop-color="#d4dae0" stop-opacity="0.2" />
        <stop offset="1" stop-color="#d4dae0" stop-opacity="0" />
      </radialGradient>
    </defs>

    <rect width="1600" height="460" fill="url(#cielo)" />

    <circle cx="286" cy="122" r="146" fill="url(#luna)" />
    <circle cx="286" cy="122" r="40" fill="#dfdcd4" opacity="0.8" />
    <circle cx="270" cy="110" r="6.5" fill="#0f1110" opacity="0.1" />
    <circle cx="300" cy="136" r="4" fill="#0f1110" opacity="0.08" />

    <g class="estrellas">
      {estrellas.map((e) => (
        <circle cx={e.x} cy={e.y} r={e.r} fill="#dfdcd4" opacity={e.o} style={`--i:${e.i}`} />
      ))}
    </g>

    {/* Nubes altas: le dan cielo al cielo. */}
    <g class="nubes">
      {nubes.map((n) => (
        <g style={`--i:${n.i}; --e:${n.e}`}>
          <ellipse cx="0" cy={n.y} rx="132" ry="26" fill="url(#nube)" />
          <ellipse cx="78" cy={n.y - 10} rx="92" ry="20" fill="url(#nube)" />
          <ellipse cx="-72" cy={n.y + 6} rx="74" ry="17" fill="url(#nube)" />
        </g>
      ))}
    </g>

    {/* La estrella fugaz: pasa cada tanto y nada más. Si pasara seguido
        dejaría de ser un hallazgo y sería un tic. */}
    <g class="fugaz">
      <path d="M0 0 L58 26" stroke="#dfdcd4" stroke-width="2" stroke-linecap="round" opacity="0.85" />
      <circle cx="58" cy="26" r="2.4" fill="#dfdcd4" />
    </g>

    {/* Los pájaros, en bandada floja. */}
    <g class="aves">
      {aves.map((a) => (
        <path
          d={`M${a.dx - 9} ${a.dy} q 9 -7 9 0 q 0 -7 9 0`}
          fill="none"
          stroke="#dfdcd4"
          stroke-width="1.6"
          stroke-linecap="round"
          opacity="0.42"
          style={`--i:${a.i}; --e:${a.e}`}
        />
      ))}
    </g>

    {/* Las sierras */}
    <path
      d="M0 348 L150 300 L290 336 L440 292 L600 340 L760 300 L920 344 L1080 302 L1240 340 L1400 300 L1600 342 L1600 460 L0 460 Z"
      fill="#1a211f"
    />
    <path
      d="M0 372 L180 344 L340 370 L520 340 L700 372 L880 344 L1060 374 L1260 342 L1440 372 L1600 350 L1600 460 L0 460 Z"
      fill="#141a19"
    />

    {/* ── LA PRP: donde el gasoducto baja la presión ────────────────── */}
    {/* El skid va DEBAJO de la línea a propósito. La primera versión lo tenía
        a la altura del caño y las moléculas que viajan le pasaban justo por
        encima: la reductora quedaba tapada y se leía como un amontonamiento.
        Abajo, con dos bajadas que entran desde el caño y el venteo saliendo
        para arriba, se entiende de una qué hace. */}
    <g class="prp" fill="#0b0e0d" stroke="#3f4a45" stroke-width="1.4">
      {/* La platea */}
      <rect x={PRP_X0} y="390" width={PRP_X1 - PRP_X0} height="10" />

      {/* Las dos bajadas: del caño al tren de regulación */}
      <rect x={PRP_X0 + 26} y={CODO_Y + 12} width="8" height="44" />
      <rect x={PRP_X0 + 74} y={CODO_Y + 12} width="8" height="44" />

      {/* Los filtros, que es lo que hace reconocible a una reductora */}
      <rect x={PRP_X0 + 18} y="356" width="24" height="36" rx="11" />
      <rect x={PRP_X0 + 66} y="356" width="24" height="36" rx="11" />

      {/* El venteo, que sale para arriba y cruza la línea */}
      <rect x={PRP_X0 + 108} y="256" width="10" height="136" />
      <rect x={PRP_X0 + 103} y="250" width="20" height="8" rx="2" />

      {/* La casilla de control */}
      <rect x={PRP_X0 + 130} y="360" width="30" height="32" />
      <rect
        class="luz-prp"
        x={PRP_X0 + 137}
        y="366"
        width="10"
        height="9"
        fill="#c08552"
        stroke="none"
        opacity="0.85"
      />

      {/* El cerco perimetral, bajito */}
      {Array.from({ length: 7 }, (_, i) => (
        <path d={`M${PRP_X0 + 8 + i * 25} 390 L${PRP_X0 + 8 + i * 25} 368`} stroke-width="1.4" opacity="0.7" />
      ))}
      <path d={`M${PRP_X0 + 6} 374 L${PRP_X1 - 6} 374`} stroke-width="1.2" opacity="0.55" />
    </g>

    {/* Los dos volantes de la reductora, sobre el caño */}
    <g class="volantes" fill="none" stroke="#98a3a5" stroke-width="2.2">
      {[PRP_X0 + 30, PRP_X0 + 78].map((x) => (
        <g>
          <path d={`M${x} ${CODO_Y + 14} L${x} ${CODO_Y - 5}`} />
          <circle cx={x} cy={CODO_Y - 10} r="5.5" />
        </g>
      ))}
    </g>

    {/* ── LA PLANTA, una sola ────────────────────────────────────────── */}
    <g class="fabrica">
      {/* Nave con techo de diente de sierra */}
      <rect x={IND_X0} y="288" width={IND_X1 - IND_X0} height="112" fill="#0b0e0d" stroke="#3f4a45" stroke-width="1.5" />
      {[0, 1, 2, 3].map((i) => (
        <g>
          <path
            d={`M${IND_X0 + i * ((1268 - 1060) / 4)} 288 L${IND_X0 + i * ((1268 - 1060) / 4)} 252 L${IND_X0 + (i + 1) * ((1268 - 1060) / 4)} 288 Z`}
            fill="#0b0e0d"
            stroke="#3f4a45"
            stroke-width="1.5"
          />
          {/* La cara vidriada del diente, que es por donde entra la luz. */}
          <path
            d={`M${IND_X0 + 4 + i * ((1268 - 1060) / 4)} 285 L${IND_X0 + 4 + i * ((1268 - 1060) / 4)} 258`}
            stroke="#6fa39c"
            stroke-width="3"
            opacity="0.5"
          />
        </g>
      ))}

      {/* El resplandor de la planta sobre el suelo: es lo que la apoya en el
          piso en vez de dejarla flotando recortada. */}
      <ellipse cx={(IND_X0 + IND_X1) / 2} cy="398" rx="250" ry="44" fill="url(#brillo-suelo)" />

      {/* La antorcha: el mechero que nunca se apaga. */}
      <rect x={IND_X0 + 22} y="196" width="13" height="94" fill="#0b0e0d" stroke="#3f4a45" stroke-width="1.4" />
      <path d={`M${IND_X0 + 16} 196 L${IND_X0 + 41} 196 L${IND_X0 + 37} 186 L${IND_X0 + 20} 186 Z`} fill="#0b0e0d" stroke="#3f4a45" stroke-width="1.4" />

      {/* La chimenea */}
      <rect x={IND_X1 - 78} y="150" width="34" height="140" fill="#0b0e0d" stroke="#3f4a45" stroke-width="1.5" />
      <rect x={IND_X1 - 84} y="144" width="46" height="10" rx="2" fill="#0b0e0d" stroke="#3f4a45" stroke-width="1.5" />
      <path d={`M${IND_X1 - 78} 186 L${IND_X1 - 44} 186 M${IND_X1 - 78} 224 L${IND_X1 - 44} 224`} stroke="#3f4a45" stroke-width="1.2" opacity="0.6" />

      {/* La llama, y su halo sobre el cielo. */}
      <circle class="halo-llama" cx={IND_X0 + 28} cy="166" r="82" fill="url(#halo)" />
      <g class="llama">
        <path d={`M${IND_X0 + 28} 186 C${IND_X0 + 19} 168 ${IND_X0 + 35} 158 ${IND_X0 + 29} 140 C${IND_X0 + 45} 154 ${IND_X0 + 49} 172 ${IND_X0 + 40} 186 Z`} fill="#c08552" opacity="0.92" />
        <path d={`M${IND_X0 + 29} 184 C${IND_X0 + 25} 172 ${IND_X0 + 33} 166 ${IND_X0 + 30} 154 C${IND_X0 + 38} 165 ${IND_X0 + 39} 176 ${IND_X0 + 35} 184 Z`} fill="#dfdcd4" opacity="0.5" />
      </g>

      {/* La baliza de la chimenea: obligatoria en una torre, y le da pulso. */}
      <circle class="baliza" cx={IND_X1 - 61} cy="138" r="4.5" fill="#e8604a" />

      {/* Las ventanas encendidas */}
      <g class="luces">
        {Array.from({ length: 6 }, (_, i) => [IND_X0 + 20 + i * 30, 324]).map(([x, y], i) => (
          <rect x={x} y={y} width="11" height="14" rx="1" fill="#c08552" opacity="0.8" style={`--i:${i}`} />
        ))}
      </g>
    </g>

    {/* ── EL CAÑO: baja, dobla y entra ───────────────────────────────── */}
    <g class="canio">
      {/* Tramo vertical. Baja HASTA PASAR la esquina: el vertical y el
          horizontal se solapan en el cuadrado del codo, así queda macizo.
          El arco que tenía antes dejaba un escalón visible entre los dos. */}
      <rect x={EJE_X - 8} y="0" width="16" height={CODO_Y + 22} fill="url(#acero-v)" />
      {/* Tramo horizontal, desde el codo hasta la pared de la planta */}
      <rect x={EJE_X - 8} y={CODO_Y + 7} width={ENTRADA_X - EJE_X + 8} height="16" fill="url(#acero-h)" />

      {/* Las bridas de ENTRADA y SALIDA de la reductora. Son las que hacen
          que el caño se lea como que entra a la PRP y sale de ella, y no como
          uno solo que le pasa por arriba de largo — que era lo que parecía.
          En el medio queda el tramo regulado; después, la distribución que va
          a la industria. */}
      {[PRP_X0, PRP_X1].map((x) => (
        <rect x={x - 5} y={CODO_Y + 1} width="10" height="28" rx="1.5" fill="#98a3a5" />
      ))}
      {/* Y una más en el tramo que sale hacia la industria. */}
      <rect x={(PRP_X1 + IND_X0) / 2 - 4} y={CODO_Y + 3} width="9" height="24" rx="1.5" fill="#98a3a5" />

      {/* Los caballetes que lo sostienen */}
      {[EJE_X + 12, (PRP_X1 + IND_X0) / 2].map((x, i) => {
        return (
          <path
            d={`M${x - 15} 400 L${x} ${CODO_Y + 18} L${x + 15} 400`}
            fill="none"
            stroke="#3f4a45"
            stroke-width="2.5"
          />
        );
      })}
    </g>

    {/* ── LOS NÚMEROS, viajando por el caño hasta la planta ──────────── */}
    <g class="viajeros">
      {viajeros.map((v) => (
        <g style={`--i:${v.i}; --rx:${v.rx}px; --ry:${v.ry}px`}>
          {/* MOLÉCULA, no cajita. El dato que llega por el caño es la misma
              partícula redonda que viene bajando por el fondo de toda la
              página: si acá fuera un rectángulo, el viaje se cortaría justo
              en el remate. */}
          <circle cx={EJE_X} cy={CODO_Y + 8} r="17" fill="#0f1110" stroke="#6fa39c" stroke-width="1.5" />
          <circle class="sat" cx={EJE_X + 23} cy={CODO_Y + 8} r="2.3" fill="#6fa39c" opacity="0.75" />
          <circle class="sat sat-b" cx={EJE_X - 23} cy={CODO_Y + 8} r="2.3" fill="#6fa39c" opacity="0.75" />
          <text x={EJE_X} y={CODO_Y + 12}>{v.bit}</text>
        </g>
      ))}
    </g>

    {/* El destello de la pared: cada vez que un dato entra, la planta lo
        acusa. Es el remate de todo el recorrido — el número llega a algún
        lado en vez de desvanecerse. */}
    <circle class="ingreso" cx={ENTRADA_X} cy={CODO_Y + 8} r="15" fill="#6fa39c" />

    {/* ── EL GAS, saliendo de la chimenea ────────────────────────────── */}
    <g class="humo">
      {volutas.map((v) => (
        <ellipse cx={v.x} cy="142" rx="26" ry="30" fill="url(#voluta)" style={`--i:${v.i}`} />
      ))}
    </g>
    {/* Primer plano: una loma oscura al ras. Sin esto la escena es un fondo
        y una planta; con esto hay un adelante y un atrás. */}
    <path
      d="M0 432 L140 418 L300 430 L470 414 L640 428 L820 412 L1000 428 L1180 414 L1360 430 L1520 416 L1600 426 L1600 460 L0 460 Z"
      fill="#0a0d0c"
    />
  </svg>
</section>

<style>
  .planta {
    position: relative;
    display: block;
    width: 100%;
    /* Más baja en pantalla angosta a propósito: con `slice` el recorte
       lateral crece con la altura, y a 250 px la industria quedaba fuera de
       cuadro en un celular. */
    height: clamp(180px, 30vw, 430px);
    overflow: hidden;
    /* SIN MÁSCARA. Estaba puesta para que la escena no arrancara con un
       borde duro, pero desvanecía TODO lo de arriba —el caño incluido— y
       justo en la junta con el caño de la página quedaba un hueco.
       El borde duro no existía igual: el primer tono del cielo del SVG es
       #0f1110, el mismo `--color-fondo` que tiene la página atrás. */
  }
  .planta svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .viajeros text {
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 700;
    text-anchor: middle;
    fill: var(--color-datos);
  }

  /* ── Lo que se mueve ───────────────────────────────────────────────
     Todo sobre `transform` y `opacity`: lo resuelve el compositor. */
  .estrellas circle {
    animation: titilar 7s ease-in-out infinite;
    animation-delay: calc(var(--i) * -0.29s);
  }
  @keyframes titilar {
    0%, 100% { opacity: 0.25; }
    50% { opacity: 0.85; }
  }

  .luces rect {
    animation: parpadeo 5.4s ease-in-out infinite;
    animation-delay: calc(var(--i) * -0.44s);
  }
  @keyframes parpadeo {
    0%, 100% { opacity: 0.85; }
    50% { opacity: 0.4; }
  }

  .humo ellipse {
    /* SIN ESTO EL GAS SE DISPARA POR TODO EL CIELO.
       En SVG, `transform-origin` no arranca en el centro del elemento sino en
       el origen del lienzo. Con eso, un `scale(2.9)` no agranda la voluta en
       el lugar: le multiplica la coordenada — cx 1412 se iba a 4095— y el
       humo terminaba en cualquier lado menos sobre la chimenea.
       `transform-box: fill-box` hace que el origen sea la caja del propio
       elemento, y ahí `center` significa lo que uno espera. */
    transform-box: fill-box;
    transform-origin: center;
    animation: subir 13s linear infinite;
    animation-delay: calc(var(--i) * -1.08s);
  }
  @keyframes subir {
    from { transform: translateY(0) scale(0.4); opacity: 0; }
    14% { opacity: 1; }
    to { transform: translateY(-185px) scale(2.9); opacity: 0; }
  }

  /* El viaje: primero baja por el caño, después dobla y entra a la planta.
     Dos tramos en una sola animación — el quiebre del 40 % es el codo. */
  .viajeros > g {
    animation: viajar 16s linear infinite;
    animation-delay: calc(var(--i) * -3.2s);
  }
  @keyframes viajar {
    0% { transform: translate(0, -340px); opacity: 0; }
    8% { opacity: 1; }
    40% { transform: translate(0, 0); }
    94% { opacity: 1; }
    100% { transform: translate(var(--viaje), 0); opacity: 0; }
  }

  /* Todo lo que escala o rota lleva `transform-box: fill-box`: en SVG el
     origen por defecto es el del lienzo, no el del elemento, y sin esto la
     forma no se agranda en el lugar — se dispara por el cuadro. */
  .llama,
  .halo-llama,
  .baliza,
  .ingreso,
  .humo ellipse {
    transform-box: fill-box;
    transform-origin: center;
  }

  /* Los satélites giran alrededor de su núcleo. El origen se pone a mano en
     el centro del núcleo: `fill-box` acá no sirve, porque la caja del satélite
     es el satélite y giraría sobre sí mismo. */
  .sat {
    transform-origin: 800px 308px;
    animation: orbitar 5.4s linear infinite;
  }
  .sat-b { animation-delay: -2.7s; }
  @keyframes orbitar {
    from { rotate: 0deg; }
    to { rotate: 360deg; }
  }

  .nubes > g {
    animation: cruzar 145s linear infinite;
    animation-delay: calc(var(--i) * -48s);
    transform: scale(var(--e));
  }
  @keyframes cruzar {
    from { transform: translateX(-260px) scale(var(--e)); }
    to { transform: translateX(1860px) scale(var(--e)); }
  }

  .aves path {
    animation: volar 42s linear infinite, aletear 1.3s ease-in-out infinite;
    animation-delay: calc(var(--i) * -0.5s), calc(var(--i) * -0.22s);
  }
  @keyframes volar {
    from { transform: translate(-90px, 210px) scale(var(--e)); }
    to { transform: translate(1700px, 78px) scale(var(--e)); }
  }
  /* El aleteo es un achatado vertical: con dos trazos alcanza. */
  @keyframes aletear {
    0%, 100% { scale: 1 1; }
    50% { scale: 1 0.55; }
  }

  .fugaz {
    transform: translate(180px, 40px);
    opacity: 0;
    animation: fugarse 26s linear infinite;
  }
  @keyframes fugarse {
    0%, 88% { transform: translate(180px, 40px); opacity: 0; }
    89% { opacity: 0.9; }
    97%, 100% { transform: translate(620px, 232px); opacity: 0; }
  }

  .llama {
    animation: arder 2.3s ease-in-out infinite;
  }
  @keyframes arder {
    0%, 100% { transform: scaleY(1) scaleX(1); }
    32% { transform: scaleY(1.24) scaleX(0.88); }
    68% { transform: scaleY(0.86) scaleX(1.1); }
  }
  .halo-llama {
    animation: latir-halo 2.3s ease-in-out infinite;
  }
  @keyframes latir-halo {
    0%, 100% { opacity: 0.75; transform: scale(1); }
    32% { opacity: 1; transform: scale(1.1); }
  }

  .baliza {
    animation: balizar 3.6s ease-in-out infinite;
  }
  @keyframes balizar {
    0%, 62%, 100% { opacity: 0.18; transform: scale(0.85); }
    72% { opacity: 1; transform: scale(1.25); }
  }

  /* El destello de ingreso late al mismo ritmo con el que llegan los datos:
     un ciclo de 16 s dividido por los 5 que viajan. Si los dos números se
     despegan, la planta acusa recibo cuando no llegó nadie. */
  .ingreso {
    animation: acusar 3.2s ease-out infinite;
  }
  @keyframes acusar {
    0% { opacity: 0.55; transform: scale(0.35); }
    70%, 100% { opacity: 0; transform: scale(1.5); }
  }

  /* ── Quieta ────────────────────────────────────────────────────────
     No se apaga: se congela. Cada número queda en el punto del recorrido
     que le toca —unos bajando, otros ya entrando—, así que la escena se ve
     compuesta y no todo amontonado en el arranque. */
  @media (prefers-reduced-motion: reduce) {
    /* Cada regla de acá va colgada de `html:not([data-mov='on'])`: si el
       visitante prendió el movimiento a mano con el botón de la barra, su
       decisión gana sobre la del sistema y nada de esto se aplica. */

    :global(html:not([data-mov='on'])) .estrellas circle,
    :global(html:not([data-mov='on'])) .luces rect,
    :global(html:not([data-mov='on'])) .humo ellipse,
    :global(html:not([data-mov='on'])) .viajeros > g,
    :global(html:not([data-mov='on'])) .sat,
    :global(html:not([data-mov='on'])) .nubes > g,
    :global(html:not([data-mov='on'])) .aves path,
    :global(html:not([data-mov='on'])) .fugaz,
    :global(html:not([data-mov='on'])) .llama,
    :global(html:not([data-mov='on'])) .halo-llama,
    :global(html:not([data-mov='on'])) .baliza,
    :global(html:not([data-mov='on'])) .ingreso {
      animation: none;
    }
    :global(html:not([data-mov='on'])) .humo ellipse {
      transform: translateY(calc(var(--i) * -17px)) scale(calc(0.6 + var(--i) * 0.2));
      opacity: calc(0.9 - var(--i) * 0.08);
    }
    :global(html:not([data-mov='on'])) .viajeros > g {
      transform: translate(var(--rx), var(--ry));
    }
    /* Cada cosa nueva, con su pose de reposo: la escena quieta tiene que
       verse compuesta, no congelada en el cuadro cero. */
    :global(html:not([data-mov='on'])) .nubes > g {
      transform: translateX(calc(240px + var(--i) * 520px)) scale(var(--e));
    }
    :global(html:not([data-mov='on'])) .aves path {
      transform: translate(calc(430px + var(--i) * 44px), calc(150px - var(--i) * 12px))
        scale(var(--e));
    }
    :global(html:not([data-mov='on'])) .fugaz { opacity: 0; }
    :global(html:not([data-mov='on'])) .halo-llama { opacity: 0.88; }
    :global(html:not([data-mov='on'])) .baliza { opacity: 1; }
    :global(html:not([data-mov='on'])) .ingreso { opacity: 0.3; }
  }
</style>
