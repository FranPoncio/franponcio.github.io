---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Nav from './Nav.astro';
import Traza from './Traza.astro';
import Banda from './Banda.astro';
import Herramientas from './Herramientas.astro';
import Formacion from './Formacion.astro';
import { obtenerProyectos } from '../lib/proyectos';
import { usarTraduccion, type Idioma } from '../i18n/ui';

/**
 * El home es LA TRAZA: el recorrido completo de 2013 a hoy, leído de izquierda
 * a derecha sobre un caño horizontal. Los casos no están agrupados por
 * categoría sino puestos en el tiempo, que es como se entiende una carrera.
 *
 * Después de la traza siguen, ya en vertical, el stack y la formación.
 */

interface Props {
  lang: Idioma;
}

const { lang } = Astro.props;
const t = usarTraduccion(lang);

// En la traza mandan las fechas, no el campo `orden`: es una línea de tiempo.
// Se ordena por el primer año que aparece en el período.
const primerAnio = (periodo: string) => Number(periodo.match(/\d{4}/)?.[0] ?? 0);
const proyectos = (await obtenerProyectos(lang))
  .map((r) => r.entrada)
  .sort((a, b) => primerAnio(a.data.periodo) - primerAnio(b.data.periodo));

const cursos = (await getCollection('formacion')).filter((c) => !c.data.oculto);

// Dos trazas separadas, no una con rótulos adentro: el trabajo pago y las
// herramientas que me escribí son dos cosas distintas y tienen que leerse así.
const laboral = proyectos.filter((p) => p.data.tramo === 'laboral');
const propias = proyectos.filter((p) => p.data.tramo === 'proyecto');

const anios = (lista: typeof proyectos) => {
  const todos = lista.flatMap((p) => p.data.periodo.match(/\d{4}/g) ?? []).sort();
  return todos.length ? `${todos[0]} — ${todos.at(-1)}` : '';
};

const cifras = [
  { label: t('hero.gasoductos'), valor: '12.000' },
  { label: t('hero.estaciones'), valor: '150' },
  { label: t('hero.conexiones'), valor: '500' },
  { label: t('hero.anios'), valor: '~10' },
];

const secciones = [
  { id: 'experiencia', titulo: t('tramo.laboral') },
  { id: 'propias', titulo: t('tramo.proyecto') },
  { id: 'herramientas', titulo: t('herramientas.titulo') },
  { id: 'formacion', titulo: t('formacion.titulo') },
];

const titulo =
  lang === 'es'
    ? 'Francisco Poncio · Ingeniería industrial y datos'
    : 'Francisco Poncio · Industrial engineering and data';
---

<Base titulo={titulo} descripcion={t('hero.bajada')} lang={lang} alterna={lang === 'es' ? 'en/' : ''}>
  <Nav lang={lang} alterna={lang === 'es' ? 'en/' : ''} secciones={secciones} />

  {/* La identidad abre el recorrido, centrada sobre el mismo eje que baja
      por el medio de toda la página. */}
  <header class="hero">
    <p class="chip-rubro">{t('hero.rubro')}</p>

    <h1 class="titular-hero">
      <span>Datos</span>
      <span class="en-llama">que se</span>
      <span class="en-hueco">deciden</span>
    </h1>

    <p class="bajada">{t('hero.bajada')}</p>

    <dl class="cifras">
      {
        cifras.map((c) => (
          <div>
            <dd class="contador bloque-cifra tabular-nums">{c.valor}</dd>
            <dt class="font-mono text-[0.52rem] font-bold uppercase tracking-[0.15em] text-tenue">
              {c.label}
            </dt>
          </div>
        ))
      }
    </dl>

    {/* De acá arranca la línea. */}
    <span class="arranque" aria-hidden="true"></span>
  </header>

  <Banda
    id="experiencia"
    indice="01"
    titulo={t('tramo.laboral')}
    anios={anios(laboral)}
    bajada={t('tramo.laboral.bajada')}
  />
  <Traza id="traza-laboral" proyectos={laboral} lang={lang} />

  <Banda
    id="propias"
    indice="02"
    titulo={t('tramo.proyecto')}
    anios={anios(propias)}
    bajada={t('tramo.proyecto.bajada')}
  />
  <Traza id="traza-propias" proyectos={propias} lang={lang} />

  <Banda
    id="herramientas"
    indice="03"
    titulo={t('herramientas.titulo')}
    bajada={t('banda.stack.bajada')}
  />
  <Herramientas lang={lang} />

  <Banda
    id="formacion"
    indice="04"
    titulo={t('formacion.titulo')}
    bajada={t('banda.formacion.bajada')}
  />
  <Formacion cursos={cursos} lang={lang} />

  <style>
    .hero {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      max-width: 1000px;
      margin: 0 auto;
      padding: 3.5rem 1.4rem 0;
    }

    .chip-rubro {
      display: inline-block;
      border: 1px solid var(--color-borde-vivo);
      border-radius: 999px;
      padding: 0.35rem 0.95rem;
      background: color-mix(in srgb, var(--color-panel) 80%, transparent);
      font-family: var(--font-mono);
      font-size: 0.55rem;
      font-weight: 700;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--color-tenue);
    }

    /* Syne pide tamaño y aire. Va en caja mixta —no en MAYÚSCULA como iba
       Anton— porque tiene pesos de verdad y en caja baja se lee mejor. */
    .titular-hero {
      margin-top: 1.6rem;
      font-size: clamp(3.4rem, 13vw, 9rem);
      font-weight: 800;
      line-height: 0.86;
      letter-spacing: -0.05em;
    }
    .titular-hero span { display: block; }
    .en-llama { color: var(--color-acento); }
    /* Contorno vacío: el gesto que hace que el titular no sea un bloque macizo. */
    .en-hueco {
      color: transparent;
      -webkit-text-stroke: 2px var(--color-texto);
    }

    .bajada {
      margin-top: 1.8rem;
      max-width: 48ch;
      font-size: 0.98rem;
      line-height: 1.65;
      color: var(--color-tenue);
      text-wrap: pretty;
    }

    .cifras {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 1.6rem 3.2rem;
      margin-top: 3rem;
    }
    .cifras > div {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.4rem;
    }
    .bloque-cifra {
      font-family: var(--font-titulo);
      font-weight: 800;
      font-size: 2.5rem;
      line-height: 1;
      letter-spacing: -0.045em;
      color: var(--color-texto);
    }

    /* El nacimiento del eje: de acá para abajo la línea no se corta más. */
    /* De acá nace el caño: aparece de la nada y ya viene tendido. */
    .arranque {
      width: 14px;
      height: 7rem;
      margin-top: 3.2rem;
      border-radius: 3px;
      background: var(--acero);
      -webkit-mask-image: linear-gradient(to bottom, transparent, #000 80%);
      mask-image: linear-gradient(to bottom, transparent, #000 80%);
    }

    @media (max-width: 700px) {
      .hero { padding-top: 2rem; }
      .bajada { margin-top: 1.3rem; font-size: 0.9rem; }
      .cifras { margin-top: 2.2rem; gap: 1.2rem 2.2rem; }
      .bloque-cifra { font-size: 1.9rem; }
      .arranque { height: 4rem; margin-top: 2.2rem; }
    }
  </style>
</Base>
