---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Nav from './Nav.astro';
import ProyectoCard from './ProyectoCard.astro';
import Formacion from './Formacion.astro';
import Linea from './Linea.astro';
import Carrusel from './Carrusel.astro';
import Estacion from './Estacion.astro';
import { conBase } from '../lib/url';
import { obtenerProyectos } from '../lib/proyectos';
import { usarTraduccion, type Idioma } from '../i18n/ui';

interface Props {
  lang: Idioma;
}

const { lang } = Astro.props;
const t = usarTraduccion(lang);

const resueltos = await obtenerProyectos(lang);
const cursos = (await getCollection('formacion')).filter((c) => !c.data.oculto);
const rutaCaso = lang === 'es' ? 'proyectos' : 'en/projects';

// El primero de la lista se muestra en grande: es la puerta de entrada y
// merece más aire que el resto.
const [destacado, ...resto] = resueltos;

const grupos = (
  [
    { id: 'datos', titulo: t('grupo.datos'), bajada: t('grupo.datos.bajada') },
    { id: 'gestion', titulo: t('grupo.gestion'), bajada: t('grupo.gestion.bajada') },
    { id: 'herramienta', titulo: t('grupo.herramienta'), bajada: t('grupo.herramienta.bajada') },
  ] as const
).map((g, i) => ({
  ...g,
  indice: String(i + 1).padStart(2, '0'),
  items: resto.filter((p) => p.entrada.data.categoria === g.id),
}));

const secciones = [
  ...grupos.filter((g) => g.items.length > 0).map((g) => ({ id: g.id, titulo: g.titulo })),
  { id: 'formacion', titulo: t('formacion.titulo') },
];

const cifras = [
  { label: t('hero.gasoductos'), valor: '12.000 km' },
  { label: t('hero.estaciones'), valor: '150' },
  { label: t('hero.conexiones'), valor: '500' },
  { label: t('hero.anios'), valor: '~10' },
];

const titulo =
  lang === 'es'
    ? 'Francisco Poncio · Ingeniería industrial y datos'
    : 'Francisco Poncio · Industrial engineering and data';
---

<Base titulo={titulo} descripcion={t('hero.bajada')} lang={lang} alterna={lang === 'es' ? 'en/' : ''}>
  <Nav lang={lang} alterna={lang === 'es' ? 'en/' : ''} secciones={secciones} />

  {/* La línea recorre TODA la página, del hero al último proyecto. */}
  <div class="relative">
    <Linea />

  <header class="halo relative overflow-hidden border-b border-borde">
    <div class="relative mx-auto max-w-5xl px-6 py-20 sm:py-28">
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-acento">{t('hero.rubro')}</p>
      <h1
        class="mt-5 text-[2rem] font-bold leading-[1.08] sm:text-[3.1rem] lg:text-[3.9rem]"
      >
        Francisco<br class="hidden sm:block" /> Poncio
      </h1>
      <p class="mt-7 max-w-2xl text-lg leading-relaxed text-tenue sm:text-xl">
        {t('hero.bajada')}
      </p>

      <dl class="mt-12 grid grid-cols-2 gap-x-8 gap-y-6 font-mono sm:flex sm:flex-wrap sm:gap-x-12">
        {
          cifras.map((c) => (
            <div>
              <dt class="text-[0.65rem] uppercase tracking-[0.14em] text-tenue">{c.label}</dt>
              <dd class="contador mt-1 text-xl font-semibold sm:text-2xl">{c.valor}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </header>


  <main class="relative mx-auto max-w-5xl px-6">
    {
      destacado && (
        <section class="revelar relative mt-20">
          <Estacion marca="00" lectura={t('proyecto.destacado')} />
          <a
            href={conBase(`${rutaCaso}/${destacado.entrada.id}/`)}
            class="tarjeta group grid overflow-hidden rounded-xl border border-borde bg-panel hover:bg-panel-alto hover:shadow-[0_0_0_1px_var(--color-datos)] lg:grid-cols-5"
          >
            <div class="lg:col-span-2">
              {destacado.entrada.data.portada ? (
                <Image
                  src={destacado.entrada.data.portada.src}
                  alt={destacado.entrada.data.portada.alt}
                  widths={[400, 800]}
                  sizes="(min-width: 1024px) 40vw, 100vw"
                  class="h-48 w-full object-cover lg:h-full"
                  loading="eager"
                />
              ) : (
                <div class="sin-portada h-48 w-full lg:h-full" />
              )}
            </div>

            <div class="flex flex-col p-7 lg:col-span-3 lg:p-9">
              <p class="flex items-center gap-2.5">
                <span class="size-1.5 rounded-full bg-datos" />
                <span class="font-mono text-[0.65rem] uppercase tracking-[0.14em] text-datos">
                  {t('proyecto.destacado')}
                </span>
              </p>

              <h2 class="mt-4 text-xl font-semibold leading-snug sm:text-2xl">
                {destacado.entrada.data.titulo}
                {destacado.entrada.data.borrador && (
                  <span class="ml-2 align-middle rounded bg-acento/15 px-1.5 py-0.5 font-mono text-[0.6rem] uppercase tracking-wider text-acento">
                    {t('proyecto.borrador')}
                  </span>
                )}
              </h2>
              <p class="mt-3 leading-relaxed text-tenue">{destacado.entrada.data.resumen}</p>

              {destacado.entrada.data.kpis.length > 0 && (
                <dl class="mt-7 flex flex-wrap gap-x-8 gap-y-4 font-mono">
                  {destacado.entrada.data.kpis.slice(0, 3).map((k) => (
                    <div>
                      <dt class="text-[0.65rem] uppercase tracking-[0.12em] text-tenue">
                        {k.label}
                      </dt>
                      <dd class="mt-0.5 text-lg font-semibold tabular-nums">{k.valor}</dd>
                    </div>
                  ))}
                </dl>
              )}

              <span class="mt-auto pt-7 font-mono text-xs text-datos">{t('proyecto.ver')}</span>
            </div>
          </a>
        </section>
      )
    }

    {
      grupos.map(
        (grupo) =>
          grupo.items.length > 0 && (
            <section class="revelar relative mt-24 scroll-mt-24" id={grupo.id}>
              <Estacion marca={String(grupo.items.length).padStart(2, '0')} lectura={grupo.titulo} />
              {/* El número ya lo muestra la estación sobre la línea; repetirlo
                  acá dejaba dos 01 seguidos. */}
              <h2 class="text-lg font-semibold sm:text-xl">{grupo.titulo}</h2>
              <p class="mt-1.5 text-sm text-tenue">{grupo.bajada}</p>

              <div class="escalona mt-8">
                <Carrusel
                  etiqueta={grupo.titulo}
                  anterior={t('carrusel.anterior')}
                  siguiente={t('carrusel.siguiente')}
                >
                  {grupo.items.map((p) => (
                    <ProyectoCard proyecto={p.entrada} lang={lang} />
                  ))}
                </Carrusel>
              </div>
            </section>
          ),
      )
    }
  </main>

  <div class="mt-24">
    <Formacion cursos={cursos} indice={String(grupos.filter((g) => g.items.length > 0).length + 1).padStart(2, '0')} lang={lang} />
  </div>
  </div>
</Base>
