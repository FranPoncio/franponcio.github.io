---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Nav from './Nav.astro';
import Traza from './Traza.astro';
import Banda from './Banda.astro';
import Herramientas from './Herramientas.astro';
import Formacion from './Formacion.astro';
import { obtenerProyectos } from '../lib/proyectos';
import { usarTraduccion, type Idioma } from '../i18n/ui';

/**
 * El home es LA TRAZA: el recorrido completo de 2013 a hoy, leído de izquierda
 * a derecha sobre un caño horizontal. Los casos no están agrupados por
 * categoría sino puestos en el tiempo, que es como se entiende una carrera.
 *
 * Después de la traza siguen, ya en vertical, el stack y la formación.
 */

interface Props {
  lang: Idioma;
}

const { lang } = Astro.props;
const t = usarTraduccion(lang);

// En la traza mandan las fechas, no el campo `orden`: es una línea de tiempo.
// Se ordena por el primer año que aparece en el período.
const primerAnio = (periodo: string) => Number(periodo.match(/\d{4}/)?.[0] ?? 0);
const proyectos = (await obtenerProyectos(lang))
  .map((r) => r.entrada)
  .sort((a, b) => primerAnio(a.data.periodo) - primerAnio(b.data.periodo));

const cursos = (await getCollection('formacion')).filter((c) => !c.data.oculto);

const cifras = [
  { label: t('hero.gasoductos'), valor: '12.000' },
  { label: t('hero.estaciones'), valor: '150' },
  { label: t('hero.conexiones'), valor: '500' },
  { label: t('hero.anios'), valor: '~10' },
];

const secciones = [
  { id: 'traza', titulo: t('nav.traza') },
  { id: 'herramientas', titulo: t('herramientas.titulo') },
  { id: 'formacion', titulo: t('formacion.titulo') },
];

const titulo =
  lang === 'es'
    ? 'Francisco Poncio · Ingeniería industrial y datos'
    : 'Francisco Poncio · Industrial engineering and data';
---

<Base titulo={titulo} descripcion={t('hero.bajada')} lang={lang} alterna={lang === 'es' ? 'en/' : ''}>
  <Nav lang={lang} alterna={lang === 'es' ? 'en/' : ''} secciones={secciones} />

  {/* La identidad va arriba de la traza y ocupa poco: lo que hay que mirar es
      el recorrido, no una portada. */}
  <header class="mx-auto flex max-w-[1400px] flex-wrap items-start justify-between gap-x-12 gap-y-7 px-8 pb-8 pt-10">
    <div>
      <p class="font-mono text-[0.6rem] font-medium uppercase tracking-[0.2em] text-acento">
        {t('hero.rubro')}
      </p>
      <h1 class="mt-2.5 text-[1.35rem] font-bold sm:text-[1.6rem]">Francisco Poncio</h1>
      <p class="mt-3 max-w-[38ch] text-[0.86rem] leading-relaxed text-tenue">{t('hero.bajada')}</p>
    </div>

    <dl class="flex flex-wrap gap-x-9 gap-y-4">
      {
        cifras.map((c) => (
          <div class="text-right">
            <dt class="font-mono text-[0.55rem] uppercase tracking-[0.15em] text-tenue">
              {c.label}
            </dt>
            <dd class="contador mt-1 font-mono text-lg font-bold tracking-[-0.08em] tabular-nums">
              {c.valor}
            </dd>
          </div>
        ))
      }
    </dl>
  </header>

  <Banda
    id="traza"
    indice="01"
    titulo={t('banda.traza')}
    bajada={t('banda.traza.bajada')}
  />

  <Traza proyectos={proyectos} lang={lang} />

  <p class="mx-auto max-w-[1400px] px-8 pb-10 font-mono text-[0.58rem] uppercase tracking-[0.16em] text-tenue">
    {t('traza.pie')}
  </p>

  <Banda
    id="herramientas"
    indice="02"
    titulo={t('herramientas.titulo')}
    bajada={t('banda.stack.bajada')}
  />
  <Herramientas lang={lang} />

  <Banda
    id="formacion"
    indice="03"
    titulo={t('formacion.titulo')}
    bajada={t('banda.formacion.bajada')}
  />
  <Formacion cursos={cursos} lang={lang} />
</Base>
