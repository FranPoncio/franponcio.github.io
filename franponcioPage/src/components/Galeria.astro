---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  imagenes: { src: ImageMetadata; alt: string; pie?: string }[];
}

const { imagenes } = Astro.props;
---

{
  imagenes.length > 0 && (
    <section class="mt-16">
      <h2 class="border-t border-borde pt-6 text-xl font-semibold tracking-tight">Registro</h2>

      <div class="mt-6 grid gap-5 sm:grid-cols-2">
        {imagenes.map((img) => (
          <figure class="overflow-hidden rounded-lg border border-borde bg-panel">
            {/* widths + sizes: Astro genera varios tamaños y el navegador baja
                el que corresponde. Una foto de obra de 4 MB no se sirve tal cual. */}
            <Image
              src={img.src}
              alt={img.alt}
              widths={[400, 800, 1200]}
              sizes="(min-width: 640px) 45vw, 90vw"
              class="w-full"
              loading="lazy"
            />
            {img.pie && (
              <figcaption class="border-t border-borde px-4 py-2.5 text-xs leading-snug text-tenue">
                {img.pie}
              </figcaption>
            )}
          </figure>
        ))}
      </div>
    </section>
  )
}
