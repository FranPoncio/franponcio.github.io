---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { usarTraduccion, type Idioma } from '../i18n/ui';

interface Props {
  imagenes: { src: ImageMetadata; alt: string; pie?: string }[];
  lang: Idioma;
}

const { imagenes, lang } = Astro.props;
const t = usarTraduccion(lang);
---

{
  imagenes.length > 0 && (
    <section class="mt-16">
      <div class="flex items-baseline justify-between border-t border-borde pt-6">
        <h2 class="text-xl font-semibold tracking-tight">{t('proyecto.registro')}</h2>
        {imagenes.length > 1 && (
          <p class="font-mono text-[0.68rem] text-tenue">{t('proyecto.deslizar')} {imagenes.length} →</p>
        )}
      </div>

      {/*
        Carrusel con scroll-snap: cada figura se "imanta" al borde izquierdo.
        Es scroll nativo — funciona con el dedo, la rueda y el teclado, y no
        cuesta una línea de JavaScript.
      */}
      <div
        class="carrusel -mx-6 mt-6 flex snap-x snap-mandatory gap-4 overflow-x-auto px-6 pb-4"
        tabindex="0"
        role="region"
        aria-label={t('proyecto.registro')}
      >
        {imagenes.map((img) => (
          <figure class="w-[85%] shrink-0 snap-start overflow-hidden rounded-xl border border-borde bg-panel sm:w-[62%]">
            <Image
              src={img.src}
              alt={img.alt}
              widths={[400, 800, 1200]}
              sizes="(min-width: 640px) 62vw, 85vw"
              class="aspect-[3/2] w-full object-cover"
              loading="lazy"
            />
            {img.pie && (
              <figcaption class="border-t border-borde px-4 py-3 text-xs leading-snug text-tenue">
                {img.pie}
              </figcaption>
            )}
          </figure>
        ))}
      </div>
    </section>
  )
}

<style>
  /* Barra de scroll discreta, para que el carrusel no parezca una tabla. */
  .carrusel {
    scrollbar-width: thin;
    scrollbar-color: var(--color-borde-vivo) transparent;
  }
  .carrusel::-webkit-scrollbar {
    height: 6px;
  }
  .carrusel::-webkit-scrollbar-thumb {
    background: var(--color-borde-vivo);
    border-radius: 3px;
  }
  .carrusel:focus-visible {
    outline: 2px solid var(--color-acento);
    outline-offset: 4px;
  }
</style>
