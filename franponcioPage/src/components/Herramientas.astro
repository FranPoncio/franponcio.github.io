---
import { grupos, type Ficha } from '../lib/herramientas';
import { usarTraduccion, type Idioma } from '../i18n/ui';

/**
 * El stack: una cinta por área, cada una con su rótulo.
 *
 * Antes eran dos cintas sin título con 42 fichas corriendo. El problema no era
 * que faltaran herramientas —SAP, pandas y scikit-learn ya estaban— sino que
 * pasaban de largo entre otras cuarenta y nadie las veía. Con el rótulo
 * adelante, cada fila contesta algo: con qué miro datos, con qué programo, con
 * qué ordeno el trabajo.
 *
 * Las fichas ya NO van rellenas de color. Con cincuenta y pico, cincuenta
 * bloques de color macizo eran un carnaval que le ganaba al contenido; ahora el
 * color queda en el rótulo, el borde y el logo, que alcanza para agrupar.
 *
 * Cada fila lleva su contenido en tres copias y su propio carril con scroll:
 * así es infinita la mueva la animación o la muevas vos con el dedo. Las filas
 * alternan sentido para que no se lean como un bloque.
 */

interface Props {
  lang: Idioma;
}

const { lang } = Astro.props;
const t = usarTraduccion(lang);

/**
 * Cuántas veces repetir una fila antes de triplicarla.
 *
 * Si una copia mide menos que la pantalla, el salto de vuelta cae adentro del
 * cuadro y se ve. Contar fichas no alcanza: nueve fichas de "ISO 45001" miden
 * mucho más que nueve de "EVM" o "Lean" —medido, la fila de gestión quedaba en
 * 1.388 px contra 1.440 de ventana— así que se estima el ancho de cada una por
 * el largo del nombre y se repite hasta pasar el ancho de una pantalla grande.
 */
const anchoAprox = (f: Ficha) => 24 + f.nombre.length * 6.4 + (f.path ? 20 : 0);

const repetida = (items: Ficha[]) => {
  const uno = items.reduce((a, f) => a + anchoAprox(f) + 8, 0);
  const veces = Math.max(1, Math.ceil(1900 / Math.max(uno, 1)));
  return Array.from({ length: veces }, () => items).flat();
};
---

<section class="revelar relative">
  <div class="pila" role="group" aria-label={t('herramientas.titulo')}>
    {
      grupos.map((g, fila) => (
        <div class="grupo" style={`--c: var(--color-${g.tono})`}>
          <p class="rotulo">{t(g.clave as Parameters<typeof t>[0])}</p>

          <div class="carril">
            <div class:list={['cinta', fila % 2 === 1 && 'derecha']} style={`--dur:${58 + fila * 9}s`}>
              {[0, 1, 2].map((copia) => (
                <div class="tanda" aria-hidden={copia > 0 ? 'true' : undefined}>
                  {repetida(g.items).map((f) => (
                    <span class="ficha">
                      {f.path && (
                        <svg viewBox="0 0 24 24" role="presentation" aria-hidden="true">
                          <path d={f.path} fill="currentColor" />
                        </svg>
                      )}
                      <span class="nombre">{f.nombre}</span>
                    </span>
                  ))}
                </div>
              ))}
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .pila {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    padding: 2rem 0 2.5rem;
  }

  .rotulo {
    margin: 0 0 0.45rem;
    padding: 0 1.4rem;
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--c);
    text-align: center;
  }

  .carril {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 7%, #000 93%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 7%, #000 93%, transparent);
  }
  .cinta {
    display: flex;
    width: max-content;
    animation: correr var(--dur) linear infinite;
  }
  .derecha {
    animation-direction: reverse;
  }
  .carril:hover .cinta {
    animation-play-state: paused;
  }
  @keyframes correr {
    from { transform: translateX(0); }
    /* Justo una copia de tres. */
    to { transform: translateX(-33.3333%); }
  }

  /* Sin caja, la separación la tiene que dar el aire: si no, los nombres se
     leen como una sola tira de palabras. */
  .tanda {
    display: flex;
    gap: 1.5rem;
    padding-right: 1.5rem;
  }

  /* SIN RECUADRO. Con cincuenta y pico de fichas, cincuenta cajas con borde y
     fondo eran cincuenta rectángulos compitiendo entre sí y con el resto de la
     página. Sin caja, cada fila se lee como lo que es —una lista de nombres— y
     el color del grupo alcanza para agruparlas. */
  .ficha {
    display: flex;
    align-items: center;
    gap: 0.38rem;
    flex: none;
    height: 1.7rem;
    color: var(--color-texto);
  }
  .ficha svg {
    width: 0.88rem;
    height: 0.88rem;
    flex: none;
    color: var(--c);
    opacity: 0.9;
  }
  .nombre {
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.015em;
    white-space: nowrap;
    color: color-mix(in srgb, var(--color-texto) 82%, transparent);
  }

  @media (max-width: 700px) {
    .pila { gap: 1rem; }
    .tanda { gap: 1.1rem; padding-right: 1.1rem; }
    .nombre { font-size: 0.63rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    /* Colgado de `html:not([data-mov='on'])`: si el visitante prendió el
       movimiento a mano, su decisión gana sobre la del sistema. */
    :global(html:not([data-mov='on'])) .cinta {
      animation: none;
    }
    :global(html:not([data-mov='on'])) .carril {
      overflow-x: auto;
      scrollbar-width: none;
      overscroll-behavior-x: contain;
    }
    :global(html:not([data-mov='on'])) .carril::-webkit-scrollbar {
      display: none;
    }
  }
</style>

<script>
  // La vuelta de la cinta cuando NO se anima: cada carril tiene tres copias
  // idénticas, así que saltar de una a la equivalente es invisible. Se arranca
  // sobre la del medio y se salta al acercarse a cualquiera de las puntas.
  const quieto =
    matchMedia('(prefers-reduced-motion: reduce)').matches &&
    document.documentElement.dataset.mov !== 'on';

  if (quieto) {
    for (const carril of document.querySelectorAll<HTMLElement>('.pila .carril')) {
      const cinta = carril.querySelector<HTMLElement>('.cinta');
      if (!cinta) continue;
      const copia = () => cinta.scrollWidth / 3;
      let acomodando = false;
      const centrar = () => {
        carril.scrollLeft = copia();
      };

      carril.addEventListener(
        'scroll',
        () => {
          if (acomodando) return; // el reacomodo dispara otro `scroll`
          const c = copia();
          if (c < 10) return;
          const x = carril.scrollLeft;
          if (x > c * 1.75 || x < c * 0.25) {
            acomodando = true;
            carril.scrollLeft = x > c * 1.75 ? x - c : x + c;
            acomodando = false;
          }
        },
        { passive: true },
      );

      centrar();
      addEventListener('load', centrar);
      addEventListener('resize', centrar, { passive: true });
    }
  }
</script>
