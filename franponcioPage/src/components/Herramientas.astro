---
import { filaDatos, filaGestion, type Ficha } from '../lib/herramientas';
import type { Idioma } from '../i18n/ui';

/**
 * Cinta de herramientas: dos filas que corren en sentidos opuestos.
 *
 * Cada fila lleva su contenido DUPLICADO y se desplaza exactamente un 50 %:
 * cuando termina la primera copia, la segunda está justo donde arrancó la
 * primera, así que el ciclo se reinicia sin salto. Es la única forma de que
 * una cinta infinita no pegue un tirón al volver.
 *
 * Se frena sola al pasar el mouse: si algo te llamó la atención, tenés que
 * poder leerlo.
 */

interface Props {
  lang: Idioma;
}

const { lang } = Astro.props;

const filas: { items: Ficha[]; sentido: string }[] = [
  { items: filaDatos, sentido: 'izquierda' },
  { items: filaGestion, sentido: 'derecha' },
];
---

<section class="revelar relative bg-panel/60">
  <div class="cinta-marco pt-12 pb-14" role="group" aria-label={lang === 'es' ? 'Herramientas y métodos' : 'Tools and methods'}>
    {
      filas.map((fila) => (
        <div class:list={['cinta', fila.sentido]}>
          {/* Dos copias: la segunda es la que hace que el ciclo cierre. */}
          {[0, 1].map((copia) => (
            <div class="tanda" aria-hidden={copia === 1 ? 'true' : undefined}>
              {fila.items.map((f) => (
                <span class="ficha">
                  {f.path ? (
                    <svg viewBox="0 0 24 24" role="presentation" aria-hidden="true">
                      <path d={f.path} fill="currentColor" />
                    </svg>
                  ) : (
                    <span class="sigla">{f.nombre}</span>
                  )}
                  {f.path && <span class="pie">{f.nombre}</span>}
                </span>
              ))}
            </div>
          ))}
        </div>
      ))
    }
  </div>
</section>

<style>
  /* Las puntas se desvanecen: la cinta entra y sale, no empieza ni termina. */
  .cinta-marco {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
  }

  .cinta {
    display: flex;
    width: max-content;
    animation: correr 46s linear infinite;
  }
  .cinta + .cinta {
    margin-top: 0.9rem;
  }
  .derecha {
    animation-direction: reverse;
    animation-duration: 58s;
  }
  .cinta-marco:hover .cinta {
    animation-play-state: paused;
  }

  @keyframes correr {
    from {
      transform: translateX(0);
    }
    to {
      /* Justo una copia: la segunda queda donde arrancó la primera. */
      transform: translateX(-50%);
    }
  }

  .tanda {
    display: flex;
    gap: 0.55rem;
    padding-right: 0.55rem;
  }

  .ficha {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex: none;
    height: 3rem;
    padding: 0 1rem;
    border: 2px solid var(--color-borde-vivo);
    border-radius: 10px;
    background: var(--color-panel);
    color: var(--color-texto);
    box-shadow: 3px 3px 0 color-mix(in srgb, var(--color-acento) 55%, transparent);
    transition: transform 0.18s ease, background-color 0.18s ease;
  }
  /* Las fichas se pintan alternando los colores de la casa: una cinta de un
     solo color seria una lista, no una cinta. */
  .tanda > :nth-child(4n + 1) { background: var(--color-datos); }
  .tanda > :nth-child(4n + 2) { background: var(--color-gestion); }
  .tanda > :nth-child(4n + 3) { background: var(--color-herramienta); color: var(--color-panel); }
  .tanda > :nth-child(4n + 3) svg { color: var(--color-panel); }
  .ficha:hover { transform: translate(-2px, -2px); box-shadow: 5px 5px 0 var(--color-acento); }

  .ficha svg {
    width: 1.25rem;
    height: 1.25rem;
    flex: none;
    color: var(--color-texto);
  }

  .pie,
  .sigla {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: -0.045em;
    white-space: nowrap;
  }
  /* Las que no tienen logo se escriben más marcadas: la ficha no puede
     quedar más flaca sólo porque la marca no exista. */


  /* Sin movimiento la cinta se queda quieta y se puede scrollear con el dedo. */
  @media (prefers-reduced-motion: reduce) {
    .cinta {
      animation: none;
    }
    .cinta-marco {
      overflow-x: auto;
      scrollbar-width: none;
    }
  }
</style>
