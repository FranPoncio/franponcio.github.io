---
import { filaDatos, filaGestion, type Ficha } from '../lib/herramientas';
import type { Idioma } from '../i18n/ui';

/**
 * Cinta de herramientas: dos filas que corren en sentidos opuestos.
 *
 * Cada fila lleva su contenido TRIPLICADO y se desplaza exactamente un
 * tercio: cuando termina la primera copia, la segunda está justo donde
 * arrancó la primera, así que el ciclo se reinicia sin salto.
 *
 * ¿Por qué tres copias y no dos, si para la animación alcanzaba con dos?
 * Por el modo sin movimiento. Con `prefers-reduced-motion` la cinta no puede
 * correr sola, así que se arrastra con el dedo o con el trackpad — y ahí
 * la cinta SE TERMINABA: llegabas al final de la segunda copia y se acababa.
 * O sea que quien tiene esa preferencia prendida nunca tuvo scroll infinito.
 * Con tres copias hay una entera de colchón a cada lado, y un script chico
 * salta de una copia a la equivalente cuando te acercás a la punta. Como las
 * copias son idénticas, el salto es invisible: la cinta no termina nunca,
 * la muevas vos o la mueva la animación.
 *
 * Se frena sola al pasar el mouse: si algo te llamó la atención, tenés que
 * poder leerlo.
 */

interface Props {
  lang: Idioma;
}

const { lang } = Astro.props;

const filas: { items: Ficha[]; sentido: string }[] = [
  { items: filaDatos, sentido: 'izquierda' },
  { items: filaGestion, sentido: 'derecha' },
];
---

<section class="revelar relative bg-panel/60">
  <div class="cinta-marco pt-12 pb-14" role="group" aria-label={lang === 'es' ? 'Herramientas y métodos' : 'Tools and methods'}>
    {
      filas.map((fila) => (
        <div class="carril">
        <div class:list={['cinta', fila.sentido]}>
          {/* Tres copias: la de al medio es la que se ve, las de los costados
              son el colchón para que el salto nunca caiga en pantalla. */}
          {[0, 1, 2].map((copia) => (
            <div class="tanda" aria-hidden={copia === 1 ? 'true' : undefined}>
              {fila.items.map((f, i) => (
                <span class:list={['ficha', `tono-${i % 4}`]}>
                  {f.path ? (
                    <svg viewBox="0 0 24 24" role="presentation" aria-hidden="true">
                      <path d={f.path} fill="currentColor" />
                    </svg>
                  ) : (
                    <span class="sigla">{f.nombre}</span>
                  )}
                  {f.path && <span class="pie">{f.nombre}</span>}
                </span>
              ))}
            </div>
          ))}
        </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  /* Las puntas se desvanecen: la cinta entra y sale, no empieza ni termina. */
  .cinta-marco {
    -webkit-mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
  }

  /* Cada fila tiene SU carril. Antes las dos compartían el contenedor con
     scroll, y como miden distinto no hay un solo punto de vuelta que sirva
     para las dos. */
  .carril {
    overflow: hidden;
  }
  .carril + .carril {
    margin-top: 0.9rem;
  }
  .cinta {
    display: flex;
    width: max-content;
    animation: correr 69s linear infinite;
  }
  .derecha {
    animation-direction: reverse;
    animation-duration: 87s;
  }
  .cinta-marco:hover .cinta {
    animation-play-state: paused;
  }

  @keyframes correr {
    from {
      transform: translateX(0);
    }
    to {
      /* Justo una copia de tres: la segunda queda donde arrancó la primera. */
      transform: translateX(-33.3333%);
    }
  }

  .tanda {
    display: flex;
    gap: 0.55rem;
    padding-right: 0.55rem;
  }

  .ficha {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex: none;
    height: 3rem;
    padding: 0 1rem;
    border: 2px solid var(--color-borde-vivo);
    border-radius: 10px;
    background: var(--color-panel);
    color: var(--color-texto);
    box-shadow: 3px 3px 0 color-mix(in srgb, var(--color-acento) 55%, transparent);
    transition: transform 0.18s ease, background-color 0.18s ease;
  }
  /* El tono va por ficha, no por posición en el DOM: ver la nota del código. */
  .tono-0 { background: var(--color-datos); color: var(--color-fondo); }
  .tono-1 { background: var(--color-gestion); color: var(--color-fondo); }
  .tono-2 { background: var(--color-herramienta); color: var(--color-fondo); }
  .tono-0 svg,
  .tono-1 svg,
  .tono-2 svg { color: var(--color-fondo); }
  .ficha:hover { transform: translate(-2px, -2px); box-shadow: 5px 5px 0 var(--color-acento); }

  .ficha svg {
    width: 1.25rem;
    height: 1.25rem;
    flex: none;
    color: var(--color-texto);
  }

  .pie,
  .sigla {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: -0.045em;
    white-space: nowrap;
  }
  /* Las que no tienen logo se escriben más marcadas: la ficha no puede
     quedar más flaca sólo porque la marca no exista. */


  /* Sin movimiento la cinta se queda quieta y se puede scrollear con el dedo. */
  /* Sin movimiento la cinta se queda quieta y se arrastra a mano. El salto
     de copia lo hace el script de abajo, así que sigue siendo infinita. */
  @media (prefers-reduced-motion: reduce) {
    .cinta {
      animation: none;
    }
    .carril {
      overflow-x: auto;
      scrollbar-width: none;
      overscroll-behavior-x: contain;
    }
    .carril::-webkit-scrollbar {
      display: none;
    }
  }
</style>

<script>
  /**
   * La vuelta de la cinta cuando NO se anima.
   *
   * Con `prefers-reduced-motion` la cinta está quieta y se mueve arrastrando.
   * Cada carril tiene tres copias idénticas del mismo contenido, así que la
   * posición X y la posición X + (un tercio) muestran exactamente lo mismo:
   * saltar de una a la otra es invisible. Se arranca sobre la copia del medio
   * y se salta cuando te acercás a cualquiera de las dos puntas, de manera
   * que siempre queda al menos una copia entera de colchón para seguir.
   */
  const quieto = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (quieto) {
    for (const carril of document.querySelectorAll<HTMLElement>('.carril')) {
      const cinta = carril.querySelector<HTMLElement>('.cinta');
      if (!cinta) continue;

      const copia = () => cinta.scrollWidth / 3;
      let acomodando = false;

      const centrar = () => {
        carril.scrollLeft = copia();
      };

      carril.addEventListener(
        'scroll',
        () => {
          // El propio reacomodo dispara otro `scroll`: sin esta guarda se
          // llama a sí mismo y la cinta se traba.
          if (acomodando) return;
          const c = copia();
          if (c < 10) return;
          const x = carril.scrollLeft;
          // Se salta con un cuarto de copia de margen: nunca sobre la punta,
          // donde el rebote del navegador lo haría visible.
          if (x > c * 1.75) {
            acomodando = true;
            carril.scrollLeft = x - c;
            acomodando = false;
          } else if (x < c * 0.25) {
            acomodando = true;
            carril.scrollLeft = x + c;
            acomodando = false;
          }
        },
        { passive: true },
      );

      centrar();
      // El ancho real recién se sabe con las fuentes cargadas.
      addEventListener('load', centrar);
      addEventListener('resize', centrar, { passive: true });
    }
  }
</script>
