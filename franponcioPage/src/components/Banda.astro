---
/**
 * La banda que abre una sección.
 *
 * Existe para que no haya duda de dónde termina una cosa y empieza otra: los
 * trabajos, las herramientas, los certificados y el stack son cuatro cosas
 * distintas y antes se encadenaban sin corte. La banda corta la página de lado
 * a lado y anuncia qué viene.
 */

interface Props {
  indice: string;
  titulo: string;
  bajada: string;
  /** El rango de años del tramo, si lo tiene. */
  anios?: string;
  /** Ancla para el menú. */
  id?: string;
}

const { indice, titulo, bajada, anios, id } = Astro.props;
---

<div class="banda" id={id}>
  <div class="dentro">
    <span class="num">{indice}</span>
    <div class="texto">
      <h2>
        {titulo}
        {anios && <span class="anios">{anios}</span>}
      </h2>
      <p>{bajada}</p>
    </div>
  </div>
</div>

<style>
  .banda {
    position: relative;
    z-index: 1;
    scroll-margin-top: 4.5rem;
    padding: 0 1.4rem;
  }
  .dentro {
    max-width: 1180px;
    margin: 0 auto;
    padding: 1.3rem 1.6rem;
    display: flex;
    align-items: baseline;
    gap: 1.3rem;
    border: 3px solid var(--color-texto);
    border-radius: 16px;
    background: var(--color-panel);
    box-shadow: var(--sombra);
  }
  .num {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border: 3px solid var(--color-texto);
    border-radius: 999px;
    background: var(--color-acento);
    color: var(--color-panel);
    font-family: var(--font-titulo);
    font-size: 1.15rem;
    line-height: 1;
    align-self: center;
    transform: rotate(-6deg);
  }
  .texto { min-width: 0; }
  h2 {
    margin: 0;
    font-size: 1.6rem;
  }
  .anios {
    margin-left: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--color-tenue);
    vertical-align: middle;
  }
  p {
    margin: 0.3rem 0 0;
    max-width: 62ch;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--color-tenue);
  }

  @media (max-width: 700px) {
    .dentro {
      padding: 1.25rem 1.25rem;
      gap: 0.95rem;
    }
    .num { font-size: 1.2rem; }
    h2 { font-size: 1rem; }
  }
</style>
