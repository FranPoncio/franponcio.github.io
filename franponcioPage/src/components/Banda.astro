---
/**
 * La banda que abre una sección.
 *
 * Existe para que no haya duda de dónde termina una cosa y empieza otra: los
 * trabajos, las herramientas propias, el stack y los certificados son cuatro
 * cosas distintas y antes se encadenaban sin corte.
 *
 * Va CENTRADA y con un tramo de eje arriba y abajo, para que la línea que baja
 * por el medio de la página no se corte entre sección y sección: la banda es
 * una estación más del mismo recorrido, sólo que en vez de un proyecto anuncia
 * un tramo entero.
 */

interface Props {
  indice: string;
  titulo: string;
  bajada: string;
  /** El rango de años del tramo, si lo tiene. */
  anios?: string;
  /** Ancla para el menú. */
  id?: string;
}

const { indice, titulo, bajada, anios, id } = Astro.props;
---

<div class="banda" id={id}>
  <span class="eje" aria-hidden="true"></span>

  <span class="num">{indice}</span>

  <h2>{titulo}</h2>
  {anios && <span class="anios">{anios}</span>}
  <p>{bajada}</p>

  <span class="eje abajo" aria-hidden="true"></span>
</div>

<style>
  .banda {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 3rem 1.2rem 0;
    scroll-margin-top: 4.5rem;
  }

  /* El tramo de eje que entra y el que sale: la línea no se corta nunca. */
  .eje {
    width: 2px;
    height: 4rem;
    background: linear-gradient(to bottom, transparent, var(--color-borde));
    margin-bottom: 1.6rem;
  }
  .eje.abajo {
    height: 2.4rem;
    margin: 1.8rem 0 0;
    background: linear-gradient(to bottom, var(--color-borde), transparent);
  }

  .num {
    display: grid;
    place-items: center;
    width: 3.1rem;
    height: 3.1rem;
    border-radius: 999px;
    background: var(--color-acento);
    color: var(--color-fondo);
    font-family: var(--font-titulo);
    font-weight: 800;
    font-size: 1.15rem;
    letter-spacing: -0.03em;
    line-height: 1;
    box-shadow:
      0 0 0 6px var(--color-fondo),
      0 0 26px 3px color-mix(in srgb, var(--color-acento) 55%, transparent);
  }

  h2 {
    margin: 1.5rem 0 0;
    font-size: clamp(2rem, 6vw, 3.4rem);
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .anios {
    margin-top: 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.05em;
    color: var(--color-acento);
  }
  p {
    margin: 0.9rem 0 0;
    max-width: 46ch;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-tenue);
    text-wrap: pretty;
  }

  @media (max-width: 700px) {
    .banda { padding-top: 3rem; }
    .eje { height: 2.6rem; margin-bottom: 1.2rem; }
    .num { width: 2.6rem; height: 2.6rem; font-size: 1rem; }
    h2 { margin-top: 1.1rem; }
  }
</style>
