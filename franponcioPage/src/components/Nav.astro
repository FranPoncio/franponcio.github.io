---
import { conBase } from '../lib/url';
import { usarTraduccion, type Idioma } from '../i18n/ui';

interface Props {
  lang: Idioma;
  /** La misma página en el otro idioma. */
  alterna: string;
  secciones?: { id: string; titulo: string }[];
}

const { lang, alterna, secciones = [] } = Astro.props;
const t = usarTraduccion(lang);
const inicio = lang === 'es' ? '' : 'en/';
const otro = lang === 'es' ? 'EN' : 'ES';
---

<header
  class="sticky top-0 z-50 border-b border-borde/70 bg-fondo/85 backdrop-blur-md supports-[backdrop-filter]:bg-fondo/65"
>
  <nav class="mx-auto max-w-5xl px-6" aria-label={lang === 'es' ? 'Navegación' : 'Navigation'}>
    {/* Todo en una fila centrada. Antes la marca quedaba pegada a la
        izquierda y el idioma, el contacto y GitHub empujados a la derecha con
        un `ml-auto`, y en el medio quedaba un hueco. */}
    <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 py-3.5">
      <a
        href={conBase(inicio)}
        class="font-mono text-sm font-semibold tracking-tight transition-colors hover:text-acento"
      >
        FP<span class="text-acento">.</span>
      </a>

      {
        secciones.length > 0 && (
          <ul class="hidden gap-6 md:flex">
            {secciones.map((s) => (
              <li>
                <a
                  href={`#${s.id}`}
                  class="link-nav font-mono text-xs text-tenue transition-colors hover:text-texto"
                >
                  {s.titulo}
                </a>
              </li>
            ))}
          </ul>
        )
      }

      <div class="flex items-center gap-3">
        {/* Selector de idioma: es un link a la misma página traducida, no un
            botón con JavaScript. Funciona sin scripts y es indexable. */}
        <a
          href={conBase(alterna)}
          hreflang={lang === 'es' ? 'en' : 'es'}
          class="rounded border border-borde px-2 py-1 font-mono text-[0.68rem] text-tenue transition-colors hover:border-acento hover:text-acento"
          aria-label={lang === 'es' ? 'Ver en inglés' : 'View in Spanish'}
        >
          {otro}
        </a>

        <a
          href="mailto:franponcioo@gmail.com"
          class="hidden font-mono text-xs text-tenue transition-colors hover:text-acento sm:block"
        >
          {t('nav.contacto')}
        </a>
        <a
          href="https://github.com/FranPoncio"
          class="font-mono text-xs text-tenue transition-colors hover:text-acento"
        >
          GitHub ↗
        </a>

        {/* Sólo aparece si el sistema pidió reducir movimiento: para todos los
            demás no hay nada que prender, ya se está moviendo. */}
        <button
          type="button"
          class="mov"
          hidden
          aria-pressed="false"
          title={lang === 'es' ? 'Prender o apagar las animaciones' : 'Turn animation on or off'}
        >
          <span class="mov-icono" aria-hidden="true"></span>
          <span class="mov-txt">{lang === 'es' ? 'movimiento' : 'motion'}</span>
        </button>

        {
          secciones.length > 0 && (
            <details class="menu-movil md:hidden">
              <summary
                class="flex size-8 cursor-pointer list-none items-center justify-center rounded border border-borde text-tenue transition-colors hover:text-texto"
                aria-label={lang === 'es' ? 'Abrir menú' : 'Open menu'}
              >
                <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
                  <path d="M1 3h12M1 7h12M1 11h12" stroke="currentColor" stroke-width="1.5" />
                </svg>
              </summary>
              <ul class="absolute inset-x-0 top-full border-b border-borde bg-fondo px-6 py-4">
                {secciones.map((s) => (
                  <li>
                    <a
                      href={`#${s.id}`}
                      class="block py-2 font-mono text-sm text-tenue transition-colors hover:text-acento"
                    >
                      {s.titulo}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          )
        }
      </div>
    </div>
  </nav>
</header>

<style>
  .menu-movil summary::-webkit-details-marker {
    display: none;
  }

  .mov {
    display: none;
    align-items: center;
    gap: 0.35rem;
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--color-borde);
    border-radius: 999px;
    background: none;
    color: var(--color-tenue);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  /* Se muestra sólo cuando hay algo que prender. */
  @media (prefers-reduced-motion: reduce) {
    .mov { display: inline-flex; }
  }
  .mov:hover { color: var(--color-texto); border-color: var(--color-borde-vivo); }
  .mov-icono {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-borde-vivo);
    transition: background-color 0.2s ease, box-shadow 0.2s ease;
  }
  .mov[aria-pressed='true'] { color: var(--color-texto); border-color: var(--color-acento); }
  .mov[aria-pressed='true'] .mov-icono {
    background: var(--color-acento);
    box-shadow: 0 0 8px 1px color-mix(in srgb, var(--color-acento) 70%, transparent);
  }
</style>

<script>
  // El botón existe en el HTML pero arranca oculto: si el navegador no pidió
  // reducir movimiento no hay nada que prender, y un control que no hace nada
  // es peor que ningún control.
  const boton = document.querySelector<HTMLButtonElement>('.mov');
  if (boton && matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const puesto = () => document.documentElement.dataset.mov === 'on';
    const pintar = () => boton.setAttribute('aria-pressed', String(puesto()));

    boton.hidden = false;
    pintar();

    boton.addEventListener('click', () => {
      const nuevo = !puesto();
      if (nuevo) document.documentElement.dataset.mov = 'on';
      else delete document.documentElement.dataset.mov;
      try {
        localStorage.setItem('mov', nuevo ? 'on' : 'off');
      } catch (e) {
        /* sin memoria: vale para esta visita nomás */
      }
      pintar();
      // Los fondos de canvas deciden al arrancar si se animan o no, así que
      // para que el cambio se vea entero hay que volver a cargar.
      location.reload();
    });
  }
</script>
