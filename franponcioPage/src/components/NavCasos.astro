---
import { conBase } from '../lib/url';
import { usarTraduccion, type Idioma } from '../i18n/ui';
import type { Proyecto } from '../lib/proyectos';

interface Props {
  anterior?: Proyecto;
  siguiente?: Proyecto;
  lang: Idioma;
}

const { anterior, siguiente, lang } = Astro.props;
const t = usarTraduccion(lang);
const base = lang === 'es' ? 'proyectos' : 'en/projects';
---

{
  (anterior || siguiente) && (
    <nav class="mt-20 grid gap-4 border-t border-borde pt-8 sm:grid-cols-2">
      {anterior ? (
        <a
          href={conBase(`${base}/${anterior.id}/`)}
          class="tarjeta rounded-xl border border-borde bg-panel p-5 hover:bg-panel-alto"
        >
          <p class="font-mono text-[0.65rem] uppercase tracking-[0.14em] text-tenue">{t('proyecto.anterior')}</p>
          <p class="mt-2 font-medium leading-snug">{anterior.data.titulo}</p>
        </a>
      ) : (
        <div />
      )}

      {siguiente && (
        <a
          href={conBase(`${base}/${siguiente.id}/`)}
          class="tarjeta rounded-xl border border-borde bg-panel p-5 text-right hover:bg-panel-alto"
        >
          <p class="font-mono text-[0.65rem] uppercase tracking-[0.14em] text-tenue">{t('proyecto.siguiente')}</p>
          <p class="mt-2 font-medium leading-snug">{siguiente.data.titulo}</p>
        </a>
      )}
    </nav>
  )
}
