---
import type { CollectionEntry } from 'astro:content';
import { conBase } from '../lib/url';

interface Props {
  anterior?: CollectionEntry<'proyectos'>;
  siguiente?: CollectionEntry<'proyectos'>;
}

const { anterior, siguiente } = Astro.props;
---

{
  (anterior || siguiente) && (
    <nav class="mt-20 grid gap-4 border-t border-borde pt-8 sm:grid-cols-2">
      {anterior ? (
        <a
          href={conBase(`proyectos/${anterior.id}/`)}
          class="tarjeta rounded-xl border border-borde bg-panel p-5 hover:bg-panel-alto"
        >
          <p class="font-mono text-[0.65rem] uppercase tracking-[0.14em] text-tenue">← Anterior</p>
          <p class="mt-2 font-medium leading-snug">{anterior.data.titulo}</p>
        </a>
      ) : (
        <div />
      )}

      {siguiente && (
        <a
          href={conBase(`proyectos/${siguiente.id}/`)}
          class="tarjeta rounded-xl border border-borde bg-panel p-5 text-right hover:bg-panel-alto"
        >
          <p class="font-mono text-[0.65rem] uppercase tracking-[0.14em] text-tenue">Siguiente →</p>
          <p class="mt-2 font-medium leading-snug">{siguiente.data.titulo}</p>
        </a>
      )}
    </nav>
  )
}
