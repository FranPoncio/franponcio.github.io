---
/**
 * El fondo vivo: humo de gas y datos cayendo, detrás de todo.
 *
 * Dos capas sobre un solo canvas:
 *   · PLUMAS — manchas suaves que suben y se deshacen, como una fuga de gas.
 *   · DATOS  — columnas de unos y ceros que bajan, como la lectura del caño.
 *
 * Las dos reaccionan al scroll: la velocidad con la que scrolleás empuja el
 * humo hacia arriba y acelera la caída de los dígitos. Quieto, el fondo sigue
 * respirando despacio; en movimiento, se agita.
 *
 * Va en un canvas y no en SVG porque son cientos de elementos redibujados por
 * frame: en el DOM eso es inviable, en canvas es un solo elemento.
 *
 * Acá vive TAMBIÉN el humo de la traza. Antes tenía su propio canvas adentro
 * del panel `sticky` de la traza, que además lleva `overflow: hidden`: un
 * `position: fixed` metido ahí adentro es de los casos que Safari de iPhone
 * resuelve mal, y era la explicación más probable de que el humo se viera en
 * mis pruebas y no en un teléfono. Acá el canvas cuelga del <body>, sin ningún
 * ancestro que le pueda cambiar el bloque contenedor.
 *
 * Es DECORATIVO: aria-hidden, sin eventos de puntero, y con
 * prefers-reduced-motion no se dibuja nada.
 */
---

<canvas id="fondo" aria-hidden="true"></canvas>

<style>
  #fondo {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -2;
    pointer-events: none;
    /* Antes iba a 0.5 con alfas de 0.05: 2.5% real, o sea invisible.
       Ahora se ve. */
    opacity: 1;
  }

  /* En una pantalla angosta no hay margen: los dígitos caen justo encima de la
     columna de lectura. Ahí el fondo baja — la legibilidad gana siempre. */
  }
</style>

<script>
  const lienzo = document.querySelector<HTMLCanvasElement>('#fondo');
  const ctx = lienzo?.getContext('2d', { alpha: true });
  const quieto = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (lienzo && ctx && !quieto) {
    const cx = ctx;
    const raiz = getComputedStyle(document.documentElement);
    // Se resuelven los tokens a componentes RGB UNA vez. Antes se armaba un
    // color-mix() por dígito y por pluma —cientos de strings CSS por frame que
    // el navegador tiene que parsear— y ademas color-mix dentro de canvas no
    // está en todos los navegadores. Con rgba() es más rápido y anda en todos.
    const aRgb = (css: string, respaldo: [number, number, number]): [number, number, number] => {
      const h = css.trim();
      const m = /^#?([0-9a-f]{6})$/i.exec(h);
      if (!m) return respaldo;
      const n = parseInt(m[1], 16);
      return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
    };
    const acento = aRgb(raiz.getPropertyValue('--color-acento'), [255, 45, 120]);
    const tinta = aRgb(raiz.getPropertyValue('--color-texto'), [20, 18, 16]);
    const rgba = ([r, g, b]: [number, number, number], a: number) => `rgba(${r},${g},${b},${a})`;

    let an = 0;
    let al = 0;
    let dpr = 1;

    interface Pluma { x: number; y: number; r: number; vy: number; vida: number; }
    interface Columna { x: number; y: number; v: number; bits: string[]; paso: number; }
    /** El humo de la traza. `s` es la posición sobre el recorrido, 0 a 1. */
    interface Humo {
      marco: HTMLElement;
      s: number;
      desvio: number;
      deriva: number;
      subida: number;
      r: number;
      crece: number;
      vida: number;
      dura: number;
      /** null = humo · '0'/'1' = dato · 'brasa' = chispa de la llama */
      bit: string | null;
      brasa?: boolean;
    }

    /**
     * El fondo tenía DOS capas propias además del humo de la traza: plumas
     * sueltas y una lluvia de dígitos por toda la pantalla. Sumadas a los
     * lunares, al halo y al humo, el fondo era un ruido y encima le competía
     * al humo, que es lo único que tiene que verse moverse.
     *
     * Quedan apagadas. Si algún día se quieren de vuelta, esto va en true.
     */
    const ambiente = false;

    let plumas: Pluma[] = [];
    let columnas: Columna[] = [];
    const humo: Humo[] = [];

    const azar = (a: number, b: number) => a + Math.random() * (b - a);

    const armar = () => {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      an = lienzo.clientWidth;
      al = lienzo.clientHeight;
      lienzo.width = Math.round(an * dpr);
      lienzo.height = Math.round(al * dpr);
      cx.setTransform(dpr, 0, 0, dpr, 0, 0);

      // La densidad sale del área: en un celular no van 40 plumas.
      const area = (an * al) / (1440 * 900);
      const cuantasPlumas = Math.round(16 * Math.min(Math.max(area, 0.35), 1.4));
      const cuantasCols = Math.round(26 * Math.min(Math.max(area, 0.35), 1.4));

      plumas = Array.from({ length: cuantasPlumas }, () => ({
        x: azar(0, an),
        y: azar(0, al),
        r: azar(160, 420),
        vy: azar(0.18, 0.55),
        vida: azar(0, 1),
      }));

      columnas = Array.from({ length: cuantasCols }, () => ({
        x: azar(0, an),
        y: azar(-al, al),
        v: azar(0.5, 1.5),
        paso: azar(19, 27),
        bits: Array.from({ length: Math.round(azar(6, 16)) }, () =>
          Math.random() < 0.5 ? '0' : '1',
        ),
      }));
    };

    // Cuánto se scrolleó desde el último frame: es lo que agita el fondo.
    let ultimoY = window.scrollY;
    let empuje = 0;
    addEventListener(
      'scroll',
      () => {
        const d = window.scrollY - ultimoY;
        ultimoY = window.scrollY;
        // Se acumula y se acota: un scroll violento no tiene que reventarlo.
        empuje = Math.min(Math.max(empuje + d * 0.045, -14), 14);
      },
      { passive: true },
    );

    let corriendo = true;
    document.addEventListener('visibilitychange', () => {
      corriendo = !document.hidden;
      if (corriendo) {
        ultimoY = window.scrollY;
        requestAnimationFrame(pintar);
      }
    });

    function pintar() {
      if (!corriendo) return;
      cx.clearRect(0, 0, an, al);

      // El empuje se disipa solo: el fondo vuelve a su ritmo si dejás de scrollear.
      empuje *= 0.93;

      // ── Humo ambiente ───────────────────────────────────────────────────
      // (desactivado: ver la nota de arriba)
      for (const p of ambiente ? plumas : []) {
        p.vida += 0.0018;
        if (p.vida > 1) {
          p.vida = 0;
          p.x = azar(0, an);
          p.y = azar(al * 0.55, al * 1.15);
          p.r = azar(160, 420);
        }
        p.y -= p.vy + empuje * 0.22;
        p.x += Math.sin((p.y + p.r) * 0.004) * 0.9;
        if (p.y < -p.r) p.y = al + p.r;

        // Se desvanece en las dos puntas de su vida: nunca aparece de golpe.
        const alfa = Math.sin(p.vida * Math.PI) * 0.17;
        if (alfa <= 0.001) continue;

        const g = cx.createRadialGradient(p.x, p.y, 0, p.x, p.y, p.r);
        g.addColorStop(0, rgba(acento, alfa));
        g.addColorStop(1, rgba(acento, 0));
        cx.fillStyle = g;
        cx.beginPath();
        cx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        cx.fill();
      }

      // ── Unos y ceros ────────────────────────────────────────────────────
      cx.font = "500 14px 'Martian Mono', ui-monospace, monospace";
      cx.textAlign = 'center';
      const tenues = an < 900 ? 0.32 : 1;
      for (const c of ambiente ? columnas : []) {
        c.y += c.v + empuje * 0.85;
        const largo = c.bits.length * c.paso;
        if (c.y - largo > al) {
          c.y = -azar(0, al * 0.4);
          c.x = azar(0, an);
        } else if (c.y + largo < 0) {
          c.y = al + azar(0, al * 0.4);
        }
        // Cada tanto un bit cambia: la columna no es una cadena fija.
        if (Math.random() < 0.06) {
          c.bits[Math.floor(Math.random() * c.bits.length)] = Math.random() < 0.5 ? '0' : '1';
        }
        for (let i = 0; i < c.bits.length; i++) {
          // La cabeza de la columna es la más marcada y se apaga hacia atrás.
          const alfa = (1 - i / c.bits.length) * 0.3 * tenues;
          cx.fillStyle = rgba(i === 0 ? acento : tinta, alfa);
          cx.fillText(c.bits[i], c.x, c.y - i * c.paso);
        }
      }

      dibujarHumo();
      requestAnimationFrame(pintar);
    }

    // ── EL HUMO DE LA TRAZA ─────────────────────────────────────────────
    // Sale por donde el recorrido ya pasó y se deshace atrás, con dígitos
    // binarios flotando entre las volutas. Cada partícula guarda su posición
    // en coordenada de recorrido (0 a 1 de la traza entera) y no en píxeles:
    // así queda anclada a su tramo y acompaña al scroll.
    const MAX_HUMO = 420;

    function nacerHumo(marco: HTMLElement, s: number, esBit: boolean, brasa = false) {
      if (humo.length >= MAX_HUMO) humo.shift();
      humo.push({
        marco,
        brasa,
        s,
        desvio: brasa ? azar(-4, 4) : azar(-9, 9),
        deriva: brasa ? azar(-0.22, 0.22) : azar(-0.4, 0.4),
        subida: esBit ? azar(0.35, 0.75) : azar(0, 6),
        r: esBit ? 0 : brasa ? azar(1.1, 2.6) : azar(18, 40),
        crece: brasa ? azar(0.004, 0.02) : azar(0.5, 1.1),
        vida: 0,
        dura: esBit ? azar(150, 230) : brasa ? azar(90, 170) : azar(150, 240),
        bit: esBit ? (Math.random() < 0.5 ? '0' : '1') : null,
      });
    }

    // Hay dos trazas —experiencia y herramientas propias—: el humo sale de la
    // que esté en pantalla.
    const trazas = () => [...document.querySelectorAll<HTMLElement>('.marco')];

    function dibujarHumo() {
      for (const marco of trazas()) dibujarTraza(marco);
    }

    function dibujarTraza(marco: HTMLElement) {
      const via = marco.querySelector<HTMLElement>('.via');
      if (!via) return;

      const caja = marco.getBoundingClientRect();
      // Fuera de pantalla no se dibuja ni se emite: no tiene sentido gastar
      // frames en humo que nadie ve.
      const aLaVista = caja.bottom > -200 && caja.top < al + 200;
      const avance = parseFloat(via.style.getPropertyValue('--avance') || '0');
      const vertical = !matchMedia('(min-width: 901px)').matches;

      if (aLaVista && avance > 0.004) {
        for (let i = 0; i < 8; i++) nacerHumo(marco, avance - Math.random() * 0.02, false);
        nacerHumo(marco, avance - Math.random() * 0.02, true);
        if (Math.random() < 0.5) nacerHumo(marco, avance - Math.random() * 0.03, true);
        for (let i = 0; i < 3; i++) nacerHumo(marco, Math.random() * avance, false);
        // Brasas: chispas de la llama que suben con el humo. Chicas, brillantes
        // y de vida corta — son el detalle que hace que el humo se lea CALIENTE
        // y no como niebla.
        for (let i = 0; i < 2; i++) nacerHumo(marco, avance - Math.random() * 0.03, false, true);
        if (Math.random() < 0.6) nacerHumo(marco, Math.random() * avance, false, true);
        if (Math.random() < 0.75) nacerHumo(marco, Math.random() * avance, true);
      }

      cx.font = "700 13px 'Martian Mono', ui-monospace, monospace";
      cx.textAlign = 'center';

      for (let i = humo.length - 1; i >= 0; i--) {
        const q = humo[i];
        if (q.marco !== marco) continue;   // cada traza dibuja lo suyo
        q.vida += 1;
        if (q.vida > q.dura) {
          humo.splice(i, 1);
          continue;
        }
        if (!aLaVista) continue;

        q.desvio += q.deriva;
        // Las brasas suben más rápido y no se frenan: son livianas.
        q.subida += q.brasa ? 1.5 : (q.bit ? 0.8 : 0.72) * Math.max(1 - q.subida / 120, 0.08);
        q.r += q.crece;

        const p = q.vida / q.dura;
        // Entra rápido y se va lento: es como se disipa el humo.
        const alfa = Math.sin(Math.pow(p, 0.65) * Math.PI);
        // EN HORIZONTAL LA LÍNEA ESTÁ EN EL MEDIO DE LA PANTALLA, no en el
        // medio del bloque. El bloque mide varias pantallas de alto y adentro
        // hay un panel `sticky`: la línea vive a media pantalla, siempre.
        // Estaba usando el centro del bloque —caja.top + caja.height / 2— que
        // con un bloque de 5.000 px cae en cualquier lado. Por eso el humo
        // salía a 300 px de la traza, flotando solo: nunca estuvo sobre la
        // línea, y por eso no se leía como gas saliendo del recorrido.
        const x = vertical ? 23 + q.desvio + q.subida : q.s * an;
        const y = vertical ? caja.top + q.s * caja.height : al / 2 + q.desvio - q.subida;
        if (y < -120 || y > al + 120 || x < -120 || x > an + 120) continue;

        if (q.bit) {
          cx.fillStyle = `rgba(79, 196, 176, ${(alfa * 0.95).toFixed(3)})`;
          cx.fillText(q.bit, x, y);
        } else if (q.brasa) {
          const g = cx.createRadialGradient(x, y, 0, x, y, q.r * 3.4);
          g.addColorStop(0, `rgba(255, 190, 120, ${alfa.toFixed(3)})`);
          g.addColorStop(0.35, `rgba(255, 138, 61, ${(alfa * 0.75).toFixed(3)})`);
          g.addColorStop(1, 'rgba(255, 138, 61, 0)');
          cx.fillStyle = g;
          cx.beginPath();
          cx.arc(x, y, q.r * 3.4, 0, Math.PI * 2);
          cx.fill();
        } else {
          const g = cx.createRadialGradient(x, y, 0, x, y, q.r);
          // Claro sobre tinta: es como se ve el humo de verdad, por dispersión
          // de luz sobre un fondo oscuro. Y acá sí puede ir fuerte sin taparle
          // nada al texto, porque el texto también es claro y está por encima.
          // Hueso tibio, no gris: el humo de una llama de gas arrastra el
          // color de la llama.
          g.addColorStop(0, `rgba(214, 206, 186, ${(alfa * 0.42).toFixed(3)})`);
          g.addColorStop(0.5, `rgba(190, 186, 168, ${(alfa * 0.2).toFixed(3)})`);
          g.addColorStop(1, 'rgba(190, 186, 168, 0)');
          cx.fillStyle = g;
          cx.beginPath();
          cx.arc(x, y, q.r, 0, Math.PI * 2);
          cx.fill();
        }
      }
    }

    armar();
    addEventListener('resize', armar, { passive: true });
    requestAnimationFrame(pintar);
  }
</script>
