---
/**
 * El fondo vivo: humo de gas y datos cayendo, detrás de todo.
 *
 * Dos capas sobre un solo canvas:
 *   · PLUMAS — manchas suaves que suben y se deshacen, como una fuga de gas.
 *   · DATOS  — columnas de unos y ceros que bajan, como la lectura del caño.
 *
 * Las dos reaccionan al scroll: la velocidad con la que scrolleás empuja el
 * humo hacia arriba y acelera la caída de los dígitos. Quieto, el fondo sigue
 * respirando despacio; en movimiento, se agita.
 *
 * Va en un canvas y no en SVG porque son cientos de elementos redibujados por
 * frame: en el DOM eso es inviable, en canvas es un solo elemento.
 *
 * Acá vive TAMBIÉN el humo de la traza. Antes tenía su propio canvas adentro
 * del panel `sticky` de la traza, que además lleva `overflow: hidden`: un
 * `position: fixed` metido ahí adentro es de los casos que Safari de iPhone
 * resuelve mal, y era la explicación más probable de que el humo se viera en
 * mis pruebas y no en un teléfono. Acá el canvas cuelga del <body>, sin ningún
 * ancestro que le pueda cambiar el bloque contenedor.
 *
 * Es DECORATIVO: aria-hidden y sin eventos de puntero. Con
 * prefers-reduced-motion NO se apaga: se dibuja clavado (ver "modo quieto"
 * más abajo). Apagarlo entero era dejar sin fondo a quien tiene esa
 * preferencia prendida, que es mucha gente y ni se entera.
 */
---

<canvas id="fondo" aria-hidden="true"></canvas>

<style>
  #fondo {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -2;
    pointer-events: none;
    /* Antes iba a 0.5 con alfas de 0.05: 2.5% real, o sea invisible.
       Ahora se ve. */
    opacity: 1;
  }

</style>

<script>
  const lienzo = document.querySelector<HTMLCanvasElement>('#fondo');
  const ctx = lienzo?.getContext('2d', { alpha: true });
  const quieto = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (lienzo && ctx) {
    const cx = ctx;
    const raiz = getComputedStyle(document.documentElement);
    // Se resuelven los tokens a componentes RGB UNA vez. Antes se armaba un
    // color-mix() por dígito y por pluma —cientos de strings CSS por frame que
    // el navegador tiene que parsear— y ademas color-mix dentro de canvas no
    // está en todos los navegadores. Con rgba() es más rápido y anda en todos.
    const aRgb = (css: string, respaldo: [number, number, number]): [number, number, number] => {
      const h = css.trim();
      const m = /^#?([0-9a-f]{6})$/i.exec(h);
      if (!m) return respaldo;
      const n = parseInt(m[1], 16);
      return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
    };
    const acento = aRgb(raiz.getPropertyValue('--color-acento'), [255, 138, 43]);
    const datos = aRgb(raiz.getPropertyValue('--color-datos'), [58, 224, 207]);
    const tinta = aRgb(raiz.getPropertyValue('--color-texto'), [236, 231, 218]);
    const rgba = ([r, g, b]: [number, number, number], a: number) => `rgba(${r},${g},${b},${a})`;

    /**
     * LA VOLUTA, PINTADA UNA SOLA VEZ.
     *
     * Antes cada partícula armaba su propio createRadialGradient() y su
     * propio arc()+fill() en cada frame. Con ~560 volutas vivas eso es armar
     * 560 objetos de gradiente por frame, y medido en esta máquina daba 23
     * fps: el humo se arrastraba.
     *
     * Acá el degradado se pinta una vez en un canvas aparte de 128 px y
     * después cada partícula es un drawImage() escalado, que es una copia de
     * píxeles y nada más. El color se resuelve con globalAlpha, así que una
     * sola voluta sirve para todas.
     */
    const VOLUTA = 64;
    const voluta = document.createElement('canvas');
    voluta.width = voluta.height = VOLUTA * 2;
    {
      const vx = voluta.getContext('2d')!;
      const g = vx.createRadialGradient(VOLUTA, VOLUTA, 0, VOLUTA, VOLUTA, VOLUTA);
      // Claro sobre tinta: es como se ve el humo de verdad, por dispersión de
      // luz sobre un fondo oscuro. Va con un toque de azul, como la noche.
      g.addColorStop(0, 'rgba(214, 214, 236, 1)');
      g.addColorStop(0.5, 'rgba(180, 186, 214, 0.45)');
      g.addColorStop(1, 'rgba(180, 186, 214, 0)');
      vx.fillStyle = g;
      vx.fillRect(0, 0, VOLUTA * 2, VOLUTA * 2);
    }

    let an = 0;
    let al = 0;
    let dpr = 1;

    interface Pluma { x: number; y: number; r: number; vy: number; vida: number; }
    interface Columna { x: number; y: number; v: number; bits: string[]; paso: number; }
    /** El humo de la traza. `s` es la posición sobre el recorrido, 0 a 1. */
    interface Humo {
      marco: HTMLElement;
      s: number;
      desvio: number;
      deriva: number;
      subida: number;
      r: number;
      crece: number;
      vida: number;
      dura: number;
      /** null = humo · si tiene texto, es un número flotando */
      bit: string | null;
      /** Los números grandes van más marcados que los sueltos. */
      fuerte?: boolean;
    }

    /**
     * El fondo tenía DOS capas propias además del humo de la traza: plumas
     * sueltas y una lluvia de dígitos por toda la pantalla. Sumadas a los
     * lunares, al halo y al humo, el fondo era un ruido y encima le competía
     * al humo, que es lo único que tiene que verse moverse.
     *
     * Quedan apagadas. Si algún día se quieren de vuelta, esto va en true.
     */
    const ambiente = false;

    let plumas: Pluma[] = [];
    let columnas: Columna[] = [];
    const humo: Humo[] = [];

    const azar = (a: number, b: number) => a + Math.random() * (b - a);

    const armar = () => {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      an = lienzo.clientWidth;
      al = lienzo.clientHeight;
      lienzo.width = Math.round(an * dpr);
      lienzo.height = Math.round(al * dpr);
      cx.setTransform(dpr, 0, 0, dpr, 0, 0);

      // La densidad sale del área: en un celular no van 40 plumas.
      const area = (an * al) / (1440 * 900);
      const cuantasPlumas = Math.round(16 * Math.min(Math.max(area, 0.35), 1.4));
      const cuantasCols = Math.round(26 * Math.min(Math.max(area, 0.35), 1.4));

      plumas = Array.from({ length: cuantasPlumas }, () => ({
        x: azar(0, an),
        y: azar(0, al),
        r: azar(160, 420),
        vy: azar(0.18, 0.55),
        vida: azar(0, 1),
      }));

      columnas = Array.from({ length: cuantasCols }, () => ({
        x: azar(0, an),
        y: azar(-al, al),
        v: azar(0.5, 1.5),
        paso: azar(19, 27),
        bits: Array.from({ length: Math.round(azar(6, 16)) }, () =>
          Math.random() < 0.5 ? '0' : '1',
        ),
      }));
    };

    // Cuánto se scrolleó desde el último frame: es lo que agita el fondo.
    let ultimoY = window.scrollY;
    let empuje = 0;
    addEventListener(
      'scroll',
      () => {
        const d = window.scrollY - ultimoY;
        ultimoY = window.scrollY;
        // Se acumula y se acota: un scroll violento no tiene que reventarlo.
        empuje = Math.min(Math.max(empuje + d * 0.045, -14), 14);
      },
      { passive: true },
    );

    let corriendo = true;
    document.addEventListener('visibilitychange', () => {
      corriendo = !document.hidden;
      if (corriendo) {
        ultimoY = window.scrollY;
        requestAnimationFrame(pintar);
      }
    });

    function pintar() {
      if (!corriendo) return;
      cx.clearRect(0, 0, an, al);

      // El empuje se disipa solo: el fondo vuelve a su ritmo si dejás de scrollear.
      empuje *= 0.93;

      // ── Humo ambiente ───────────────────────────────────────────────────
      // (desactivado: ver la nota de arriba)
      for (const p of ambiente ? plumas : []) {
        p.vida += 0.0018;
        if (p.vida > 1) {
          p.vida = 0;
          p.x = azar(0, an);
          p.y = azar(al * 0.55, al * 1.15);
          p.r = azar(160, 420);
        }
        p.y -= p.vy + empuje * 0.22;
        p.x += Math.sin((p.y + p.r) * 0.004) * 0.9;
        if (p.y < -p.r) p.y = al + p.r;

        // Se desvanece en las dos puntas de su vida: nunca aparece de golpe.
        const alfa = Math.sin(p.vida * Math.PI) * 0.17;
        if (alfa <= 0.001) continue;

        const g = cx.createRadialGradient(p.x, p.y, 0, p.x, p.y, p.r);
        g.addColorStop(0, rgba(acento, alfa));
        g.addColorStop(1, rgba(acento, 0));
        cx.fillStyle = g;
        cx.beginPath();
        cx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        cx.fill();
      }

      // ── Unos y ceros ────────────────────────────────────────────────────
      cx.font = "500 14px 'Roboto Variable', system-ui, sans-serif";
      cx.textAlign = 'center';
      const tenues = an < 900 ? 0.32 : 1;
      for (const c of ambiente ? columnas : []) {
        c.y += c.v + empuje * 0.85;
        const largo = c.bits.length * c.paso;
        if (c.y - largo > al) {
          c.y = -azar(0, al * 0.4);
          c.x = azar(0, an);
        } else if (c.y + largo < 0) {
          c.y = al + azar(0, al * 0.4);
        }
        // Cada tanto un bit cambia: la columna no es una cadena fija.
        if (Math.random() < 0.06) {
          c.bits[Math.floor(Math.random() * c.bits.length)] = Math.random() < 0.5 ? '0' : '1';
        }
        for (let i = 0; i < c.bits.length; i++) {
          // La cabeza de la columna es la más marcada y se apaga hacia atrás.
          const alfa = (1 - i / c.bits.length) * 0.3 * tenues;
          cx.fillStyle = rgba(i === 0 ? acento : tinta, alfa);
          cx.fillText(c.bits[i], c.x, c.y - i * c.paso);
        }
      }

      dibujarHumo();
      requestAnimationFrame(pintar);
    }

    // ── EL HUMO DE LA TRAZA ─────────────────────────────────────────────
    // Sale por donde el recorrido ya pasó y se deshace atrás, con dígitos
    // binarios flotando entre las volutas. Cada partícula guarda su posición
    // en coordenada de recorrido (0 a 1 de la traza entera) y no en píxeles:
    // así queda anclada a su tramo y acompaña al scroll.
    const MAX_HUMO = 340;

    /**
     * Lo que flota en el humo son NÚMEROS DE VERDAD, no unos y ceros: los que
     * salen de los casos del sitio. El humo sale de la traza, y lo que sube
     * con él es exactamente lo que hay abajo.
     */
    const CIFRAS = [
      '12.000', '413', '+35', '150', '500', '< 5 %', '0', '135', '2,6', '46',
      '9001', '14001', '45001', '6.900', 'SPI', 'CPI', 'EVM', 'km', '%',
    ];
    const sueltos = '0123456789';

    /**
     * `flanco` es la media anchura de la ficha: los NÚMEROS nacen más afuera
     * que eso. Las fichas van centradas sobre el mismo eje por el que sube el
     * humo, así que un número que nace pegado al eje sube justo por detrás de
     * la ficha y no se lee nunca — que es exactamente lo que pasaba.
     * El humo sí nace pegado al eje: por detrás de la ficha queda como un
     * resplandor, y para eso la ficha es semitransparente.
     */
    function nacerHumo(marco: HTMLElement, s: number, esBit: boolean, flanco: number) {
      if (humo.length >= MAX_HUMO) humo.shift();
      humo.push({
        marco,
        s,
        // Nace pegado al eje y se ABRE mientras sube: es la forma de una
        // pluma de verdad. Con la deriva vieja (±0.4) el humo subia en una
        // columna finita y quedaba todo detras de las fichas, que estan
        // centradas sobre el mismo eje. Con ±1.7 a los ~200 frames ya esta
        // a ±340 px, o sea afuera de la ficha, en los costados libres.
        desvio: esBit
          ? (Math.random() < 0.5 ? -1 : 1) * azar(flanco, flanco * 1.9)
          : azar(-14, 14),
        // El humo se ABRE mientras sube: es la forma de una pluma de verdad.
        // Los números ya nacen afuera, así que apenas van a la deriva.
        deriva: esBit ? azar(-0.25, 0.25) : azar(-1.7, 1.7),
        subida: esBit ? azar(0.35, 0.75) : azar(0, 6),
        r: esBit ? 0 : azar(18, 40),
        crece: azar(0.5, 1.1),
        vida: 0,
        dura: esBit ? azar(190, 300) : azar(150, 240),
        // Dos tercios son cifras completas y el resto dígitos sueltos: si
        // fueran todas cifras se leería como una lista, y si fueran todos
        // dígitos sueltos volvería a ser lluvia de matriz.
        bit: esBit
          ? Math.random() < 0.62
            ? CIFRAS[Math.floor(Math.random() * CIFRAS.length)]
            : sueltos[Math.floor(Math.random() * 10)]
          : null,
        fuerte: esBit && Math.random() < 0.42,
      });
    }

    // Hay dos trazas —experiencia y herramientas propias—: el humo sale de la
    // que esté en pantalla.
    const trazas = () => [...document.querySelectorAll<HTMLElement>('.marco')];

    function dibujarHumo() {
      for (const marco of trazas()) dibujarTraza(marco);
    }

    function dibujarTraza(marco: HTMLElement) {
      const via = marco.querySelector<HTMLElement>('.via');
      if (!via) return;

      const caja = marco.getBoundingClientRect();
      // Fuera de pantalla no se dibuja ni se emite: no tiene sentido gastar
      // frames en humo que nadie ve.
      const aLaVista = caja.bottom > -200 && caja.top < al + 200;
      const avance = parseFloat(via.style.getPropertyValue('--avance') || '0');

      // El eje NO se asume en el medio: se mide. La traza esta centrada en la
      // pagina, pero si algun dia deja de estarlo el humo la sigue igual.
      const vcaja = via.getBoundingClientRect();
      const eje = vcaja.left + vcaja.width / 2;

      // Media anchura de la ficha + un respiro. En una pantalla angosta la
      // ficha ocupa casi todo el ancho y no hay costados libres: ahí el
      // flanco se acota para que los números caigan en los huecos que quedan
      // ENTRE ficha y ficha, que en vertical sí los hay.
      const fcaja = marco.querySelector('.ficha')?.getBoundingClientRect();
      const media = fcaja ? fcaja.width / 2 : 310;
      const flanco = Math.min(media + 30, Math.max(an * 0.5 - 40, 60));

      if (aLaVista && avance > 0.004) {
        // EL HUMO sale del frente —la cabeza encendida que va bajando— y un
        // resto de todo el tramo ya recorrido, que en pantalla queda ARRIBA
        // del frente. Como el humo sube, el rastro y la pluma van al mismo
        // lado: el gas se escapa hacia el tramo que ya hiciste.
        for (let i = 0; i < 8; i++) nacerHumo(marco, avance - Math.random() * 0.012, false, flanco);
        for (let i = 0; i < 3; i++) nacerHumo(marco, Math.random() * avance, false, flanco);

        // LOS NÚMEROS, en cambio, se reparten por TODO el tramo que se ve.
        // Antes nacían todos junto al frente, que cae siempre a la misma
        // altura de pantalla, y como suben apenas 150 px terminaban apilados
        // en una franja horizontal: dejaban de leerse como números sueltos
        // flotando y pasaban a ser una mancha.
        // `sArriba` es el punto del recorrido que hoy está tocando el borde
        // de arriba de la pantalla; entre ése y el frente hay una pantalla
        // entera de rastro para repartirlos.
        const sArriba = Math.max(-caja.top / caja.height, 0);
        const tramo = Math.max(avance - sArriba, 0.001);
        if (Math.random() < 0.4) {
          nacerHumo(marco, sArriba + Math.random() * tramo, true, flanco);
        }
      }

      cx.textAlign = 'center';

      for (let i = humo.length - 1; i >= 0; i--) {
        const q = humo[i];
        if (q.marco !== marco) continue;   // cada traza dibuja lo suyo
        q.vida += 1;
        if (q.vida > q.dura) {
          humo.splice(i, 1);
          continue;
        }
        if (!aLaVista) continue;

        q.desvio += q.deriva;
        // Los numeros suben mas rapido que el humo: se despegan y se leen.
        q.subida += (q.bit ? 1.15 : 0.72) * Math.max(1 - q.subida / 150, 0.1);
        // El radio SE TOPEA. Sin tope, con `crece` ~1 y 240 frames de vida
        // una voluta terminaba con 300 px de radio: son 600x600 px de mezcla
        // por partícula y por frame, y con cientos vivas el fondo se comía la
        // placa (23 fps medidos). A 105 px sigue leyéndose como humo y el
        // dibujado baja como el cuadrado del radio.
        q.r = Math.min(q.r + q.crece, 105);

        const p = q.vida / q.dura;
        // Entra rapido y se va lento: es como se disipa el humo.
        const alfa = Math.sin(Math.pow(p, 0.65) * Math.PI);

        // LA TRAZA ES VERTICAL Y CENTRADA. Cada particula guarda su posicion
        // en coordenada de recorrido (`s`, de 0 a 1 del bloque entero) y no
        // en pixeles: asi queda anclada a su tramo y acompaña al scroll.
        // `s` -> altura de pagina; `subida` sube; `desvio` abre la pluma.
        const x = eje + q.desvio;
        const y = caja.top + q.s * caja.height - q.subida;
        if (y < -120 || y > al + 120 || x < -140 || x > an + 140) continue;

        if (q.bit) {
          // Las cifras completas van grandes y en llama; los digitos sueltos,
          // chicos y en pantalla. Asi el humo tiene jerarquia en vez de ruido.
          if (q.fuerte) {
            // El resplandor NO va con shadowBlur: es de lo más caro que
            // tiene canvas y acá se dibujaban decenas por frame. Se hace a
            // mano con una pasada previa más grande y translúcida, que sale
            // casi gratis y se ve igual.
            cx.font = "700 26px 'Roboto Variable', system-ui, sans-serif";
            cx.fillStyle = rgba(acento, alfa * 0.16);
            cx.fillText(q.bit, x, y);
            cx.fillStyle = rgba(acento, alfa);
          } else {
            cx.font = "700 14px 'Roboto Variable', system-ui, sans-serif";
            cx.fillStyle = rgba(datos, alfa * 0.85);
          }
          cx.fillText(q.bit, x, y);
        } else {
          // Puede ir fuerte sin taparle nada al texto, porque el texto tambien
          // es claro y esta por encima.
          cx.globalAlpha = alfa * 0.4;
          cx.drawImage(voluta, x - q.r, y - q.r, q.r * 2, q.r * 2);
          cx.globalAlpha = 1;
        }
      }
    }

    // ── MODO QUIETO ──────────────────────────────────────────────────────
    /**
     * Con `prefers-reduced-motion: reduce` el fondo entero no se dibujaba: ni
     * humo, ni números, ni nada. El canvas ni siquiera se dimensionaba —se
     * quedaba en los 300x150 por defecto— y quien tuviera esa preferencia
     * prendida veía el sitio pelado, sin enterarse de que le faltaba algo.
     *
     * La intención era buena. La ejecución era todo o nada, y estaba mal: la
     * preferencia pide que NO SE MUEVA NADA, no que no haya contenido.
     *
     * Así que acá el humo y los números se dibujan igual, pero clavados: se
     * siembran una vez a lo largo de todo el recorrido, no se animan nunca, y
     * acompañan a la página igual que el texto. No hay un solo píxel que se
     * desplace solo, y tampoco hay nada atado a cuánto scrolleaste: hacer
     * aparecer cosas según el scroll también es movimiento.
     */
    const sembrado = new Set<HTMLElement>();

    function sembrarQuieto(marco: HTMLElement, flanco: number, largo: number) {
      // La densidad sale del largo del recorrido y no de un número fijo: una
      // traza de dos estaciones no lleva lo mismo que una de seis.
      const cuantas = Math.round(Math.min(Math.max(largo / 24, 45), 200));
      for (let i = 0; i < cuantas; i++) {
        const esBit = Math.random() < 0.38;
        humo.push({
          marco,
          s: Math.random(),
          // Sin animación no hay pluma que se abra sola, así que la apertura
          // se siembra ya hecha: el humo repartido cerca del eje y los
          // números afuera de la ficha, que es donde terminarían.
          desvio: esBit
            ? (Math.random() < 0.5 ? -1 : 1) * azar(flanco, flanco * 1.9)
            : azar(-95, 95),
          deriva: 0,
          subida: 0,
          r: esBit ? 0 : azar(45, 105),
          crece: 0,
          // En quieto `vida` no cuenta frames: guarda el alfa fijo.
          vida: azar(0.4, 1),
          dura: 1,
          bit: esBit
            ? Math.random() < 0.62
              ? CIFRAS[Math.floor(Math.random() * CIFRAS.length)]
              : sueltos[Math.floor(Math.random() * 10)]
            : null,
          fuerte: esBit && Math.random() < 0.42,
        });
      }
      sembrado.add(marco);
    }

    function dibujarTrazaQuieta(marco: HTMLElement) {
      const via = marco.querySelector<HTMLElement>('.via');
      if (!via) return;
      const caja = marco.getBoundingClientRect();
      if (caja.bottom < -200 || caja.top > al + 200) return;

      const vcaja = via.getBoundingClientRect();
      const eje = vcaja.left + vcaja.width / 2;
      const fcaja = marco.querySelector('.ficha')?.getBoundingClientRect();
      const media = fcaja ? fcaja.width / 2 : 310;
      const flanco = Math.min(media + 30, Math.max(an * 0.5 - 40, 60));

      if (!sembrado.has(marco)) sembrarQuieto(marco, flanco, caja.height);

      cx.textAlign = 'center';
      for (const q of humo) {
        if (q.marco !== marco) continue;
        const x = eje + q.desvio;
        const y = caja.top + q.s * caja.height;
        if (y < -130 || y > al + 130) continue;
        const alfa = q.vida;

        if (q.bit) {
          if (q.fuerte) {
            cx.font = "700 26px 'Roboto Variable', system-ui, sans-serif";
            cx.fillStyle = rgba(acento, alfa * 0.16);
            cx.fillText(q.bit, x, y);
            cx.fillStyle = rgba(acento, alfa);
          } else {
            cx.font = "700 14px 'Roboto Variable', system-ui, sans-serif";
            cx.fillStyle = rgba(datos, alfa * 0.85);
          }
          cx.fillText(q.bit, x, y);
        } else {
          cx.globalAlpha = alfa * 0.3;
          cx.drawImage(voluta, x - q.r, y - q.r, q.r * 2, q.r * 2);
          cx.globalAlpha = 1;
        }
      }
    }

    if (quieto) {
      // Nada de bucle continuo: se repinta sólo cuando cambió lo que se ve.
      armar();
      let pendiente = false;
      const redibujar = () => {
        pendiente = false;
        cx.clearRect(0, 0, an, al);
        for (const m of trazas()) dibujarTrazaQuieta(m);
      };
      const alScroll = () => {
        if (pendiente) return;
        pendiente = true;
        requestAnimationFrame(redibujar);
      };
      addEventListener('scroll', alScroll, { passive: true });
      addEventListener(
        'resize',
        () => {
          // Al cambiar el ancho cambia el flanco, así que se siembra de nuevo.
          armar();
          humo.length = 0;
          sembrado.clear();
          redibujar();
        },
        { passive: true },
      );
      // Las fuentes y las imágenes cambian el alto del bloque después del
      // primer pintado: hay que volver a medir cuando termina de cargar.
      addEventListener('load', redibujar);
      redibujar();
    } else {
      armar();
      addEventListener('resize', armar, { passive: true });
      requestAnimationFrame(pintar);
    }
  }
</script>
