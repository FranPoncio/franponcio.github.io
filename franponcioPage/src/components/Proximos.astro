---
import type { CollectionEntry } from 'astro:content';

/**
 * LO QUE VIENE — la cinta de lo que todavía no es una credencial.
 *
 * Antes esto era una lista de dos renglones abajo de los certificados. Va como
 * cinta, con el mismo mecanismo que la del stack: tres copias, un carril con
 * scroll propio y un salto de copia cuando te acercás a la punta, así es
 * infinita la mueva la animación o la muevas vos con el dedo.
 *
 * LA CHAPA, en vez de un logo de marca.
 *
 * Ni PMI ni IBM están en `simple-icons`. Dibujar de memoria una aproximación
 * de un logotipo ajeno da algo que NO es su logo: es una versión falsa, y eso
 * es peor que no poner nada — el mismo criterio que ya está escrito en
 * `lib/logos.ts` para Power BI y Tableau. Y en una fila de cosas que todavía
 * no están hechas, un logo institucional falso además sugiere un respaldo que
 * no existe.
 *
 * Así que la insignia es propia: una chapa de equipo, de las que van
 * remachadas a un caño, con la sigla estampada. Está en el mismo lenguaje que
 * el resto del sitio —el acero de la traza—, no se parece a un certificado ni
 * a un logotipo, y el nombre de la entidad va al lado en texto, que es un
 * crédito y no una reproducción.
 *
 * Y va aparte de la fila de certificados a propósito: esto todavía no está
 * hecho, y no puede ocupar el mismo lugar visual que algo que sí.
 */

interface Props {
  cursos: CollectionEntry<'formacion'>[];
  titulo: string;
}

const { cursos, titulo } = Astro.props;

/** "PMP — Project Management…" → PMP · "LLMs aplicados a…" → LLM */
const sigla = (t: string) => {
  const m = t.match(/^([A-ZÁÉÍÓÚ]{2,5})s?\b/);
  return (m ? m[1] : t.slice(0, 3)).toUpperCase();
};

// Con dos o tres cursos una sola tanda no llena la pantalla y la cinta se ve
// cortada. Se repite hasta pasar los 1800 px estimados antes de triplicar.
const minimo = Math.max(1, Math.ceil(7 / Math.max(cursos.length, 1)));
const tanda = Array.from({ length: minimo }, () => cursos).flat();
---

{
  cursos.length > 0 && (
    <div class="proximos">
      <p class="rotulo">{titulo}</p>

      {/* El degradado de la chapa se define UNA vez y lo referencian todas:
          con tres copias de la cinta hay dos docenas de chapas, y repetir el
          <defs> en cada una serían dos docenas de ids duplicados. */}
      <svg width="0" height="0" aria-hidden="true" style="position:absolute">
        <defs>
          <linearGradient id="chapa-acero" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#596366" />
            <stop offset="0.4" stop-color="#aab5b8" />
            <stop offset="1" stop-color="#39413f" />
          </linearGradient>
        </defs>
      </svg>

      <div class="carril">
        <div class="cinta">
          {[0, 1, 2].map((copia) => (
            <div class="tanda" aria-hidden={copia > 0 ? 'true' : undefined}>
              {tanda.map((c) => (
                <span class="chip">
                  <svg class="chapa" viewBox="0 0 44 44" role="presentation" aria-hidden="true">
                    <rect
                      x="2.5" y="2.5" width="39" height="39" rx="7"
                      fill="url(#chapa-acero)" stroke="#141819" stroke-width="1.4"
                    />
                    <rect
                      x="5.5" y="5.5" width="33" height="33" rx="5"
                      fill="none" stroke="#141819" stroke-opacity="0.28"
                    />
                    {/* Los cuatro remaches. */}
                    {[
                      [9, 9], [35, 9], [9, 35], [35, 35],
                    ].map(([cx, cy]) => (
                      <circle cx={cx} cy={cy} r="1.7" fill="#141819" fill-opacity="0.5" />
                    ))}
                    {/* La sigla, estampada: hundida en oscuro con una luz abajo. */}
                    <text
                      x="22" y="27.6" text-anchor="middle"
                      font-family="'Roboto Variable', system-ui, sans-serif"
                      font-size="12.5" font-weight="800" letter-spacing="-0.3"
                      fill="#ffffff" fill-opacity="0.22"
                    >{sigla(c.data.titulo)}</text>
                    <text
                      x="22" y="27" text-anchor="middle"
                      font-family="'Roboto Variable', system-ui, sans-serif"
                      font-size="12.5" font-weight="800" letter-spacing="-0.3"
                      fill="#14181a"
                    >{sigla(c.data.titulo)}</text>
                  </svg>
                  <span class="texto">
                    <b>{c.data.titulo}</b>
                    <i>
                      {c.data.entidad} · {c.data.periodo}
                    </i>
                  </span>
                </span>
              ))}
            </div>
          ))}
        </div>
      </div>
    </div>
  )
}

<style>
  .proximos {
    margin-top: 2.2rem;
    padding-top: 1.6rem;
    border-top: 1px solid var(--color-borde);
  }
  .rotulo {
    margin: 0 0 1rem;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-tenue);
  }

  .carril {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
  }
  .cinta {
    display: flex;
    width: max-content;
    animation: correr 64s linear infinite;
  }
  .carril:hover .cinta {
    animation-play-state: paused;
  }
  @keyframes correr {
    from { transform: translateX(0); }
    /* Justo una copia de tres. */
    to { transform: translateX(-33.3333%); }
  }

  .tanda {
    display: flex;
    gap: 0.6rem;
    padding-right: 0.6rem;
  }

  .chip {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    flex: none;
    padding: 0.6rem 0.95rem 0.6rem 0.6rem;
    border: 1px solid var(--color-borde);
    border-radius: 10px;
    background: var(--color-panel);
  }
  /* La chapa de equipo. Insignia propia, no un logotipo ajeno. */
  .chapa {
    flex: none;
    width: 2.5rem;
    height: 2.5rem;
    filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.7));
  }
  .texto {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    white-space: nowrap;
  }
  .texto b {
    font-size: 0.8rem;
    font-weight: 600;
  }
  .texto i {
    font-style: normal;
    font-size: 0.62rem;
    letter-spacing: 0.05em;
    color: var(--color-tenue);
  }

  @media (prefers-reduced-motion: reduce) {
    .cinta { animation: none; }
    .carril {
      overflow-x: auto;
      scrollbar-width: none;
      overscroll-behavior-x: contain;
    }
    .carril::-webkit-scrollbar { display: none; }
  }
</style>

<script>
  // La vuelta de la cinta cuando no se anima: mismo mecanismo que el stack.
  // Tres copias idénticas, así que saltar de una a la otra es invisible.
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
    for (const carril of document.querySelectorAll<HTMLElement>('.proximos .carril')) {
      const cinta = carril.querySelector<HTMLElement>('.cinta');
      if (!cinta) continue;
      const copia = () => cinta.scrollWidth / 3;
      let acomodando = false;
      const centrar = () => { carril.scrollLeft = copia(); };

      carril.addEventListener('scroll', () => {
        if (acomodando) return;          // el reacomodo dispara otro scroll
        const c = copia();
        if (c < 10) return;
        const x = carril.scrollLeft;
        if (x > c * 1.75 || x < c * 0.25) {
          acomodando = true;
          carril.scrollLeft = x > c * 1.75 ? x - c : x + c;
          acomodando = false;
        }
      }, { passive: true });

      centrar();
      addEventListener('load', centrar);
      addEventListener('resize', centrar, { passive: true });
    }
  }
</script>
