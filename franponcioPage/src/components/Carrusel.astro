---
/**
 * Carrusel horizontal con scroll-snap.
 *
 * El scroll lo hace el navegador —scroll-snap-type y scroll-behavior—, así que
 * anda con el dedo, con la rueda y con el teclado aunque el script no corra.
 * El script agrega las flechas y, si el contenido viene triplicado
 * (`data-vueltas`), hace que la cinta no se termine nunca: salta de una copia
 * a la equivalente al acercarse a cualquiera de las dos puntas. Como las
 * copias son idénticas, el salto no se ve.
 */

interface Props {
  /** true = el contenido viene en tres copias y la cinta da la vuelta. */
  vueltas?: boolean;
  /** Para el lector de pantalla: qué hay adentro. */
  etiqueta: string;
  /** Texto de las flechas para el lector de pantalla. */
  anterior: string;
  siguiente: string;
}

const { etiqueta, anterior, siguiente, vueltas = false } = Astro.props;
---

<div class="carrusel" data-carrusel data-vueltas={vueltas ? "" : undefined}>
  <div class="pista" tabindex="0" role="group" aria-label={etiqueta}>
    <slot />
  </div>

  <button class="flecha izq" type="button" data-paso="-1" aria-label={anterior} hidden>
    <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
      <path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </button>
  <button class="flecha der" type="button" data-paso="1" aria-label={siguiente} hidden>
    <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
      <path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </button>
</div>

<style>
  .carrusel { position: relative; }

  /* Se desvanece el borde donde el carrusel sigue. Se apaga solo cuando ya no
     hay a dónde ir, porque lo controla la clase que pone el script. */
  .carrusel::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0.6rem;
    right: -0.25rem;
    width: 3.5rem;
    pointer-events: none;
    background: linear-gradient(to left, var(--color-fondo), transparent);
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .carrusel[data-mas]::after { opacity: 1; }

  .pista {
    display: flex;
    gap: 1.15rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    /* Aire a los costados para que la primera y la última no queden pegadas
       al borde, y espacio abajo para la sombra del hover. */
    padding: 0.35rem 0.25rem 0.6rem;
    scroll-padding-inline: 0.25rem;
    /* La barra de scroll se esconde: molesta a la vista y no hace falta —
       están las flechas, el snap y el difuminado del borde para saber que
       hay más. El carrusel sigue siendo scrolleable con dedo y rueda. */
    scrollbar-width: none;
  }
  .pista::-webkit-scrollbar { display: none; }
  .pista:focus-visible { outline: 2px solid var(--color-acento); outline-offset: 4px; border-radius: 10px; }

  .pista > :global(*) {
    scroll-snap-align: start;
    flex: 0 0 min(70vw, 212px);
  }

  .flecha {
    position: absolute;
    top: calc(50% - 1.1rem);
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    margin-top: -1.2rem;
    border-radius: 50%;
    border: 2px solid var(--color-acento);
    background: var(--color-acento);
    color: var(--color-panel);
    cursor: pointer;
    box-shadow: 3px 3px 0 color-mix(in srgb, var(--color-acento) 55%, transparent);
    transition: background-color 0.15s ease, border-color 0.15s ease, opacity 0.15s ease;
  }
  .flecha:hover { transform: translate(-2px, -2px); box-shadow: 5px 5px 0 var(--color-acento); }
  .flecha:focus-visible { outline: 2px solid var(--color-acento); outline-offset: 2px; }
  .flecha[disabled] { opacity: 0.28; cursor: default; }
  .izq { left: -0.6rem; }
  .der { right: -0.6rem; }

  /* Con el dedo no hacen falta: el carrusel ya se arrastra. */
  @media (pointer: coarse), (max-width: 700px) {
    .flecha { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pista { scroll-behavior: auto; }
  }
</style>

<script>
  for (const carrusel of document.querySelectorAll<HTMLElement>('[data-carrusel]')) {
    const pista = carrusel.querySelector<HTMLElement>('.pista');
    const flechas = [...carrusel.querySelectorAll<HTMLButtonElement>('.flecha')];
    if (!pista || !flechas.length) continue;

    // Sin JavaScript las flechas no sirven, así que vienen ocultas del HTML y
    // se muestran recién acá.
    for (const f of flechas) f.hidden = false;

    // Un "paso" es una tarjeta más el hueco: así siempre cae en un snap.
    const paso = () => {
      const primera = pista.firstElementChild as HTMLElement | null;
      if (!primera) return pista.clientWidth;
      const hueco = parseFloat(getComputedStyle(pista).columnGap || '0') || 0;
      return primera.getBoundingClientRect().width + hueco;
    };

    const revisar = () => {
      const tope = pista.scrollWidth - pista.clientWidth - 2;
      for (const f of flechas) {
        // Si da vueltas nunca se llega al final, así que no se apagan nunca.
        f.disabled = carrusel.hasAttribute('data-vueltas')
          ? false
          : Number(f.dataset.paso) < 0
            ? pista.scrollLeft <= 2
            : pista.scrollLeft >= tope;
      }
      // Si entra todo, el carrusel no es un carrusel: no van flechas.
      const sobra = pista.scrollWidth > pista.clientWidth + 4;
      for (const f of flechas) f.hidden = !sobra;
      // El difuminado sólo mientras quede algo a la derecha.
      carrusel.toggleAttribute('data-mas', sobra && pista.scrollLeft < tope);
    };

    for (const f of flechas) {
      f.addEventListener('click', () => {
        pista.scrollBy({ left: Number(f.dataset.paso) * paso() });
      });
    }
    // ── La vuelta ──────────────────────────────────────────────────────
    // Con el contenido en tres copias, la posición X y la posición X + un
    // tercio muestran exactamente lo mismo. Se arranca sobre la copia del
    // medio y se salta al acercarse a una punta, dejando siempre una copia
    // entera de colchón para seguir en cualquiera de los dos sentidos.
    const daVueltas = carrusel.hasAttribute('data-vueltas');
    let acomodando = false;

    const copia = () => pista.scrollWidth / 3;
    const centrar = () => {
      if (!daVueltas) return;
      acomodando = true;
      pista.scrollLeft = copia();
      acomodando = false;
    };

    const envolver = () => {
      if (!daVueltas || acomodando) return;
      const c = copia();
      if (c < 10) return;
      const x = pista.scrollLeft;
      if (x > c * 1.75 || x < c * 0.25) {
        acomodando = true;
        // Sin `behavior`, que si no el salto se anima y se ve.
        pista.scrollLeft = x > c * 1.75 ? x - c : x + c;
        acomodando = false;
      }
    };

    pista.addEventListener(
      'scroll',
      () => {
        envolver();
        revisar();
      },
      { passive: true },
    );
    addEventListener('resize', () => {
      centrar();
      revisar();
    }, { passive: true });
    // El ancho real recién se sabe con las imágenes y las fuentes cargadas.
    addEventListener('load', centrar);
    centrar();
    revisar();
  }
</script>
