---
import '../styles/global.css';
import { conBase } from '../lib/url';
import type { Idioma } from '../i18n/ui';

interface Props {
  titulo: string;
  descripcion: string;
  lang: Idioma;
  /** Misma página en el otro idioma, para el <link alternate> y el selector. */
  alterna: string;
}

const { titulo, descripcion, lang, alterna } = Astro.props;
const anio = new Date().getFullYear();
const otro = lang === 'es' ? 'en' : 'es';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'es' ? 'es_AR' : 'en_US'} />
    {/* Le dice a Google que son la misma página en dos idiomas. */}
    <link rel="alternate" hreflang={otro} href={conBase(alterna)} />
    <link rel="icon" href={conBase("favicon.svg")} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="trama min-h-screen">
    <slot />

    <footer class="border-t border-borde mt-24">
      <div
        class="mx-auto max-w-5xl px-6 py-10 flex flex-wrap gap-4 items-center justify-between text-sm text-tenue"
      >
        <p class="font-mono">Francisco Poncio · Córdoba, Argentina · {anio}</p>
        <nav class="flex gap-5">
          <a class="hover:text-acento transition-colors" href="https://github.com/FranPoncio">
            GitHub
          </a>
          <a class="hover:text-acento transition-colors" href="mailto:franponcioo@gmail.com">
            Email
          </a>
        </nav>
      </div>
    </footer>
    <script>
      // Todo lo de acá es decorativo: si el script no corre, la página se ve
      // igual, sólo que sin las transiciones. Por eso la clase `js-on` se
      // agrega desde JavaScript y no viene en el HTML.
      document.documentElement.classList.add('js-on');

      const suave = !matchMedia('(prefers-reduced-motion: reduce)').matches;

      // 1) Revelar secciones al entrar en pantalla.
      const observador = new IntersectionObserver(
        (entradas) => {
          for (const e of entradas) {
            if (!e.isIntersecting) continue;
            e.target.classList.add('visible');
            observador.unobserve(e.target); // una sola vez, no al volver a subir
          }
        },
        { rootMargin: '0px 0px -12% 0px' },
      );
      for (const el of document.querySelectorAll('.revelar')) observador.observe(el);

      // 2) Las cifras del hero cuentan hacia arriba.
      //    Se respeta el formato original (12.000 km, ~10, 500) leyendo el
      //    número y devolviendo el resto del texto tal cual.
      function contar(el: Element) {
        const texto = el.textContent.trim();
        const m = texto.match(/^(\D*)([\d.,]+)(.*)$/);
        if (!m) return;
        const [, antes, numTxt, despues] = m;
        const destino = parseInt(numTxt.replace(/[.,]/g, ''), 10);
        if (!isFinite(destino) || destino === 0) return;

        const ms = 1100;
        const t0 = performance.now();
        const separador = numTxt.includes('.') ? '.' : '';

        function paso(t: number) {
          const p = Math.min((t - t0) / ms, 1);
          // easeOutExpo: arranca rápido y frena, se siente mecánico
          const v = Math.round(destino * (p === 1 ? 1 : 1 - Math.pow(2, -10 * p)));
          const s = separador ? v.toLocaleString('es-AR') : String(v);
          el.textContent = antes + s + despues;
          if (p < 1) requestAnimationFrame(paso);
        }
        requestAnimationFrame(paso);
      }

      // 3) La línea de producción: se llena según cuánto de la página se
      //    recorrió. Se escribe una sola variable CSS y el resto lo resuelve
      //    el compositor — no se toca layout en ningún frame.
      const riel = document.querySelector<HTMLElement>('.riel');
      if (riel) {
        let pendiente = false;
        const actualizar = () => {
          pendiente = false;
          const caja = riel.getBoundingClientRect();
          const alto = caja.height;
          if (alto <= 0) return;
          // 0 cuando el riel asoma por abajo de la pantalla, 1 cuando su
          // extremo inferior llega al borde inferior. Así la línea arranca en
          // cuanto aparece y termina de llenarse justo al final del recorrido.
          const recorrido = window.innerHeight - caja.top;
          const avance = Math.min(Math.max(recorrido / alto, 0), 1);
          riel.style.setProperty('--avance', avance.toFixed(4));
        };
        const alScroll = () => {
          if (pendiente) return;
          pendiente = true;
          requestAnimationFrame(actualizar);
        };
        addEventListener('scroll', alScroll, { passive: true });
        addEventListener('resize', alScroll, { passive: true });
        actualizar();
      }

      const cifras = document.querySelectorAll<HTMLElement>('.contador');
      if (suave && cifras.length) {
        const obsCifras = new IntersectionObserver(
          (entradas) => {
            for (const e of entradas) {
              if (!e.isIntersecting) continue;
              contar(e.target);
              obsCifras.unobserve(e.target);
            }
          },
          { threshold: 0.6 },
        );
        for (const c of cifras) obsCifras.observe(c);
      }
    </script>
  </body>
</html>
