---
import '../styles/global.css';
import { conBase } from '../lib/url';
import Fondo from '../components/Fondo.astro';
import type { Idioma } from '../i18n/ui';

interface Props {
  titulo: string;
  descripcion: string;
  lang: Idioma;
  /** Misma página en el otro idioma, para el <link alternate> y el selector. */
  alterna: string;
}

const { titulo, descripcion, lang, alterna } = Astro.props;
const anio = new Date().getFullYear();
const otro = lang === 'es' ? 'en' : 'es';
---

<!doctype html>
<html lang={lang}>
  <head>
    <script is:inline>
      /*
       * EL INTERRUPTOR DE MOVIMIENTO.
       *
       * Por defecto manda la preferencia del sistema: si pediste reducir
       * movimiento, el sitio no se mueve. Pero esa preferencia no tiene forma
       * de saber que estás mirando tu propio portfolio y querés ver cómo
       * quedó. Con el botón de la barra la prendés a mano, y esa decisión
       * gana sobre la del sistema para vos y sólo para vos.
       *
       * Va INLINE y en el <head>, sin defer, por dos razones: se aplica antes
       * del primer pintado —si no, la escena arranca quieta y pega un salto al
       * prenderse— y los scripts de los componentes leen `data-mov` al cargar.
       */
      try {
        if (localStorage.getItem('mov') === 'on') {
          document.documentElement.dataset.mov = 'on';
        }
      } catch (e) {
        /* modo privado: sin memoria, manda el sistema */
      }
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'es' ? 'es_AR' : 'en_US'} />
    {/* Le dice a Google que son la misma página en dos idiomas. */}
    <link rel="alternate" hreflang={otro} href={conBase(alterna)} />
    <link rel="icon" href={conBase("favicon.svg")} type="image/svg+xml" />
  </head>
  <body class="trama min-h-screen">
    <Fondo />
    <slot />

    {/* Sin pie de página. Lo único que tenía —el nombre, la ciudad, el año y
        los links a GitHub y mail— o ya está en la barra, que es pegajosa y te
        sigue por toda la página, o no aportaba nada. Un pie que repite el
        encabezado es un pie que sobra. */}
    <script>
      // Todo lo de acá es decorativo: si el script no corre, la página se ve
      // igual, sólo que sin las transiciones. Por eso la clase `js-on` se
      // agrega desde JavaScript y no viene en el HTML.
      document.documentElement.classList.add('js-on');

      const suave = !matchMedia('(prefers-reduced-motion: reduce)').matches;

      // 1) Revelar secciones al entrar en pantalla.
      const observador = new IntersectionObserver(
        (entradas) => {
          for (const e of entradas) {
            if (!e.isIntersecting) continue;
            e.target.classList.add('visible');
            observador.unobserve(e.target); // una sola vez, no al volver a subir
          }
        },
        { rootMargin: '0px 0px -12% 0px' },
      );
      for (const el of document.querySelectorAll('.revelar')) observador.observe(el);

      // 2) Las cifras del hero cuentan hacia arriba.
      //    Se respeta el formato original (12.000 km, ~10, 500) leyendo el
      //    número y devolviendo el resto del texto tal cual.
      function contar(el: Element) {
        const texto = el.textContent.trim();
        const m = texto.match(/^(\D*)([\d.,]+)(.*)$/);
        if (!m) return;
        const [, antes, numTxt, despues] = m;
        const destino = parseInt(numTxt.replace(/[.,]/g, ''), 10);
        if (!isFinite(destino) || destino === 0) return;

        const ms = 1100;
        const t0 = performance.now();
        const separador = numTxt.includes('.') ? '.' : '';

        function paso(t: number) {
          const p = Math.min((t - t0) / ms, 1);
          // easeOutExpo: arranca rápido y frena, se siente mecánico
          const v = Math.round(destino * (p === 1 ? 1 : 1 - Math.pow(2, -10 * p)));
          const s = separador ? v.toLocaleString('es-AR') : String(v);
          el.textContent = antes + s + despues;
          if (p < 1) requestAnimationFrame(paso);
        }
        requestAnimationFrame(paso);
      }

      // 3) El troncal: se llena según cuánto de la página se recorrió. Se
      //    escribe una sola variable CSS (--avance) y el resto lo resuelven el
      //    compositor y un clip-path — no se toca layout en ningún frame.
      const riel = document.querySelector<HTMLElement>('.troncal');
      if (riel) {
        let pendiente = false;
        const actualizar = () => {
          pendiente = false;
          // Cuánto de la página se recorrió: 0 arriba de todo, 1 abajo de todo.
          // La fórmula anterior medía contra el alto del riel y arrancaba en
          // 0.21 con la página sin tocar — parecía que no se llenaba desde cero.
          const recorrido = document.documentElement.scrollHeight - window.innerHeight;
          if (recorrido <= 0) return riel.style.setProperty('--avance', '1');
          const avance = Math.min(Math.max(window.scrollY / recorrido, 0), 1);
          riel.style.setProperty('--avance', avance.toFixed(4));
        };
        const alScroll = () => {
          if (pendiente) return;
          pendiente = true;
          requestAnimationFrame(actualizar);
        };
        addEventListener('scroll', alScroll, { passive: true });
        addEventListener('resize', alScroll, { passive: true });
        actualizar();
      }

      const cifras = document.querySelectorAll<HTMLElement>('.contador');
      if (suave && cifras.length) {
        const obsCifras = new IntersectionObserver(
          (entradas) => {
            for (const e of entradas) {
              if (!e.isIntersecting) continue;
              contar(e.target);
              obsCifras.unobserve(e.target);
            }
          },
          { threshold: 0.6 },
        );
        for (const c of cifras) obsCifras.observe(c);
      }
    </script>
  </body>
</html>
