    [data-reset]:hover { color: var(--color-texto); border-color: var(--color-borde-vivo); }

    .ficha-empresa dl { display: grid; gap: 0; }
    .ficha-empresa dl > div {
      display: grid;
      grid-template-columns: minmax(8rem, 12rem) 1fr;
      gap: 1rem;
      padding: 0.72rem 0;
      border-bottom: 1px solid var(--color-borde);
      font-size: 0.9rem;
    }
    .ficha-empresa dt { color: var(--color-tenue); }
    .ficha-empresa dd { color: var(--color-texto); }
    .ficticia {
      font-size: 0.62rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--color-acento);
      border: 1px solid var(--color-acento-tenue);
      background: var(--color-acento-tenue);
      padding: 0.1rem 0.42rem;
      border-radius: 2px;
      margin-left: 0.5rem;
      vertical-align: middle;
    }

    .normas {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
      gap: 1rem;
    }
    :global(.norma) {
      --c: var(--color-datos);
