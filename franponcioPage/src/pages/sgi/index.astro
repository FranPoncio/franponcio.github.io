    .item .tit { color: var(--color-texto); }
    .item input:not(:checked) ~ .tit {
      color: var(--color-tenue);
      text-decoration: line-through;
    }
    .item .meta { font-size: 0.68rem; color: var(--color-tenue); white-space: nowrap; }
