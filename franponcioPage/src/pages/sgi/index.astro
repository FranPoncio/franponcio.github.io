    .hallazgos { display: grid; gap: 0.8rem; list-style: none; }
    :global(.hallazgo) {
      border: 1px solid var(--color-borde);
      border-left: 3px solid var(--color-borde-vivo);
      background: var(--color-panel);
      padding: 1.1rem 1.25rem;
      border-radius: 3px;
    }
    :global(.hallazgo[data-estado='vencido']) { border-left-color: var(--color-acento); }
    :global(.hallazgo[data-estado='sin_cubrir']) { border-left-color: var(--color-gestion); }
    :global(.hallazgo[data-estado='parcial']) { border-left-color: var(--color-ruta); }
    :global(.hallazgo[data-estado='cubierto']) { border-left-color: var(--color-herramienta); opacity: 0.72; }
    :global(.hallazgo[data-vencer='1']) { border-left-color: var(--color-gestion); opacity: 1; }
    :global(.hallazgo > header) {
      display: flex;
      align-items: baseline;
      gap: 0.6rem;
      flex-wrap: wrap;
      margin-bottom: 0.55rem;
    }
    :global(.clausula) {
      font-size: 0.8rem;
      color: var(--color-tenue);
      font-variant-numeric: tabular-nums;
      min-width: 3rem;
    }
    :global(.hallazgo h3) { font-size: 0.98rem; font-weight: 600; flex: 1; }

    :global(.chip), :global(.clase) {
      font-size: 0.62rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 0.16rem 0.5rem;
      border-radius: 2px;
      border: 1px solid currentColor;
      white-space: nowrap;
    }
    :global(.chip.cubierto) { color: var(--color-herramienta); }
    :global(.chip.parcial) { color: var(--color-ruta); }
    :global(.chip.vencido) { color: var(--color-acento); }
    :global(.chip.sin_cubrir) { color: var(--color-gestion); }
    :global(.clase) { border-style: dashed; }
    :global(.clase.mayor) { color: var(--color-acento); }
    :global(.clase.menor) { color: var(--color-ruta); }
    :global(.clase.observacion) { color: var(--color-gestion); }

    :global(.motivo) { font-size: 0.85rem; color: var(--color-tenue); margin-bottom: 0.7rem; }
    :global(.por-vencer) {
      font-size: 0.84rem;
      line-height: 1.55;
      color: var(--color-gestion);
      border-left: 2px solid var(--color-gestion);
      padding-left: 0.8rem;
      margin-bottom: 0.8rem;
    }

    :global(.aplica) { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-bottom: 0.9rem; }
    :global(.norma-tag), :global(.tronco-tag) {
      font-size: 0.63rem;
      letter-spacing: 0.06em;
      padding: 0.14rem 0.45rem;
      border-radius: 2px;
      background: var(--color-panel-alto);
      color: var(--color-tenue);
    }
    :global(.norma-tag[data-tono='datos']) { color: var(--color-datos); }
    :global(.norma-tag[data-tono='herramienta']) { color: var(--color-herramienta); }
    :global(.norma-tag[data-tono='acento']) { color: var(--color-acento); }

    :global(.falta), :global(.caduca) { margin-bottom: 0.8rem; }
    :global(.falta h4), :global(.caduca h4) {
      font-size: 0.63rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--color-tenue);
      margin-bottom: 0.45rem;
    }
    :global(.falta ul), :global(.caduca ul) { display: grid; gap: 0.4rem; }
    :global(.falta li), :global(.caduca li) {
      font-size: 0.84rem;
      line-height: 1.5;
      color: color-mix(in srgb, var(--color-texto) 80%, transparent);
      padding-left: 0.85rem;
      border-left: 1px solid var(--color-borde);
    }
    :global(.falta em) { color: var(--color-tenue); font-style: normal; font-size: 0.78rem; }
    :global(.tipo) {
      font-size: 0.6rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 0.1rem 0.36rem;
      border-radius: 2px;
      margin-right: 0.45rem;
      background: var(--color-panel-alto);
      color: var(--color-tenue);
    }
    :global(.tipo.registro) { color: var(--color-acento); }
    :global(.caduca .fecha), :global(.caduca .dueno) {
      font-size: 0.72rem;
      color: var(--color-tenue);
      margin-left: 0.5rem;
      font-variant-numeric: tabular-nums;
    }
    :global(.caduca .dueno) { opacity: 0.7; }

    :global(.hallazgo details summary) {
      font-size: 0.76rem;
      color: var(--color-tenue);
      cursor: pointer;
      padding-top: 0.5rem;
      border-top: 1px solid var(--color-borde);
    }
    :global(.hallazgo details summary:hover) { color: var(--color-acento); }
    :global(.preguntas) { display: grid; gap: 0.5rem; margin-top: 0.75rem; }
    :global(.preguntas li) {
      font-size: 0.86rem;
      line-height: 1.55;
      color: color-mix(in srgb, var(--color-texto) 84%, transparent);
      padding-left: 0.9rem;
      border-left: 2px solid var(--color-acento-tenue);
    }

    .vacio { font-size: 0.88rem; color: var(--color-tenue); padding: 2rem 0; }

    .scroll-x { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; font-size: 0.83rem; min-width: 44rem; }
    th {
      text-align: left;
      font-size: 0.64rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--color-tenue);
      font-weight: 500;
      padding: 0 0.7rem 0.6rem;
      border-bottom: 1px solid var(--color-borde);
    }
    :global(.matriz td) {
      padding: 0.55rem 0.7rem;
      border-bottom: 1px solid var(--color-borde);
      vertical-align: top;
    }
    :global(.matriz tr[data-estado='cubierto'] td) { color: var(--color-tenue); }
    :global(.mono) { font-variant-numeric: tabular-nums; white-space: nowrap; }
