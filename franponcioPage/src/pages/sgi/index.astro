    :global(.norma[data-tono='herramienta']) { --c: var(--color-herramienta); }
    :global(.norma[data-tono='acento']) { --c: var(--color-acento); }
    :global(.norma h3) { font-size: 1rem; font-weight: 600; }
    :global(.norma header p) { font-size: 0.78rem; color: var(--color-tenue); }
    :global(.avance) {
      font-size: 2.7rem;
      font-weight: 300;
      line-height: 1;
      margin: 1rem 0 0.6rem;
