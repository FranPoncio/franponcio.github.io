---
/**
 * SGI TRINORMA — la demostración.
 *
 * La página arranca resuelta en tiempo de compilación —sin JavaScript se ve
 * la foto de hoy, entera y usable— y cuando el script carga, el mismo motor
 * corre en el navegador y la vuelve interactiva.
 *
 * Que el motor se pueda mandar al cliente no es un truco: es consecuencia de
 * haberlo escrito como función pura. No consulta nada, no guarda nada, no
 * necesita servidor. Son unos kilobytes y adentro está toda la lógica.
 *
 * Las dos cosas que se pueden tocar existen para mostrar la misma idea desde
 * dos lados:
 *
 *   La máquina del tiempo — adelantás meses y los registros se van venciendo
 *   solos. El 78% se desmorona hasta 40% en un año sin que nadie haga nada
 *   mal: simplemente pasa el tiempo. Ese es el argumento entero del proyecto.
 *
 *   Los interruptores de evidencia — apagás el acta de revisión por la
 *   dirección y la cláusula 9.3 se cae al instante. Es lo que convierte la
 *   página de "un informe sobre un sistema" en el sistema.
 */
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import { conBase } from '../../lib/url';
import { requisitos } from '../../lib/sgi/normas';
import { evidenciasDemo, EMPRESA } from '../../lib/sgi/demo';
import { evaluar, resumir, ordenarHallazgos, NORMAS, AVISO_MESES } from '../../lib/sgi/modelo';
import { tarjetaNorma, tarjetaHallazgo, filaMatriz } from '../../lib/sgi/vista';
import type { Norma } from '../../lib/sgi/modelo';

const hoy = new Date();
const evidencias = evidenciasDemo(hoy);
const coberturas = requisitos.map((r) => evaluar(r, evidencias, hoy));
const hallazgos = ordenarHallazgos(coberturas);

const claves = Object.keys(NORMAS) as Norma[];
const resumenes = claves.map((n) => resumir(coberturas, n));

const corte = hoy.toLocaleDateString('es-AR', { day: '2-digit', month: 'long', year: 'numeric' });

const tronco = requisitos.filter((r) => r.tronco).length;
const propias = claves.map((n) => ({
  norma: n,
  propios: requisitos.filter((r) => !r.tronco && r.normas.includes(n)).length,
}));
const totalPreguntas = requisitos.reduce((a, r) => a + r.preguntas.length, 0);

/*
 * Se emiten las 45 tarjetas, no sólo los 22 hallazgos de hoy. Con la máquina
 * del tiempo corrida, un requisito hoy cubierto puede pasar a vencido, y si
 * su tarjeta no estuviera en el HTML habría que fabricarla en el navegador.
 * Están todas y el script sólo decide cuáles se ven.
 */
const orden = new Map(hallazgos.map((c, i) => [c.requisito.id, i]));
const todasLasTarjetas = [...coberturas].sort(
  (a, b) => (orden.get(a.requisito.id) ?? 999) - (orden.get(b.requisito.id) ?? 999),
);
---

<Base
  titulo="SGI Trinorma · Francisco Poncio"
  descripcion="Demostración interactiva: calcula la cobertura de ISO 9001, 14001 y 45001 sobre la evidencia de una organización, y muestra cómo se cae sola con el paso del tiempo."
  lang="es"
  alterna="/sgi/"
>
  <Nav lang="es" alterna="/sgi/" />

  <main class="mx-auto max-w-5xl px-6 py-14">
    <a href={conBase('/#proyectos')} class="volver">← Volver al portfolio</a>

    <header class="cabecera">
      <p class="rotulo">Demostración interactiva</p>
      <h1>Sistema de gestión integrado<br /><span class="tri">ISO 9001 · 14001 · 45001</span></h1>
      <p class="bajada">
        Un auditor no audita tus documentos: audita si tenés evidencia de que el sistema
        funciona, y si esa evidencia todavía prueba algo. Esto calcula exactamente eso —
        requisito por requisito, con la cuenta a la vista — y arma el plan de auditoría interna
        a partir del resultado.
      </p>
      <p class="bajada invitacion">
        Movés la barra de abajo y lo ves caerse solo. Nadie hace nada mal: pasa el tiempo.
      </p>
    </header>

    {/*
      El aviso va ARRIBA y no en letra chica al pie. Una pantalla que muestra
      porcentajes de cumplimiento de una empresa tiene que decir de entrada
      que la empresa no existe, o alguien la va a citar como si existiera.
    */}
    <aside class="aviso">
      <h2>Antes de mirar los números</h2>
      <ul>
        <li>
          <strong>{EMPRESA.nombre} no existe.</strong> Es una PyME inventada para la demostración.
          Los datos de un SGI real son del cliente o del empleador y no van a un repositorio
          público.
        </li>
        <li>
          <strong>No hay texto de las normas acá adentro.</strong> El texto es propiedad de ISO y
          se compra. Se usan numeración y título de cláusula, que son referencia factual; las
          {' '}{totalPreguntas} preguntas de auditoría y las descripciones de evidencia son propias.
        </li>
        <li>
          <strong>El cálculo no lo hace un modelo de lenguaje.</strong> Es una función pura y
          testeada, y es la misma que corre en tu navegador cuando movés la barra. La IA sirve
          para redactar el informe sobre este resultado, no para decidirlo.
        </li>
      </ul>
    </aside>

    {/* ───────────────────────── LA CONSOLA ───────────────────────── */}
    <section class="consola" data-consola>
      <h2 class="titulo-seccion">La máquina del tiempo</h2>
      <p class="intro">
        Un sistema de gestión no se rompe de golpe: se vence. Corré la barra y mirá qué queda
        del sistema dentro de un año si nadie renueva nada.
      </p>

      <div class="mando">
        <label for="tiempo">Adelantar</label>
        <input type="range" id="tiempo" min="0" max="24" step="1" value="0" data-tiempo />
        <output data-salida>hoy</output>
      </div>
      <p class="corte">Evaluando al <strong data-fecha>{corte}</strong></p>

      <details class="evidencia">
        <summary>Apagar evidencia a mano ({evidencias.length} cargadas)</summary>
        <p class="ayuda">
          Destildá una y mirá qué requisitos se caen. Es la forma más rápida de ver que el
          resultado sale de un cálculo y no de una tabla escrita a mano.
        </p>
        <div class="lista-evidencia">
          {evidencias.map((e) => (
            <label class="item">
              <input type="checkbox" checked data-ev={e.id} />
              <span class="tit">{e.titulo}</span>
              <span class="meta">{e.proceso} · <span class="f">{e.fecha}</span></span>
            </label>
          ))}
        </div>
        <button type="button" data-reset>Volver al estado original</button>
      </details>
    </section>

    <section class="ficha-empresa">
      <h2 class="titulo-seccion">La organización evaluada</h2>
      <dl>
        <div><dt>Organización</dt><dd>{EMPRESA.nombre} <span class="ficticia">ficticia</span></dd></div>
        <div><dt>Actividad</dt><dd>{EMPRESA.rubro}</dd></div>
        <div><dt>Dotación</dt><dd>{EMPRESA.dotacion} personas · {EMPRESA.sitio}</dd></div>
        <div><dt>Alcance declarado</dt><dd>{EMPRESA.alcance}</dd></div>
        <div><dt>Por qué certifica</dt><dd>{EMPRESA.motivo}</dd></div>
      </dl>
    </section>

    <section class="tablero">
      <h2 class="titulo-seccion">Estado por norma</h2>
      <div class="normas" data-normas>
        <Fragment set:html={resumenes.map(tarjetaNorma).join('')} />
      </div>

      {/*
        Es la aclaración más importante de la página y por eso no está en
        letra chica. Un 78% suena a "casi certificamos" y es exactamente al
        revés: para la norma no hay parciales.
      */}
      <p class="nota-avance">
        Ese porcentaje es <strong>avance de implementación, no cumplimiento</strong>. Para el
        certificador no existe el 78%: un requisito no conforme es un hallazgo, y alcanza uno
        mayor para no certificar. El número sirve para saber cuánto falta, no para tranquilizar
        a nadie.
      </p>
    </section>

    {/* ───────────────────── EL TRONCO COMPARTIDO ───────────────────── */}
    <section class="arbol">
      <h2 class="titulo-seccion">Por qué las tres normas juntas no cuestan el triple</h2>
      <p class="intro">
        Las tres comparten la estructura de alto nivel: capítulos 4 a 10, con los mismos títulos
        y la misma lógica. ISO las armó así justamente para que se puedan integrar. Ese tronco se
        modela una sola vez.
      </p>
      <div class="diagrama">
        <div class="tronco-barra">
          <span class="n">{tronco}</span>
          <span class="t">requisitos de tronco común</span>
          <span class="s">contexto · liderazgo · riesgos · competencia · documentación · auditoría · mejora</span>
        </div>
        <div class="ramas">
          {propias.map((p) => (
            <div class="rama" data-tono={NORMAS[p.norma].tono}>
              <span class="palo"></span>
              <span class="n">{p.propios}</span>
              <span class="t">propios de {NORMAS[p.norma].sigla}</span>
            </div>
          ))}
        </div>
        <p class="cuenta">
          <strong>{tronco} + {propias.map((p) => p.propios).join(' + ')} = {requisitos.length} requisitos</strong>{' '}
          para las tres normas, en lugar de los {requisitos.length + tronco * 2} que costaría
          escribirlas por separado. Y no es sólo volumen: con tres corpus paralelos, a la tercera
          corrección de redacción uno se queda atrás y nadie se entera.
        </p>
      </div>
    </section>

    {/* ─────────────────── PLAN DE AUDITORÍA INTERNA ─────────────────── */}
    <section class="plan">
      <h2 class="titulo-seccion">Plan de auditoría interna</h2>
      <p class="intro">
        Los requisitos que no están cubiertos, en el orden en que conviene auditarlos: primero lo
        que se dejó vencer — que el sistema haya existido y se haya caído se mira peor que no
        haberlo tenido nunca — después lo que nunca estuvo, y al final lo que está a medias.
      </p>
      <p class="intro sutil">
        La clasificación en <em>NC mayor</em>, <em>NC menor</em> y <em>observación</em> es una
        propuesta, no un veredicto: la norma no trae esa tabla, la decide el auditor mirando
        impacto y alcance. El sistema propone para que arranque de algo y la corrija, no de una
        hoja en blanco.
      </p>

      <div class="filtros" data-filtros>
        <fieldset>
          <legend>Norma</legend>
          <button type="button" data-f="norma" data-v="todas" class="activo">Todas</button>
          {claves.map((n) => <button type="button" data-f="norma" data-v={n}>{NORMAS[n].sigla}</button>)}
        </fieldset>
        <fieldset>
          <legend>Estado</legend>
          <button type="button" data-f="estado" data-v="abiertos" class="activo">No cubiertos</button>
          <button type="button" data-f="estado" data-v="vencido">Vencidos</button>
          <button type="button" data-f="estado" data-v="sin_cubrir">Sin cubrir</button>
          <button type="button" data-f="estado" data-v="parcial">Parciales</button>
          <button type="button" data-f="estado" data-v="por_vencer">Por vencer</button>
          <button type="button" data-f="estado" data-v="todos">Todo</button>
        </fieldset>
        <p class="contador" data-contador>{hallazgos.length} de {requisitos.length}</p>
      </div>

      <ol class="hallazgos" data-lista>
        <Fragment set:html={todasLasTarjetas.map(tarjetaHallazgo).join('')} />
      </ol>

      <p class="vacio" data-vacio hidden>Ningún requisito con esos filtros.</p>
    </section>

    <section class="matriz">
      <h2 class="titulo-seccion">Matriz completa</h2>
      <p class="intro">Los {requisitos.length} requisitos auditables, con la cuenta que produjo cada estado.</p>
      <div class="scroll-x">
        <table>
          <thead>
            <tr>
              <th scope="col">Cláusula</th>
              <th scope="col">Requisito</th>
              <th scope="col">Normas</th>
              <th scope="col">Estado</th>
              <th scope="col">Por qué</th>
            </tr>
          </thead>
          <tbody data-matriz>
            <Fragment set:html={coberturas.map(filaMatriz).join('')} />
          </tbody>
        </table>
      </div>
    </section>

    <section class="como">
      <h2 class="titulo-seccion">Cómo está hecho</h2>
      <div class="columnas">
        <article>
          <h3>El motor no opina</h3>
          <p>
            <code>evaluar()</code> es una función pura: mismos argumentos, mismo resultado.
            Recibe un requisito, la evidencia cargada y una fecha, y devuelve el estado junto con
            el motivo y las evidencias que lo sostienen. Por eso mismo puede correr en tu
            navegador sin servidor: <code>npm test</code> corre la batería con el runner de Node,
            sin dependencias.
          </p>
        </article>
        <article>
          <h3>Documento y registro no son lo mismo</h3>
          <p>
            Un documento dice cómo se hace algo. Un registro prueba que se hizo, tiene fecha y
            caduca. Confundirlos es el error que más no conformidades genera, y es exactamente lo
            que la máquina del tiempo deja ver: los documentos aguantan, los registros se caen
            solos.
          </p>
        </article>
        <article>
          <h3>Vencido ≠ sin cubrir</h3>
          <p>
            Son dos hallazgos distintos y el sistema los separa. Que nunca hayas tenido un
            procedimiento es una cosa; que lo hayas tenido y lo hayas dejado morir habla del
            sistema entero, y el auditor lo lee así.
          </p>
        </article>
        <article>
          <h3>Avisar {AVISO_MESES} meses antes</h3>
          <p>
            Un requisito cubierto hoy y vencido en seis semanas está, en la práctica, perdido:
            nadie arma una capacitación con evaluación de eficacia mientras corre una auditoría.
            La alerta temprana es lo único de esta lista que una auditoría anual se pierde
            siempre.
          </p>
        </article>
      </div>
    </section>
  </main>

  <script>
    /*
     * EL MOTOR, DEL LADO DEL NAVEGADOR.
     *
     * Se importan exactamente los mismos módulos que usó el build. No hay una
     * segunda implementación "para el cliente": es el mismo cálculo y las
     * mismas plantillas, y por eso la página con JavaScript y sin él no pueden
     * decir cosas distintas.
     */
    import { requisitos } from '../../lib/sgi/normas';
    import { evidenciasDemo } from '../../lib/sgi/demo';
    import { evaluar, resumir, ordenarHallazgos } from '../../lib/sgi/modelo';
    import type { Norma } from '../../lib/sgi/modelo';
    import { tarjetaNorma, tarjetaHallazgo, filaMatriz } from '../../lib/sgi/vista';

    const $ = <T extends Element>(s: string) => document.querySelector<T>(s);

    const consola = $('[data-consola]');
    const cajaNormas = $('[data-normas]');
    const lista = $<HTMLOListElement>('[data-lista]');
    const matriz = $('[data-matriz]');
    const contador = $('[data-contador]');
    const vacio = $<HTMLElement>('[data-vacio]');
    const salida = $('[data-salida]');
    const fecha = $('[data-fecha]');
    const barra = $<HTMLInputElement>('[data-tiempo]');
    const filtros = $('[data-filtros]');

    if (consola && cajaNormas && lista && matriz && contador && vacio && salida && fecha && barra && filtros) {
      const HOY = new Date();
      /** La base: la evidencia de la demo, con las fechas del build. */
      const base = evidenciasDemo(HOY);
      /** Las que el usuario apagó. Se guardan por id, no por índice. */
      const apagadas = new Set<string>();
      const filtro = { norma: 'todas', estado: 'abiertos' };
      let adelanto = 0;

      const fechaEvaluacion = () =>
        new Date(Date.UTC(HOY.getUTCFullYear(), HOY.getUTCMonth() + adelanto, Math.min(HOY.getUTCDate(), 28)));

      const visible = (estado: string, porVencer: boolean) => {
        if (filtro.estado === 'todos') return true;
        if (filtro.estado === 'abiertos') return estado !== 'cubierto';
        if (filtro.estado === 'por_vencer') return porVencer;
        return estado === filtro.estado;
      };

      function pintar() {
        const cuando = fechaEvaluacion();
        const evidencias = base.filter((e) => !apagadas.has(e.id));
        const coberturas = requisitos.map((r) => evaluar(r, evidencias, cuando));

        // 1) Tablero.
        cajaNormas!.innerHTML = (['9001', '14001', '45001'] as Norma[])
          .map((n) => tarjetaNorma(resumir(coberturas, n)))
          .join('');

        // 2) Hallazgos, en el orden de auditoría y con lo cubierto al final.
        const abiertos = ordenarHallazgos(coberturas);
        const posicion = new Map(abiertos.map((c, i) => [c.requisito.id, i]));
        const ordenadas = [...coberturas].sort(
          (a, b) => (posicion.get(a.requisito.id) ?? 999) - (posicion.get(b.requisito.id) ?? 999),
        );
        lista!.innerHTML = ordenadas.map(tarjetaHallazgo).join('');

        let vistos = 0;
        for (const c of ordenadas) {
          const li = lista!.querySelector<HTMLElement>(`[data-id="${CSS.escape(c.requisito.id)}"]`);
          if (!li) continue;
          const ok =
            (filtro.norma === 'todas' || c.requisito.normas.includes(filtro.norma as Norma)) &&
            visible(c.estado, c.porVencer);
          li.hidden = !ok;
          if (ok) vistos++;
        }
        contador!.textContent = `${vistos} de ${requisitos.length}`;
        vacio!.hidden = vistos > 0;

        // 3) Matriz.
        matriz!.innerHTML = coberturas.map(filaMatriz).join('');

        // 4) La fecha a la que se está mirando.
        fecha!.textContent = cuando.toLocaleDateString('es-AR', {
          day: '2-digit',
          month: 'long',
          year: 'numeric',
        });
        salida!.textContent =
          adelanto === 0 ? 'hoy' : adelanto === 1 ? '1 mes' : `${adelanto} meses`;
      }

      barra.addEventListener('input', () => {
        adelanto = Number(barra.value);
        pintar();
      });

      consola.addEventListener('change', (ev) => {
        const casilla = (ev.target as HTMLElement).closest<HTMLInputElement>('input[data-ev]');
        if (!casilla) return;
        const id = casilla.dataset.ev!;
        casilla.checked ? apagadas.delete(id) : apagadas.add(id);
        pintar();
      });

      consola.querySelector('[data-reset]')?.addEventListener('click', () => {
        apagadas.clear();
        adelanto = 0;
        barra.value = '0';
        for (const c of consola.querySelectorAll<HTMLInputElement>('input[data-ev]')) c.checked = true;
        pintar();
      });

      filtros.addEventListener('click', (ev) => {
        const boton = (ev.target as HTMLElement).closest<HTMLButtonElement>('button[data-f]');
        if (!boton) return;
        const campo = boton.dataset.f as 'norma' | 'estado';
        filtro[campo] = boton.dataset.v!;
        for (const otro of filtros.querySelectorAll(`button[data-f="${campo}"]`)) {
          otro.classList.toggle('activo', otro === boton);
        }
        pintar();
      });

      // Primer pintado: deja la lista en el mismo estado que el filtro por
      // defecto, que en el HTML del servidor sale con todo visible.
      pintar();
    }
  </script>

  <style>
    .volver {
      display: inline-block;
      margin-bottom: 2.5rem;
      font-size: 0.82rem;
      color: var(--color-tenue);
      text-decoration: none;
    }
    .volver:hover { color: var(--color-acento); }

    .cabecera { margin-bottom: 3rem; }
    .rotulo {
      font-size: 0.7rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--color-acento);
      margin-bottom: 0.9rem;
    }
    .cabecera h1 {
      font-size: clamp(1.9rem, 4.4vw, 3rem);
      line-height: 1.1;
      font-weight: 700;
      letter-spacing: -0.02em;
    }
    .tri { color: var(--color-tenue); font-weight: 400; }
    .bajada {
      margin-top: 1.4rem;
      max-width: 46rem;
      color: color-mix(in srgb, var(--color-texto) 88%, transparent);
      line-height: 1.65;
    }
    /* Sin JS no hay barra que mover, así que la invitación sería una mentira. */
    .invitacion { color: var(--color-acento); font-weight: 500; }
    html:not(.js-on) .invitacion { display: none; }

    .aviso {
      border: 1px solid var(--color-borde);
      border-left: 3px solid var(--color-acento);
      background: var(--color-panel);
      padding: 1.5rem 1.6rem;
      margin-bottom: 3.5rem;
      border-radius: 3px;
    }
    .aviso h2 {
      font-size: 0.72rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--color-acento);
      margin-bottom: 1rem;
    }
    .aviso ul { display: grid; gap: 0.85rem; }
    .aviso li {
      font-size: 0.9rem;
      line-height: 1.6;
      color: var(--color-tenue);
      padding-left: 1rem;
      border-left: 1px solid var(--color-borde);
    }
    .aviso strong { color: var(--color-texto); font-weight: 600; }

    .titulo-seccion {
      font-size: 0.72rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--color-tenue);
      padding-bottom: 0.7rem;
      border-bottom: 1px solid var(--color-borde);
      margin-bottom: 1.6rem;
    }
    section { margin-bottom: 4rem; }
    .intro {
      color: var(--color-tenue);
      font-size: 0.92rem;
      line-height: 1.65;
      max-width: 46rem;
      margin-bottom: 1.8rem;
    }
    .intro.sutil { font-size: 0.85rem; opacity: 0.85; }
    .intro em { color: var(--color-texto); font-style: normal; }

    /* ── La consola ── */
    .consola {
      border: 1px solid var(--color-borde-vivo);
      background: var(--color-panel);
      border-radius: 3px;
      padding: 1.6rem;
    }
    /* Sin JS la consola no hace nada; mostrarla sería prometer de más. */
    html:not(.js-on) .consola { display: none; }
    .mando {
      display: flex;
      align-items: center;
      gap: 1rem;
      flex-wrap: wrap;
    }
    .mando label {
      font-size: 0.68rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--color-tenue);
    }
    .mando input[type='range'] {
      flex: 1;
      min-width: 12rem;
      accent-color: var(--color-acento);
      height: 1.4rem;
      cursor: pointer;
    }
    .mando output {
      min-width: 5.5rem;
      text-align: right;
      font-size: 1.05rem;
      font-weight: 600;
      color: var(--color-acento);
      font-variant-numeric: tabular-nums;
    }
    .corte {
      margin-top: 0.7rem;
      font-size: 0.8rem;
      color: var(--color-tenue);
    }
    .corte strong { color: var(--color-texto); font-weight: 500; }

    .evidencia { margin-top: 1.3rem; border-top: 1px solid var(--color-borde); padding-top: 1rem; }
    .evidencia summary {
      font-size: 0.78rem;
      color: var(--color-tenue);
