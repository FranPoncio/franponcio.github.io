---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import KpiGrid from '../../components/KpiGrid.astro';
import Galeria from '../../components/Galeria.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';
import Nav from '../../components/Nav.astro';
import NavCasos from '../../components/NavCasos.astro';
import { conBase } from '../../lib/url';

export const getStaticPaths = (async () => {
  const proyectos = (await getCollection('proyectos')).sort((a, b) => a.data.orden - b.data.orden);
  // Los vecinos se calculan acá, en el mismo orden que el home, para que
  // "anterior / siguiente" siga el recorrido que el visitante ya vio.
  return proyectos.map((proyecto, i) => ({
    params: { id: proyecto.id },
    props: { proyecto, anterior: proyectos[i - 1], siguiente: proyectos[i + 1] },
  }));
}) satisfies GetStaticPaths;

const { proyecto, anterior, siguiente } = Astro.props;
const { titulo, resumen, categoria, periodo, rol, stack, kpis, enlace, borrador } = proyecto.data;
const { portada, video, galeria } = proyecto.data;
const { Content } = await render(proyecto);

const acento = {
  datos: 'text-datos',
  gestion: 'text-gestion',
  herramienta: 'text-herramienta',
}[categoria];
---

<Base titulo={`${titulo} · Francisco Poncio`} descripcion={resumen}>
  <Nav />

  {
    borrador && (
      <p class="bg-acento px-6 py-2.5 text-center font-mono text-xs font-semibold text-fondo">
        BORRADOR — completá este archivo y sacá `borrador: true` del frontmatter.
      </p>
    )
  }

  <header class="border-b border-borde">
    <div class="mx-auto max-w-3xl px-6 py-16">
      <a href={conBase("")} class="font-mono text-xs text-tenue transition-colors hover:text-acento">
        ← volver al panel
      </a>

      <p class:list={['mt-8 font-mono text-xs uppercase tracking-[0.16em]', acento]}>{categoria}</p>
      <h1 class="mt-4 text-3xl font-bold leading-tight tracking-tight sm:text-5xl">{titulo}</h1>
      <p class="mt-5 text-lg leading-relaxed text-tenue">{resumen}</p>

      <dl class="mt-9 flex flex-wrap gap-x-10 gap-y-4 font-mono text-sm">
        <div>
          <dt class="text-[0.68rem] uppercase tracking-[0.14em] text-tenue">Período</dt>
          <dd class="mt-1">{periodo}</dd>
        </div>
        <div>
          <dt class="text-[0.68rem] uppercase tracking-[0.14em] text-tenue">Rol</dt>
          <dd class="mt-1">{rol}</dd>
        </div>
      </dl>

      {
        stack.length > 0 && (
          <div class="mt-7 flex flex-wrap gap-2">
            {stack.map((t) => (
              <span class="rounded border border-borde px-2.5 py-1 font-mono text-[0.7rem] text-tenue">
                {t}
              </span>
            ))}
          </div>
        )
      }

      {
        enlace && (
          <a
            href={enlace.url}
            class="mt-8 inline-block rounded border border-acento/50 px-4 py-2 font-mono text-xs text-acento transition-colors hover:bg-acento hover:text-fondo"
          >
            {enlace.label} →
          </a>
        )
      }
    </div>
  </header>

  {
    portada && (
      <div class="border-b border-borde">
        <Image
          src={portada.src}
          alt={portada.alt}
          widths={[640, 1024, 1600]}
          sizes="100vw"
          class="h-[38vh] w-full object-cover sm:h-[46vh]"
          loading="eager"
        />
      </div>
    )
  }

  <main class="mx-auto max-w-3xl px-6 py-14">
    <KpiGrid kpis={kpis} />

    {video && (
      <div class:list={[kpis.length > 0 && 'mt-10']}>
        <VideoEmbed url={video} titulo={`Video de ${titulo}`} />
      </div>
    )}
    <div class:list={['prosa', (kpis.length > 0 || video) && 'mt-14']}>
      <Content />
    </div>

    <Galeria imagenes={galeria} />
    <NavCasos anterior={anterior} siguiente={siguiente} />
  </main>
</Base>
