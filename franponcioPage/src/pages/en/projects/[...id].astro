---
import type { GetStaticPaths } from 'astro';
import Caso from '../../../components/Caso.astro';
import { obtenerProyectos } from '../../../lib/proyectos';

export const getStaticPaths = (async () => {
  const lista = await obtenerProyectos('en');
  return lista.map((p, i) => ({
    params: { id: p.entrada.id },
    props: {
      proyecto: p.entrada,
      esRespaldo: p.esRespaldo,
      anterior: lista[i - 1]?.entrada,
      siguiente: lista[i + 1]?.entrada,
    },
  }));
}) satisfies GetStaticPaths;

const { proyecto, anterior, siguiente, esRespaldo } = Astro.props;
---

<Caso
  proyecto={proyecto}
  anterior={anterior}
  siguiente={siguiente}
  esRespaldo={esRespaldo}
  lang="en"
/>
